    "@id" : "http://www.w3.org/2001/XMLSchema#float"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#RUCAwardInstruction.RUCSchedule",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The RUC Schedule of a resource is its output level that balances the load forecast used in RUC. The RUC Schedule in RUC is similar to the DA Schedule in DAM."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#RUCAwardInstruction"
  } ],
