  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The value START. It is used to instantiate different classes such as the StartCommand class and StartState class. "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Start"
  } ]
