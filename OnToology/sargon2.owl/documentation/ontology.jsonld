    "@id" : "http://www.iec.ch/TC57/CIM#SynchronousMachineDynamics"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#SynchronousMachineDynamics.CrossCompoundTurbineGovernorDyanmics"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#CrossCompoundTurbineGovernorDynamics.LowPressureSynchronousMachineDynamics",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Lowpressure synchronous machine with which this crosscompound turbine governor is associated. "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CrossCompoundTurbineGovernorDynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "LowPressureSynchronousMachineDynamics"
  }, {
    "@value" : "SupplierEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#SynchronousMachineDynamics"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#SynchronousMachineDynamics.CrossCompoundTurbineGovernorDynamics"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#CsConverter",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "DC side of the current source converter CSC.The firing angle controls the dc voltage at the converter both for rectifier and inverter. The difference between the dc voltages of the rectifier and inverter determines the dc current. The extinction angle is used to limit the dc voltage at the inverter if needed and is not used in active power control. The firing angle transformer tap position and number of connected filters are the primary means to control a current source dc line. Higher level controls are built on top e.g. dc voltage dc current and active power. From a steady state perspective it is sufficient to specify the wanted active power transfer ACDCConverter.targetPpcc and the control functions will set the dc voltage dc current firing angle transformer tap position and number of connected filters to meet this. Therefore attributes targetAlpha and targetGamma are not applicable in this case.The reactive power consumed by the converter is a function of the firing angle transformer tap position and number of connected filter which can be approximated with half of the active power. The losses is a function of the dc voltage and dc current.The attributes minAlpha and maxAlpha define the range of firing angles for rectifier operation between which no discrete tap changer action takes place. The range is typically 1018 degrees.The attributes minGamma and maxGamma define the range of extinction angles for inverter operation between which no discrete tap changer action takes place. The range is typically 1720 degrees."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CsConverter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ACDCConverter"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#CsConverter.CSCDynamics",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Current source converter dynamics model used to describe dynamic behaviour of this converter."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CsConverter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CSCDynamics"
  }, {
    "@value" : "ClientEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CSCDynamics"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#CsConverter.alpha",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Firing angle that determines the dc voltage at the converter dc terminal. Typical value between 10 degrees and 18 degrees for a rectifier. It is converters state variable result from power flow. The attribute shall be a positive value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CsConverter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "alpha"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AngleDegrees"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#CsConverter.gamma",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Extinction angle. It is used to limit the dc voltage at the inverter if needed. Typical value between 17 degrees and 20 degrees for an inverter. It is converters state variable result from power flow. The attribute shall be a positive value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CsConverter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "gamma"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AngleDegrees"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#CsConverter.maxAlpha",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Maximum firing angle. It is converters configuration data used in power flow. The attribute shall be a positive value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CsConverter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "maxAlpha"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AngleDegrees"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#CsConverter.maxGamma",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Maximum extinction angle. It is converters configuration data used in power flow. The attribute shall be a positive value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CsConverter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "maxGamma"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AngleDegrees"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#CsConverter.maxIdc",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The maximum direct current Id on the DC side at which the converter should operate. It is converters configuration data use in power flow. The attribute shall be a positive value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CsConverter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "maxIdc"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CurrentFlow"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#CsConverter.minAlpha",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Minimum firing angle. It is converters configuration data used in power flow. The attribute shall be a positive value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CsConverter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "minAlpha"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AngleDegrees"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#CsConverter.minGamma",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Minimum extinction angle. It is converters configuration data used in power flow. The attribute shall be a positive value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CsConverter"
  } ],
