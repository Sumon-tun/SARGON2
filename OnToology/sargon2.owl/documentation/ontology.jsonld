}, {
  "@id" : "http://www.iec.ch/TC57/CIM#BaseCaseConstraintLimit",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Possibly timevarying max MW or MVA and optionally Min MW limit or MVA limit Y1 and Y2 respectively assigned to a contingency analysis base case. Use CurveSchedule XAxisUnits to specify MW or MVA. To be used only if the BaseCaseConstraintLimit differs from the DefaultConstraintLimit."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "BaseCaseConstraintLimit"
  } ],
