    "@id" : "http://www.iec.ch/TC57/CIM#DCConductingEquipment"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#DCChopper",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Low resistance equipment used in the internal DC circuit to balance voltages. It has typically positive and negative pole terminals and a ground."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "DCChopper"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#DCConductingEquipment"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#DCConductingEquipment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The parts of the DC power system that are designed to carry current or that are conductively connected through DC terminals."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "DCConductingEquipment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Equipment"
  } ]
