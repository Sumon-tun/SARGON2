  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The generating unit specified for this control area.  Note that a control area should include a GeneratingUnit only once."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ControlAreaGeneratingUnit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
