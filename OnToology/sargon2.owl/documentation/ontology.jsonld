}, {
  "@id" : "http://www.iec.ch/TC57/CIM#SynchronousMachineDetailed",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "All synchronous machine detailed types use a subset of the same data parameters and inputoutput variables.  The several variations differ in the following ways the number of  equivalent windings that are included the way in which saturation is incorporated into the model whether or not subtransient saliency iXqi not  iXdi is represented.It is not necessary for each simulation tool to have separate models for each of the model types.  The same model can often be used for several types by alternative logic within the model.  Also differences in saturation representation might not result in significant model performance differences so model substitutions are often acceptable. "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "SynchronousMachineDetailed"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#SynchronousMachineDynamics"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#SynchronousMachineDetailed.efdBaseRatio",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Ratio exciter voltagegenerator voltage of iEfdi bases of exciter and generator models gt 0. Typical value  1."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#SynchronousMachineDetailed"
  } ],
