}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ErpJournal",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Book for recording accounting transactions as they occur. Transactions and adjustments are first recorded in a journal which is like a diary of instructions advising which account to be charged and by how much.A journal represents a change in the balances of a businesss financial accounts. Many tasks or transactions throughout an enterprise will result in the creation of a journal. Some examples are creating a customer invoice paying a vendor transferring inventory or paying employees."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ErpJournal"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ErpDocument"
  } ]
