  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ActivePower"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#StartupModel_merged",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The units startup model may have a startup ignition fuel curve."
  }, {
    "@value" : "The units startup model may have a startup main fuel curve."
  }, {
    "@value" : "The units startup model may have a startup ramp curve."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#StartIgnFuelCurve"
  }, {
    "@id" : "http://www.iec.ch/TC57/CIM#StartMainFuelCurve"
  }, {
