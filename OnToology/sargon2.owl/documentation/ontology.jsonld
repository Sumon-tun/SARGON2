  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MacroPeriodKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Captured during the billing period starting at midnight of the first day of the billing period as defined by the billing cycle day. If during the current billing period it specifies a period from the start of the current billing period until now."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "billingPeriod"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MacroPeriodKind.daily",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MacroPeriodKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Daily period starting at midnight. If for the current day this specifies the time from midnight to now."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "daily"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MacroPeriodKind.monthly",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MacroPeriodKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Monthly period starting at midnight on the first day of the month. If within the current month this specifies the period from the start of the month until now."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "monthly"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MacroPeriodKind.none",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MacroPeriodKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Not applicable."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "none"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MacroPeriodKind.seasonal",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MacroPeriodKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A season of time spanning multiple months. E.g. Summer Spring Fall and Winter based cycle. If within the current season it specifies the period from the start of the current season until now."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "seasonal"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MacroPeriodKind.specifiedPeriod",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MacroPeriodKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "For the period defined by the start and end of the TimePeriod element in the message."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "specifiedPeriod"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MacroPeriodKind.weekly",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MacroPeriodKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Weekly period starting at midnight on the first day of the week and ending the instant before midnight the last day of the week. If within the current week it specifies the period from the start of the week until now."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "weekly"
  } ]
