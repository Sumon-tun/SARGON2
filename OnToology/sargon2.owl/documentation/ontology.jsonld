}, {
  "@id" : "http://www.iec.ch/TC57/CIM#phase_merged",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Phase of this energy consumer component.   If the energy consumer is wye connected the connection is from the indicated phase to the central ground or neutral point.  If the energy consumer is delta connected the phase indicates an energy consumer connected from the indicated phase to the next logical nonneutral phase."
  }, {
    "@value" : "Phase of this energy producer component.   If the energy producer is wye connected the connection is from the indicated phase to the central ground or neutral point.  If the energy producer is delta connected the phase indicates an energy producer connected from the indicated phase to the next logical nonneutral phase."
  }, {
    "@value" : "Phase of this energy source component.   If the energy source wye connected the connection is from the indicated phase to the central ground or neutral point.  If the energy source is delta connected the phase indicates an energy source connected from the indicated phase to the next logical nonneutral phase."
  }, {
    "@value" : "Phase of this shunt compensator component.   If the shunt compensator is wye connected the connection is from the indicated phase to the central ground or neutral point.  If the shunt compensator is delta connected the phase indicates a shunt compensator connected from the indicated phase to the next logical nonneutral phase."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#EnergyConsumerPhase"
  }, {
    "@id" : "http://www.iec.ch/TC57/CIM#EnergySourcePhase"
  }, {
    "@id" : "http://www.iec.ch/TC57/CIM#PowerElectronicsConnectionPhase"
  }, {
    "@id" : "http://www.iec.ch/TC57/CIM#ShuntCompensatorPhase"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "phase"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#SinglePhaseKind"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#phase_op_merged",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The terminal phase at which the connection is applied.   If missing the injection is assumed to be balanced among nonneutral phases."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#SvInjection"
  }, {
    "@id" : "http://www.iec.ch/TC57/CIM#SvShuntCompensatorSections"
  }, {
    "@id" : "http://www.iec.ch/TC57/CIM#SvSwitch"
  } ],
