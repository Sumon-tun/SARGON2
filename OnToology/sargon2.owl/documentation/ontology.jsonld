    "@id" : "http://www.iec.ch/TC57/CIM#Compound"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ReadingInterharmonic.denominator",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Interharmonic denominator. Value 0 means not applicable. Value 2 is used in combination with numerator1 to represent interharmonic 12. Finally value 1 indicates the harmonic of the order specified with numerator."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ReadingInterharmonic"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "denominator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ReadingInterharmonic.numerator",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Interharmonic numerator. Value 0 means not applicable. Value 1 is used in combination with denominator2 to represent interharmonic 12 and with denominator1 it represents fundamental frequency. Finally values greater than 1 indicate the harmonic of that order e.g. numerator5 is the fifth harmonic."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ReadingInterharmonic"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "numerator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
