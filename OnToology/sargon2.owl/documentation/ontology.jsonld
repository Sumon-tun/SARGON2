}, {
  "@id" : "http://www.iec.ch/TC57/CIM#UnplannedOutage",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Document describing the consequence of an unplanned outage in a part of the electrical network. For the purposes of this model an unplanned outage refers to a state where energy is not delivered such as customers out of service a street light is not served etc.A unplanned outage may be created upon impacts the SAIDI calculation a breaker trip a fault indicator status change a meter event indicating customer outage a reception of one or more customer trouble calls or an operator command reflecting information obtained from the field crew.Outage restoration may be performed using a switching plan which complements the outage information with detailed switching activities including the relationship to the crew and work."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "UnplannedOutage"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Outage"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#UnplannedOutage.cause",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The cause of this outage.  This is the cause that is used to present to external entities.  That is the cause is weather equipment failure etc.Note At present this is a free text could be replaced with a separate associated class in case we have multiple causes e.g. OutageCauseType inheriting from IdentifiedObject."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#UnplannedOutage"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "cause"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#UnplannedOutage.causeKind",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#UnplannedOutage"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "causeKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OutageCauseKind"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#UnplannedOutage.reportedStartTime",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The earliest start time of the Outage  as reported by some system or individual"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#UnplannedOutage"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "reportedStartTime"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
