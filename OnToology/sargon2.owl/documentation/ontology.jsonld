}, {
  "@id" : "http://www.semanticweb.org/stu/ontologies/2024/9/sargon2",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "SARGON2 ontology represents the energy domain including building and non-energy domain including weather and serve as the extension of other ontologies for the digital services in the energy sector, and enable the seamless semantic integration of energy assets in Renewable Energy Valleys. This ontology also fouces on the renewable energy resources including biomass, biogas, wind, solar, geothermal, and hydrogen entities. The main focus of this ontology is to cover the necessary components in the power systems by aligning with IEC61970CIM standard."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2025-03-25"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@value" : "https://creativecommons.org/licenses/by/4.0/"
  } ]
