  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#float"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#SynchronousMachineDetailed.ifdBaseType",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Excitation base system mode. It should be equal to the value of iWLMDVi given by the user. iWLMDVi is the PU ratio between the field voltage and the excitation current iEfdi  iWLMDVi x iIfdi. Typical value  ifag."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#SynchronousMachineDetailed"
  } ],
