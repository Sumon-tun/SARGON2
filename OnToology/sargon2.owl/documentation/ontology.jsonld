    "@value" : "Positive pole. The converter terminal is intended to operate at a positive voltage relative the midpoint or negative terminal."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "positive"
  } ]
