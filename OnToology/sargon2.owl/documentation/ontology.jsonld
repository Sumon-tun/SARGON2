    "@value" : "Total Cost Energy  AS cost  by over the time horizon"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketResults"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
