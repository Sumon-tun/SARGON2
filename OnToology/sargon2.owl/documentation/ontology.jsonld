    "@id" : "http://www.iec.ch/TC57/CIM#CombinedCyclePlant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "combCyclePlantRating"
  } ],
