  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "powerFactor"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#RegulatingControlModeKind.reactivePower",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#RegulatingControlModeKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Reactive power is specified."
  } ],
