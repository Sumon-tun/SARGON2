  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "If true the data it produces is  calculated or measured by a device other than a physical end devicemeter. Otherwise any data streams it produces are measured by the hardware of the end devicemeter itself. "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Register"
