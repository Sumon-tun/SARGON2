  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A rotating machine whose shaft rotates asynchronously with the electrical field.  Also known as an induction machine with no external connection to the rotor windings e.g. squirrelcage induction machine."
  } ],
