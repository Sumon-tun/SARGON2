  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#PetersenCoil.xGroundNominal",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The nominal reactance.  This is the operating point normally over compensation that is defined based on the resonance point in the healthy network condition.  The impedance is calculated based on nominal voltage divided by position current."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#PetersenCoil"
  } ],
