    "@value" : "Specifies the sign of the tie flow associated with a control area. True if positive flow into the terminal load convention is also positive flow into the control area.  See the description of ControlArea for further explanation of how TieFlow.positiveFlowIn is used."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#TieFlow"
