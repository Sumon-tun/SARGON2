  "@id" : "http://www.iec.ch/TC57/CIM#VsCapabilityCurve.VsConverterDCSides",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "All converters with this capability curve."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#VsCapabilityCurve"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "VsConverterDCSides"
  }, {
    "@value" : "ClientEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#VsConverter"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#VsConverter.CapabilityCurve"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#VsConverter",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "DC side of the voltage source converter VSC."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "VsConverter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ACDCConverter"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#VsConverter.CapabilityCurve",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
