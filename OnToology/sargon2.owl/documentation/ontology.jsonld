  "@id" : "http://www.iec.ch/TC57/CIM#TieLine.ParentOfB",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A CustomerConsumer may ring its perimeter with metering which can create a unique SubControlArea at the collection of metering points called a TieLine."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#TieLine"
