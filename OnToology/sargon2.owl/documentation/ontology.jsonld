  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#PanDemandResponse.enrollmentGroup",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Provides a mechanism to direct load control actions to groups of PAN devices. It can be used in conjunction with the PAN device types."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#PanDemandResponse"
