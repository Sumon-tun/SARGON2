  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Interharmonics are represented as a rational number numerator  denominator and harmonics are represented using the same mechanism and identified by denominator1."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ReadingInterharmonic"
  } ],
