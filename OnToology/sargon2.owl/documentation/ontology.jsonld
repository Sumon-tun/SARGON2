}, {
  "@id" : "http://www.iec.ch/TC57/CIM#PssIEEE4B",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "IEEE 421.52005 type PSS4B power system stabilizer. The PSS4B model represents a structure based on multiple working frequency bands. Three separate bands respectively dedicated to the low intermediate and highfrequency modes of oscillations are used in this delta omega speed input PSS.There is an error in the in IEEE 421.52005 PSS4B model the iPei input should read iPei. This implies that the input iPei needs to be multiplied by 1.Reference IEEE 4B 421.52005 8.4. Parameter detailsThis model has 2 input signals. They have the following fixed types expressed in terms of InputSignalKind values the first one is of rotorAngleFrequencyDeviation type and the second one is of generatorElectricalPower type."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "PssIEEE4B"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#PowerSystemStabilizerDynamics"
  } ]
