  "@id" : "http://www.iec.ch/TC57/CIM#EnergySource.pMin",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "This is the minimum active power that can be produced by the source. Load sign convention is used i.e. positive sign means flow out from a TopologicalNode bus into the conducting equipment."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#EnergySource"
