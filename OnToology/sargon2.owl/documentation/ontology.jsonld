}, {
  "@id" : "http://www.iec.ch/TC57/CIM#PssIEEE3B",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "IEEE 421.52005 type PSS3B power system stabilizer model. The PSS model PSS3B has dual inputs of electrical power and rotor angular frequency deviation. The signals are used to derive an equivalent mechanical power signal.This model has 2 input signals. They have the following fixed types expressed in terms of InputSignalKind values the first one is of rotorAngleFrequencyDeviation type and the second one is of generatorElectricalPower type.Reference IEEE 3B 421.52005 8.3. "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "PssIEEE3B"
  } ],
