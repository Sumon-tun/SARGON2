}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AtmosphericAnalogKind.windSpeedGust",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AtmosphericAnalogKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Maximum instantaneous wind speed in the 10 minute period preceding a moment in time so long as more than 10 knots of difference has been exhibited between peaks and lulls during that 10 minute time period. 0 value means no gusts during preceding 10 minute period."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "windSpeedGust"
  } ]
