  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#TurbLCFB1.fbf",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Frequency bias flag iFbfi.true  enable frequency biasfalse  disable frequency bias.Typical value  false."
