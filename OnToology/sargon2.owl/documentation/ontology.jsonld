  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Reactance from terminal sequence 2 to terminal sequence 1. Used for steady state power flow. This attribute is optional and represents an unbalanced network such as offnominal phase shifter. If only EquivalentBranch.x is given then EquivalentBranch.x21 is assumed equal to EquivalentBranch.x.Usage rule EquivalentBranch is a result of network reduction prior to the data exchange."
  } ],
