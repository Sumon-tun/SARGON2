  "@id" : "http://www.iec.ch/TC57/CIM#ICCPProvidedPoint.pointType",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Indicates the ICCP Point type that is to be conveyed.A CIM AccumlatorValue  shall be mapped to an ICCP real.A CIM AnalogValue shall be mapped to an ICCP real.A CIM DiscreteValue shall be mapped to either an ICCP real state stateSupplemental or either protection event type.A CIM StringMeasurementValue does not have a standardized mapping."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ICCPProvidedPoint"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "pointType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ICCPPointKind"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ICCPQualityKind",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Indicates the type of quality information that is to be exchanged. For protection events the value shall be none."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ICCPQualityKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Enumeration"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ICCPQualityKind.extended",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ICCPQualityKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Indicates that only extended information is to be provided."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "extended"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ICCPQualityKind.extendedwithQualityTime",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
