  "@id" : "http://www.iec.ch/TC57/CIM#ShortCircuitTest",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Shortcircuit test results determine mesh impedance parameters. They include load losses and leakage impedances. For threephase windings the excitation can be a positive sequence the default or a zero sequence. There shall be at least one grounded winding."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ShortCircuitTest"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#TransformerTest"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ShortCircuitTest.EnergisedEnd",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Transformer end that voltage is applied to in this shortcircuit test. The test voltage is chosen to induce rated current in the energised end."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ShortCircuitTest"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "EnergisedEnd"
  }, {
    "@value" : "SupplierEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#TransformerEndInfo"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#TransformerEndInfo.EnergisedEndShortCircuitTests"
