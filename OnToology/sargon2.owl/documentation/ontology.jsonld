  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#CsConverter.operatingMode",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Indicates whether the DC pole is operating as an inverter or as a rectifier. It is converters control variable used in power flow."
