}, {
  "@id" : "http://www.iec.ch/TC57/CIM#VisibilityLayer",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Layers are typically used for grouping diagram objects according to themes and scales. Themes are used to display or hide certain information e.g. lakes borders while scales are used for hiding or displaying information depending on the current zoom level hide text when it is too small to be read or when it exceeds the screen size. This is also called decluttering.CIM based graphics exchange supports an mn relationship between diagram objects and layers. The importing system shall convert an mn case into an appropriate 1n representation if the importing system does not support mn."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "VisibilityLayer"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#IdentifiedObject"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#VisibilityLayer.VisibleObjects",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A visibility layer can contain one or more diagram objects."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#VisibilityLayer"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "VisibleObjects"
  }, {
    "@value" : "ClientEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#DiagramObject"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#VisibilityLayer.drawingOrder",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The drawing order for this layer.  The higher the number the later the layer and the objects within it are rendered."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#VisibilityLayer"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "drawingOrder"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
