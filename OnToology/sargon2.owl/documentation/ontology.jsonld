  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Selector iJi.true  control mode for reactive powerfalse  control mode for power factor."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#PFVArType2Common1"
