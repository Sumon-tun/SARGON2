  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Reason for creditdebit transaction on an account. Example payment receivedarrears interest levied."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AccountMovement"
  } ],
