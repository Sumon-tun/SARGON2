  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "All switch actions to apply within the scope of this planned outage. Each such action groups switches to which the action is to apply in order to produce the desired network state considered as outage."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
