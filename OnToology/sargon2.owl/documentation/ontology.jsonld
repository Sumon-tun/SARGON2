  "@id" : "http://www.iec.ch/TC57/CIM#ExcDC2A.ke",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Exciter constant related to selfexcited field iKei.  If iKei is entered as zero the model calculates an effective value of iKei such that the initial condition value of iVri is zero. The zero value of iKei is not changed.  If iKei is entered as nonzero its value is used directly without change.  Typical value  1."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ExcDC2A"
