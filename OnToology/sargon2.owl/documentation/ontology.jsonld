  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A set of statements describing the changes in the network model. The statement is defined in the incremental model. "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "DifferentialModel"
  } ],
