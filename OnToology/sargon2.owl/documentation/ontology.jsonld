  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ControlAreaOperator",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Operates the Control Area. Approves and implements energy transactions. Verifies both InterControl Area and IntraControl Area transactions for the power system  before granting approval and implementing the transactions."
  } ],
