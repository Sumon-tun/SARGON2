  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Optionally this curve expresses elasticity of the associated requirement.  For example used to reduce requirements when clearing price exceeds reasonable values when the supply quantity becomes scarce. For example a single point value of 1000MW for a spinning reserve will cause a reduction in the required spinning reserve. X axis is constrained quantity e.g. MWY1 axis is money per constrained quantity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
