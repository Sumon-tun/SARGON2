  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Monthly amortized amount due during each billing cycle for the CustomerAccount balance for which the Payment Plan is setup."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CustomerBillingInfo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "pymtPlanAmt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Money"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#CustomerBillingInfo.pymtPlanType",
