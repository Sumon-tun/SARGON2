    "@id" : "http://www.iec.ch/TC57/CIM#SynchronousMachine.ReactiveCapabilityCurves"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ReactiveCapabilityCurve.coolantTemperature",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The machines coolant temperature e.g. ambient air or stator circulating water."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ReactiveCapabilityCurve"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "coolantTemperature"
