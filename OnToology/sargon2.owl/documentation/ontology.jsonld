  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AngleDegrees"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#CsConverter.minIdc",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The minimum direct current Id on the DC side at which the converter should operate. It is converters configuration data used in power flow. The attribute shall be a positive value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CsConverter"
  } ],
