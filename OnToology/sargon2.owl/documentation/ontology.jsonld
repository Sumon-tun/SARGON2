    "@id" : "http://www.iec.ch/TC57/CIM#CombinedCycleConfiguration"
  }, {
    "@id" : "http://www.iec.ch/TC57/CIM#MktCombinedCyclePlant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CombinedCycleLogicalConfiguration"
  }, {
    "@value" : "ClientEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
