}, {
  "@id" : "http://www.iec.ch/TC57/CIM#CongestionRevenueRight.cRRcategory",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "CRR category represents PTP for a pointtopoint CRR or NSR for a Network Service Right. If CRR category is PTP both Source ID and Sink ID fields are required. If CRR category is NSR only one field either Source ID or Sink ID shall be not null and the other shall be null. However the NSR category will include at least three records."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CongestionRevenueRight"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "cRRcategory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CRRCategoryType"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#CongestionRevenueRight.cRRtype",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Type of the CRR from the possible type definitions in the CRR System e.g. LSE ETC."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CongestionRevenueRight"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "cRRtype"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CRRSegmentType"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#CongestionRevenueRight.hedgeType",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Hedge type Obligation or Option. An obligation type requires the holder to receive or pay the congestion rent. An option type gives the holder the option of receiving or paying the congestion rent."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CongestionRevenueRight"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
