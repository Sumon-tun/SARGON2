}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AsynchronousMachineDynamics",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Asynchronous machine whose behaviour is described by reference to a standard model expressed in either time constant reactance form or equivalent circuit form font color0f0f0for by definition of a userdefined model.fontParameter detailsolliAsynchronous machine parameters such as iXl Xsi etc. are actually used as inductances in the model but are commonly referred to as reactances since at nominal frequency the PU values are the same. However some references use the symbol iLi instead of iXi.liol"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AsynchronousMachineDynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#RotatingMachineDynamics"
  } ]
