    "@language" : "en",
    "@value" : "ifdBaseType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#IfdBaseKind"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#SynchronousMachineDetailed.saturationFactor120QAxis",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Quadratureaxis saturation factor at 120 of rated terminal voltage iS12qi gt SynchonousMachineDetailed.saturationFactorQAxis.  Typical value  012."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#SynchronousMachineDetailed"
