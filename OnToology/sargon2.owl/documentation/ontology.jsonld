    "@id" : "http://www.iec.ch/TC57/CIM#Seconds"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AsynchronousMachineTimeConstantReactance.xp",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
