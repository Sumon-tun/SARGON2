  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccountingUnit",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Unit for accounting use either energyUnit or currencyUnit to specify the unit for value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AccountingUnit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Compound"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccountingUnit.energyUnit",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Unit of service."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AccountingUnit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "energyUnit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#RealEnergy"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccountingUnit.monetaryUnit",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Unit of currency."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AccountingUnit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "monetaryUnit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Currency"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Kind of accumulation behaviour for read  measured values from individual end points."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AccumulationKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Enumeration"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind.boundedQuantity",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A timeindependent cumulative quantity much like a bulkQuantity or a latchingQuantity except that the accumulation stops at the maximum or minimum values. When the maximum is reached any additional positive accumulation is discarded but negative accumulation may be accepted thus lowering the counter. Likewise when the negative bound is reached any additional negative accumulation is discarded but positive accumulation is accepted thus increasing the counter. "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "boundedQuantity"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind.bulkQuantity",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A value from a register which represents the bulk quantity of a commodity. This quantity is computed as the integral of the commodity usage rate. This value is typically used as the basis for the dial reading at the meter and as a result will roll over upon reaching a maximum dial value. Note 1 With the metering system the rollover behaviour typically implies a rollunder behavior so that the value presented is always a positive value e.g. unsigned integer or positive decimal. However when communicating data between enterprise applications a negative value might occur in a case such as net metering.Note 2 A bulkQuantity refers primarily to the dial reading and not the consumption over a specific period of time."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "bulkQuantity"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind.continuousCumulative",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The sum of the previous billing period values and the present period value.Note continuousCumulative is commonly used in conjunction with demand and it  would represent the cumulative sum of the previous billing period maximum demand values as occurring with each demand reset summed with the present period maximum demand value which has yet to be reset."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "continuousCumulative"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind.cumulative",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The sum of the previous billing period values.Note cumulative is commonly used in conjunction with demand. Each demand reset causes the maximum demand value for the present billing period since the last demand reset to accumulate as an accumulative total of all maximum demands. So instead of zeroing the demand register a demand reset has the effect of adding the present maximum demand to this accumulating total. "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "cumulative"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind.deltaData",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The difference between the value at the end of the prescribed interval and the beginning of the interval. This is used for incremental interval data. Note One common application would be for load profile data another use might be to report the number of events within an interval such as the number of equipment energisations within the specified period of time."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "deltaData"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind.indicating",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "As if a needle is swung out on the meter face to a value to indicate the current value.Note An indicating value is typically measured over hundreds of milliseconds or greater or may imply a pusher mechanism to capture a value. Compare this to instantaneous which is measured over a shorter period of time."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "indicating"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind.instantaneous",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Typically measured over the fastest period of time allowed by the definition of the metric usually milliseconds or tens of milliseconds.Note instantaneous was moved to attribute 3 in Ed.2 of IEC 619689 from attribute 1 in Ed.1 of IEC 619689."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "instantaneous"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind.latchingQuantity",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "When this description is applied to a metered value it implies that the value is a timeindependent cumulative quantity much like a bulkQuantity except that it latches upon the maximum value upon reaching that value. Any additional accumulation positive or negative is discarded until a reset occurs. Note A latchingQuantity may also occur in the downward direction  upon reaching a minimum value. The terms maximum or minimum for aggregate will usually be included when this type of accumulation behaviour is present. When this description is applied to an encoded value UOM Code it implies that the value has one or more bits which are latching. The condition that caused the bit to be set may have long since evaporated.In either case the timestamp that accompanies the value may not coincide with the moment the value was initially set.In both cases a system will need to perform an operation to clear the latched value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "latchingQuantity"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind.none",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Not applicable or implied by the unit of measure."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "none"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind.summation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A form of accumulation which is selective with respect to time. Note  summation could be considered a specialisation of bulkQuantity as it selectively accumulates pulses over a timing pattern while bulkQuantity accumulates pulses all of the time."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "summation"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind.timeDelay",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AccumulationKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A form of computation which introduces a time delay characteristic to the data value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "timeDelay"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#Accumulator",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Accumulator represents an accumulated counted Measurement e.g. an energy value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Accumulator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Measurement"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#Accumulator.AccumulatorValues",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The values connected to this measurement."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Accumulator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AccumulatorValues"
  }, {
    "@value" : "SupplierEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AccumulatorValue"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AccumulatorValue.Accumulator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccumulatorLimit",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Limit values for Accumulator measurements."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AccumulatorLimit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Limit"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccumulatorLimitSet",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An AccumulatorLimitSet specifies a set of Limits that are associated with an Accumulator measurement."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AccumulatorLimitSet"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#LimitSet"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccumulatorReset",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "This command resets the counter value to zero."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AccumulatorReset"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Control"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#AccumulatorReset.AccumulatorValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The accumulator value that is reset by the command."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AccumulatorReset"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AccumulatorValue"
  }, {
    "@value" : "SupplierEnd"
