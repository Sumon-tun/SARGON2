  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "This class represents an actual instance of a planned market. For example a Day Ahead market opens with the Bid Submission ends with the closing of the Bid Submission. The market run represent the whole process. MarketRuns can be defined for markets such as Day Ahead Market Real Time Market Hour Ahead Market Week Ahead Market etc."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "MarketRun"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#IdentifiedObject"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRun.MarketActualEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "All actual events that trigger this market run."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRun"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "MarketActualEvent"
  }, {
    "@value" : "ClientEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketActualEvent"
  } ]
