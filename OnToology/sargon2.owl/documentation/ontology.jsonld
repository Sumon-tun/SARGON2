  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "there is a high confidence that the ERT will be accomplished"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "high"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ERTConfidenceKind.low",
