  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Control switches onoff by time of day. The times may change on the weekend or in different seasons."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "timeScheduled"
  } ]
}, {
