}, {
  "@id" : "http://www.iec.ch/TC57/CIM#PanDemandResponse.dutyCycle",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Maximum on state duty cycle as a percentage of time. For example if the value is 80 the device would be in an on state for 80 of the time for the duration of the action."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#PanDemandResponse"
  } ],
