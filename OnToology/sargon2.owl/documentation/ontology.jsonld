  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Bus or solid fed SCR siliconcontrolled rectifier bridge excitation system model type NI NVE."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ExcNI"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ExcitationSystemDynamics"
  } ]
