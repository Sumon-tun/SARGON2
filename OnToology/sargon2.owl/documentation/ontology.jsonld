  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Specifies the type of Control e.g. BreakerOnOff GeneratorVoltageSetPoint TieLineFlow etc. The ControlType.name shall be unique among all specified types and describe the type."
