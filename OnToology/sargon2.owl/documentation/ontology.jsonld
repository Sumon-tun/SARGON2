}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ServiceGuarantee",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A service guarantee often imposed by a regulator defines conditions that if not satisfied will result in the utility making a monetary payment to the customer. Note that guarantees identifier is in the name attribute and the status of the guarantee is in the Status.status attribute.Example service requirements include1 If power is not restored within 24 hours customers can claim 50 for residential customers or 100 for commercial and industrial customers. In addition for each extra period of 12 hours the customers supply has not been activated the customer can claim 25.2 If a customer has a question about their electricity bill the utility will investigate and respond to the inquiry within 15 working days. If utility fails to meet its guarantee utility will automatically pay the customer 50."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ServiceGuarantee"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Document"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ServiceGuarantee.applicationPeriod",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Period in which this service guantee applies."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ServiceGuarantee"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "applicationPeriod"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#DateTimeInterval"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ServiceGuarantee.automaticPay",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "True if utility must autmatically pay the specified amount whenever the condition is not satisified otherwise customer must make a claim to receive payment."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ServiceGuarantee"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "automaticPay"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ServiceGuarantee.payAmount",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Amount to be paid by the service provider to the customer for each violation of the serviceRequirement."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ServiceGuarantee"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "payAmount"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Money"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ServiceGuarantee.serviceRequirement",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Explanation of the requirement and conditions for satisfying it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ServiceGuarantee"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "serviceRequirement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ServiceKind",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
