    "@value" : "The customers that are affected by this planned outage."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OutagePlan"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
