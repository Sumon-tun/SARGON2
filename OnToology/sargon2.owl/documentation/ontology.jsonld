  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Specifies the version of the Bilateral Table configuration that is being exchanged."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#TASE2BilateralTable"
  } ],
