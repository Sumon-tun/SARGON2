    "@value" : "voltage"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#RegulatingLimit",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "This class represents the physical characteristic of a generator regarding the regulating limit."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "RegulatingLimit"
