  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "SynchronousMachines"
  }, {
    "@value" : "SupplierEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#SynchronousMachine"
  } ],
