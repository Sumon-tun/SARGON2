    "@language" : "en",
    "@value" : "ControlAreaOperator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Organisation"
  } ]
}, {
