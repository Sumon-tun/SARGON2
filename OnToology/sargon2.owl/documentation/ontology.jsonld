    "@id" : "http://www.iec.ch/TC57/CIM#SwitchingStep"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#SynchrocheckRelay",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A device that operates when two AC circuits are within the desired limits of frequency phase angle and voltage to permit or to cause the paralleling of these two circuits. Used to prevent the paralleling of nonsynchronous topological islands."
  } ],
