  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The SubControlArea is on the A side of a collection of metered points which define the SubControlAreas boundary for a ControlAreaOperator or CustomerConsumer."
