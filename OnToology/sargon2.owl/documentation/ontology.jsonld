    "@id" : "http://www.iec.ch/TC57/CIM#PersonRole"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimit",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A value and normal value associated with a specific kind of limit. The sub class value and normalValue attributes vary inversely to the associated OperationalLimitType.acceptableDuration acceptableDuration for short.  If a particular piece of equipment has multiple operational limits of the same kind apparent power current etc. the limit with the greatest acceptableDuration shall have the smallest limit value and the limit with the smallest acceptableDuration shall have the largest limit value.  Note A large current can only be allowed to flow through a piece of equipment for a short duration without causing damage but a lesser current can be allowed to flow for a longer duration. "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "OperationalLimit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#IdentifiedObject"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimit.LimitDependencyModel",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The limit dependency models which are used to calculate this limit.   If no limit dependencies are specified then the native limit value is used."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "LimitDependencyModel"
  }, {
    "@value" : "SupplierEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#LimitDependency"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimit.LimitScalingLimit",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "LimitScalingLimit"
  }, {
    "@value" : "ClientEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#LimitScalingLimit"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimit.OperationalLimitType",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The limit type associated with this limit."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "OperationalLimitType"
  }, {
    "@value" : "SupplierEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitType"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitType.OperationalLimit"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitDirectionKind",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The direction attribute describes the side of  a limit that is a violation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "OperationalLimitDirectionKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Enumeration"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitDirectionKind.absoluteValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitDirectionKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An absoluteValue limit means that a monitored absolute value above the limit value is a violation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "absoluteValue"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitDirectionKind.high",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitDirectionKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "High means that a monitored value above the limit value is a violation.   If applied to a terminal flow the positive direction is into the terminal."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "high"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitDirectionKind.low",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitDirectionKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Low means a monitored value below the limit is a violation.  If applied to a terminal flow the positive direction is into the terminal."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "low"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitSet",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A set of limits associated with equipment.  Sets of limits might apply to a specific temperature or season for example. A set of limits may contain different severities of limit levels that would apply to the same equipment. The set may contain limits of different types such as apparent power and current limits or high and low voltage limits  that are logically applied together as a set."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "OperationalLimitSet"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#IdentifiedObject"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitSet.Equipment",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The equipment to which the limit set applies."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitSet"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Equipment"
  }, {
    "@value" : "SupplierEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Equipment"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitSet.Terminal",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The terminal where the operational limit set apply."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitSet"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Terminal"
  }, {
    "@value" : "SupplierEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ACDCTerminal"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The operational meaning of a category of limits."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "OperationalLimitType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#IdentifiedObject"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitType.OperationalLimit",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The operational limits associated with this type of limit."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "OperationalLimit"
  }, {
    "@value" : "ClientEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimit"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitType.SourceOperationalLimitTypeScaling",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "SourceOperationalLimitTypeScaling"
  }, {
    "@value" : "ClientEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperatonalLimitTypeScaling"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperatonalLimitTypeScaling.SourceOperationalLimitType"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitType.TargetOperationalLimitmTypeScaling",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "TargetOperationalLimitmTypeScaling"
  }, {
    "@value" : "ClientEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperatonalLimitTypeScaling"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperatonalLimitTypeScaling.TargetOperationalLimit"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitType.acceptableDuration",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The nominal acceptable duration of the limit. Limits are commonly expressed in terms of the time limit for which the limit is normally acceptable. The actual acceptable duration of a specific limit may depend on other local factors such as temperature or wind speed. The attribute has meaning only if the flag isInfiniteDuration is set to false hence it shall not be exchanged when isInfiniteDuration is set to true."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "acceptableDuration"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Seconds"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitType.direction",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The direction of the limit."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "direction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitDirectionKind"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitType.isInfiniteDuration",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Defines if the operational limit type has infinite duration. If true the limit has infinite duration. If false the limit has definite duration which is defined by the attribute acceptableDuration."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalLimitType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "isInfiniteDuration"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalRestriction",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A document that can be associated with equipment to describe any sort of restrictions compared with the original manufacturers specification or with the usual operational practice e.g. temporary maximum loadings maximum switching current do not operate if bus couplers are open etc.In the UK for example if a breaker or switch ever maloperates this is reported centrally and utilities use their asset systems to identify all the installed devices of the same manufacturers type. They then apply operational restrictions in the operational systems to warn operators of potential problems. After appropriate inspection and maintenance the operational restrictions may be removed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "OperationalRestriction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Document"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OperationalRestriction.Equipments",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "All equipments to which this restriction applies."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalRestriction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Equipments"
  }, {
    "@value" : "SupplierEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Equipment"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OperationalRestrictions"
  } ]
}, {
