  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Filter time constant iTri gt 0. If a voltage compensator is used in conjunction with this excitation system model iTr ishould be set to 0.  Typical value  001."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ExcHU"
