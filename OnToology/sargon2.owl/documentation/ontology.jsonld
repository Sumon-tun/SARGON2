  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Modified IEEE DC2A direct current commutator exciter with speed input one more leg block in feedback loop and without underexcitation limiters UEL inputs.  DC type 2 excitation system model with added speed multiplier added leadlag and voltagedependent limits."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ExcDC2A"
  } ],
