  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Time as hhmmss.sss which conforms with ISO 8601. UTC time zone is specified as hhmmss.sssZ. A local timezone relative UTC is specified as hhmmss.ssshhmm. The second component shown here as ss.sss could have any number of digits in its fractional part to allow any kind of precision beyond seconds."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Time"
  } ],
