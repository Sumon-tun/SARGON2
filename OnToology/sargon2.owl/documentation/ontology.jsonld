    "@value" : "The estimated time of restoration can have a confidence factor applied such as high or low confidence that the ERT will be accomplished.  This confidence factor may be updated as needed during the outage period  just as the actual ERT can be updated."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ERTConfidenceKind"
  } ],
