  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Minimum reactive power of the injection.  Used for modelling of infeed for load flow exchange. Not used for short circuit modelling.  If maxQ and minQ are not used ReactiveCapabilityCurve can be used."
