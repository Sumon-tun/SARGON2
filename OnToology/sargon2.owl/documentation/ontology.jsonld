  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A curve of load  versus time Xaxis showing the active power values Y1axis and reactive power Y2axis for each unit of the period covered. This curve represents a typical pattern of load over the time period for a given day type and season."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
