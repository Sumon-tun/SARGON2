  "@id" : "http://www.iec.ch/TC57/CIM#ControlAction.discreteValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The integer value used for the command or the accumulator reset."
