  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Rated converter DC current also called IdN. The attribute shall be a positive value. It is converters configuration data used in power flow."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#CsConverter"
