  "@id" : "http://www.iec.ch/TC57/CIM#ControlAction.analogValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The analog value used for the analog control the raiselower control and the set point control"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
