  "@id" : "http://www.iec.ch/TC57/CIM#ConnectDisconnectFunction.eventCount",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Running cumulative count of connect or disconnect events for the lifetime of this function or until the value is cleared."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ConnectDisconnectFunction"
