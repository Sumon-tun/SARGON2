  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Specifies the type of measurement.  For example this specifies if the measurement represents an indoor temperature outdoor temperature bus voltage line flow etc.When the measurementType is set to Specialization the type of Measurement is defined in more detail by the specialized class which inherits from Measurement."
  } ],
