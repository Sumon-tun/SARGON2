    "@language" : "en",
    "@value" : "Diagram"
  }, {
    "@value" : "SupplierEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Diagram"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#DifferentialModel",
