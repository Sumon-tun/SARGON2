  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Operational limit applied to voltage.The use of operational VoltageLimit is preferred instead of limits defined at VoltageLevel. The operational VoltageLimits are used if present."
  } ],
