  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Static Var Compensator to which Static Var Compensator dynamics model applies."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#StaticVarCompensatorDynamics"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "StaticVarCompensator"
  }, {
    "@value" : "SupplierEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
