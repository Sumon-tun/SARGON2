  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ControlArea",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A control area is a grouping of generating units andor loads and a cutset of tie lines as terminals which may be used for a variety of purposes including automatic generation control power flow solution area interchange control specification and input to load forecasting. All generation and load within the area defined by the terminals on the border are considered in the area interchange control. Note that any number of overlapping control area specifications can be superimposed on the physical model. The following general principles apply to ControlArea1.  The control area orientation for net interchange is positive for an import negative for an export.2.  The control area net interchange is determined by summing flows in Terminals. The Terminals are identified by creating a set of TieFlow objects associated with a ControlArea object. Each TieFlow object identifies one Terminal.3.  In a single network model a tie between two control areas must be modelled in both control area specifications such that the two representations of the tie flow sum to zero.4.  The normal orientation of Terminal flow is positive for flow into the conducting equipment that owns the Terminal. i.e. flow from a bus into a device is positive. However the orientation of each flow in the control area specification must align with the control area convention i.e. import is positive. If the orientation of the Terminal flow referenced by a TieFlow is positive into the control area then this is confirmed by setting TieFlow.positiveFlowIn flag TRUE. If not the orientation must be reversed by setting the TieFlow.positiveFlowIn flag FALSE."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ControlArea"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#PowerSystemResource"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ControlArea.EnergyArea",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The energy area that is forecast from this control area specification."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ControlArea"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "EnergyArea"
  }, {
    "@value" : "SupplierEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#EnergyArea"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#EnergyArea.ControlArea"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ControlArea.netInterchange",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The specified positive net interchange into the control area i.e. positive sign means flow into the area."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ControlArea"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "netInterchange"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ActivePower"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ControlArea.pTolerance",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Active power net interchange tolerance. The attribute shall be a positive value or zero."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ControlArea"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "pTolerance"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ActivePower"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ControlArea.type",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The primary type of control area definition used to determine if this is used for automatic generation control for planning interchange control or other purposes.   A control area specified with primary type of automatic generation control could still be forecast and used as an interchange area in power flow analysis."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ControlArea"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "type"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ControlAreaTypeKind"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ControlAreaDesignation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Indicates Control Area associated with selfschedule."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ControlAreaDesignation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Toplevel"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ControlAreaDesignation.attained",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Attained."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
