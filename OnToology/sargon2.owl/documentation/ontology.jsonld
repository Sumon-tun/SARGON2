  "@id" : "http://www.iec.ch/TC57/CIM#RUCAwardInstruction.RUCAward",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The RUC Award of a resource is the portion of the RUC Capacity that is not under RA or RMR contracts. The RUC Award of a resource is the portion of the RUC Capacity that is eligible for RUC Availability payment."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#RUCAwardInstruction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "RUCAward"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#float"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#RUCAwardInstruction.RUCCapacity",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The RUC Capacity of a resource is the difference between i the RUC Schedule and ii the higher of the DA Schedule and the Minimum Load."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#RUCAwardInstruction"
  } ],
