}, {
  "@id" : "http://www.iec.ch/TC57/CIM#dm",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Speed sensitivity coefficient iDmi.  iDmi can represent either the variation of the engine power with the shaft speed or the variation of maximum power capability with shaft speed.  If it is positive it describes the falling slope of the engine speed verses power characteristic as speed increases. A slightly falling characteristic is typical for reciprocating engines and some aeroderivative turbines.  If it is negative the engine power is assumed to be unaffected by the shaft speed but the maximum permissible fuel flow is taken to fall with falling shaft speed. This is characteristic of singleshaft industrial turbines due to exhaust temperature limits.  Typical value  0."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#GovCT1"
  }, {
    "@id" : "http://www.iec.ch/TC57/CIM#GovCT2"
  } ],
