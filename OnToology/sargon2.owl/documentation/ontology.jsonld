  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Transient rotor time constant iToi gt AsynchronousMachineTimeConstantReactance.tppo.  Typical value  5."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#AsynchronousMachineTimeConstantReactance"
  } ],
