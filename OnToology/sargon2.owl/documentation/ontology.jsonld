  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Defined as 1   1  Incremental Transmission Loss with the Incremental Transmission Loss expressed as a plus or minus value. The typical range of penalty factors is 0.9 to 1.1."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#GeneratingUnit"
