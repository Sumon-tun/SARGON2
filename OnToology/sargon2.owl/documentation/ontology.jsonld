  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Phasetophase open circuit voltage magnitude used when voltage characteristics need to be imposed at the node associated with the terminal of the energy source such as when voltages and angles from the transmission level are used as input to the distribution network. The attribute shall be a positive value or zero."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#EnergySource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "voltageMagnitude"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Voltage"
  } ]
