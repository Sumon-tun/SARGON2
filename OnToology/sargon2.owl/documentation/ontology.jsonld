  "@id" : "http://www.iec.ch/TC57/CIM#UsagePointConnectedKind",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "State of the usage point with respect to connection to the network."
  } ],
