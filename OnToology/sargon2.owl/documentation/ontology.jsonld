}, {
  "@id" : "http://www.iec.ch/TC57/CIM#DiagramObject",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An object that defines one or more points in a given space. This object can be associated with anything that specializes IdentifiedObject. For single line diagrams such objects typically include such items as analog values breakers disconnectors power transformers and transmission lines."
  } ],
