}, {
  "@id" : "http://www.iec.ch/TC57/CIM#OilAnalysisGasAnalogKind.estimatedSafeHandlingLimit",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OilAnalysisGasAnalogKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Estimated Safe Handling Limit ESHL in percent. Estimated safe handling limit is an estimate of the lower flammability limit LFL of the combustible gas mixture which the dissolved gas in the oil would give off by the oil if exposed to air. Expressed in percent like the equivalent total combustible gas percent it is calculated from the dissolvedgas concentrations the oil sample temperature and the lower flammability limits of the individual combustible gases. "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "estimatedSafeHandlingLimit"
  } ]
