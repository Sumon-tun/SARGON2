  "@id" : "http://www.iec.ch/TC57/CIM#ResponseMethod.activePower",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The active power value for the demand adjustment type. This supports requests to be made to a resource for some amount of active power provided by a particular response method as specified by the method attribute e.g. lighting HVAC wall mounted air conditioners etc.."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#ResponseMethod"
