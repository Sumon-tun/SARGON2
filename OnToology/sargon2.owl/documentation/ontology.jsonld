    "@value" : "A variable impedance device normally used to offset line charging during single line faults in an ungrounded section of network."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "PetersenCoil"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#EarthFaultCompensator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#PetersenCoil.mode",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
