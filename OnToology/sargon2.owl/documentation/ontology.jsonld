    "@id" : "http://www.iec.ch/TC57/CIM#RegulatingControlModeKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Control switches onoff based on the local temperature i.e. a thermostat."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "temperature"
