  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The class represents equivalent branches. In cases where a transformer phase shift is modelled and the EquivalentBranch is spanning the same nodes the impedance quantities for the EquivalentBranch shall consider the needed phase shift."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "EquivalentBranch"
  } ],
