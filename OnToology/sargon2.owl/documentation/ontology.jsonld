}, {
  "@id" : "http://www.iec.ch/TC57/CIM#ErpBankAccount",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Relationship under a particular name usually evidenced by a deposit against which withdrawals can be made. Types of bank accounts include demand time custodial joint trustee corporate special and regular accounts.A statement of transactions during a fiscal period and the resulting balance is maintained on each account.For Payment metering the account is associated with Bank and Supplier reflecting details of the bank account used for depositing revenue collected by TokenVendor. The name of the account holder should be specified in name attribute."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ErpBankAccount"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#BankAccount"
  } ]
}, {
