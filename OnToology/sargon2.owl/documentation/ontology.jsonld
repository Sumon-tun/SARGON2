  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A set of combustion turbines and steam turbines where the exhaust heat from the combustion turbines is recovered to make steam for the steam turbines resulting in greater overall plant efficiency."
  } ],
