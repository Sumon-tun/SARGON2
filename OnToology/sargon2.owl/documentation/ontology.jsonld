    "@value" : "Describes each tap step in the tabular curve."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "TapChangerTablePoint"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
