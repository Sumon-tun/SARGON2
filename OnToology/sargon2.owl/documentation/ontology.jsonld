    "@id" : "http://www.iec.ch/TC57/CIM#Money"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#StartupModel.startupDate",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The date and time of the most recent generating unit startup."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
