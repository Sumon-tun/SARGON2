  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Type of input signal 1 rotorAngularFrequencyDeviation busFrequencyDeviation.  Typical value  rotorAngularFrequencyDeviation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#PssIEEE2B"
