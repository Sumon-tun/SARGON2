  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The external intended behavior played by a party within the electricity market."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "MarketRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#OrganisationRole"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Kind of market role an organisation can have. This list is not exhausted as other roles may exist."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Enumeration"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.BalanceResponsibleParty",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party that has a contract proving financial security and identifying balance responsibility with the Imbalance Settlement Responsible of the Market Balance Area entitling the party to operate in the market. This is the only role allowing a party to nominate energy on a wholesale level.biAdditional informationibThe meaning of the word balance in this context signifies that the quantity contracted to provide or to consume shall be equal to the quantity really provided or consumed. Equivalent to Program responsible party in the Netherlands. Equivalent to Balance group manager in Germany. Equivalent to market agent in Spain."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "BalanceResponsibleParty"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.BalanceSupplier",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party that markets the difference between actual metered energy consumption and the energy bought with firm energy contracts by the Party Connected to the Grid. In addition the Balance Supplier markets any difference with the firm energy contract of the Party Connected to the Grid and the metered production.biAdditional informationibThere is only one Balance Supplier for each Accounting Point."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "BalanceSupplier"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.BillingAgent",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The party responsible for invoicing a concerned party."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "BillingAgent"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.BlockEnergyTrader",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party that is selling or buying energy on a firm basis a fixed volume per market time period."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "BlockEnergyTrader"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.CapacityCoordinator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party acting on behalf of the System Operators involved responsible for establishing a coordinated Offered Capacity andor Net Transfer Capacity NTC andor Available Transfer Capacity ATC between several Market Balance Areas."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CapacityCoordinator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.CapacityTrader",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party that has a contract to participate in the Capacity Market to acquire capacity through a Transmission Capacity Allocator.The capacity may be acquired on behalf of an Interconnection Trade Responsible or for sale on secondary capacity markets."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CapacityTrader"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.Consumer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party that consumes electricity.biAdditional informationibThis is a Type of Party Connected to the Grid."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Consumer"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.ConsumptionResponsibleParty",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party who can be brought to rights legally and financially for any imbalance between enegry nominated and consumed for all associated Accounting Points.biAdditional informationibThis is a type of Balance Responsible Party."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ConsumptionResponsibleParty"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.ControlAreaOperator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Responsible for 1. The coordination of exchange programs between its related Market Balance Areas and for the exchanges between its associated Control Areas.2. The load frequency control for its own area.3. The coordination of the correction of time deviations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ControlAreaOperator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.ControlBlockOperator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Responsible for 1. The coordination of exchanges between its associated Control Blocks and the organisation of the coordination of exchange programs between its related Control Areas.2. The load frequency control within its own block and ensuring that its Control Areas respect their obligations in respect to load frequency control and time deviation.3. The organisation of the settlement andor compensation between its Control Areas."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ControlBlockOperator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.CoordinationCenterOperator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Responsible for 1. The coordination of exchange programs between its related Control Blocks and for the exchanges between its associated Coordination Center Zones.2. Ensuring that its Control Blocks respect their obligations in respect to load frequency control.3. Calculating the time deviation in cooperation with the associated coordination centers.4. Carrying out the settlement andor compensation between its Control Blocks and against the other Coordination Center Zones."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CoordinationCenterOperator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.GridAccessProvider",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party responsible for providing access to the grid through an Accounting Point and its use for energy consumption or production to the Party Connected to the Grid."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "GridAccessProvider"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.GridOperator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party that operates one or more grids."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "GridOperator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.ImbalanceSettlementResponsible",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party that is responsible for settlement of the difference between the contracted quantities and the realised quantities of energy products for the Balance Responsible Parties in a Market Balance Area.NoteThe Imbalance Settlement Responsible has not the responsibility to invoice. The Imbalance Settlement Responsible may delegate the invoicing responsibility to a more generic role such as a Billing Agent."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ImbalanceSettlementResponsible"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.InterconnectionTradeResponsible",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Is a Balance Responsible Party or depends on one. They are recognized by the Nomination Validator for the nomination of already allocated capacity.biAdditional informationibThis is a type of Balance Responsible Party."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "InterconnectionTradeResponsible"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.MOLResponsible",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Responsible for the management of the available tenders for all Acquiring System Operators to establish the order of the reserve capacity that can be activated."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "MOLResponsible"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.MarketInformationAggregator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Market Information Aggregator A party that provides market related information that has been compiled from the figures supplied by different actors in the market. This information may also be published or distributed for general use.biNoteibThe Market Information Aggregator may receive information from any market participant that is relevant for publication or distribution."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "MarketInformationAggregator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.MarketOperator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The unique power exchange of trades for the actual delivery of energy that receives the bids from the Balance Responsible Parties that have a contract to bid. The Market Operator determines the market energy price for the Market Balance Area after applying technical constraints from the System Operator. It may also establish the price for the reconciliation within a Metering Grid Area."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "MarketOperator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.MeterAdministrator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party responsible for keeping a database of meters."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "MeterAdministrator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.MeterOperator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party responsible for installing maintaining testing certifying and decommissioning physical meters."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "MeterOperator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.MeteredDataAggregator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party responsible for the establishment and qualification of metered data from the Metered Data Responsible. This data is aggregated according to a defined set of market rules."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "MeteredDataAggregator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.MeteredDataCollector",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party responsible for meter reading and quality control of the reading."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "MeteredDataCollector"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.MeteredDataResponsible",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party responsible for the establishment and validation of metered data based on the collected data received from the Metered Data Collector. The party is responsible for the history of metered data for a Metering Point."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "MeteredDataResponsible"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.MeteringPointAdministrator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party responsible for registering the parties linked to the metering points in a Metering Grid Area. They are also responsible for maintaining the Metering Point technical specifications. They are responsible for creating and terminating metering points."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "MeteringPointAdministrator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.NominationValidator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Has the responsibility of ensuring that all capacity nominated is within the allowed limits and confirming all valid nominations to all involved parties. They inform the Interconnection Trade Responsible of the maximum nominated capacity allowed. Depending on market rules for a given interconnection the corresponding System Operators may appoint one Nomination Validator."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "NominationValidator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.PartyConnectedToTheGrid",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party that contracts for the right to consume or produce electricity at an Accounting Point."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "PartyConnectedToTheGrid"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.Producer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party that produces electricity.biAdditional informationibThis is a type of Party Connected to the Grid."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Producer"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.ProductionResponsibleParty",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party who can be brought to rights legally and financially for any imbalance between energy nominated and produced for all associated Accounting Points.biAdditional informationibThis is a type of Balance Responsible Party."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ProductionResponsibleParty"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.ReconciliationAccountable",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party that is financially accountable for the reconciled volume of energy products for a profiled Accounting Point."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ReconciliationAccountable"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.ReconciliationResponsible",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party that is responsible for reconciling within a Metering Grid Area the volumes used in the imbalance settlement process for profiled Accounting Points and the actual metered quantities.NoteThe Reconciliation Responsible may delegate the invoicing responsibility to a more generic role such as a Billing Agent."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ReconciliationResponsible"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.ReserveAllocator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Informs the market of reserve requirements receives tenders against the requirements and in compliance with the prequalification criteria determines what tenders meet requirements and assigns tenders."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ReserveAllocator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.ResourceProvider",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A role that manages a resource object and provides the schedules for it"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ResourceProvider"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.SchedulingCoordinator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party that is responsible for the schedule information and its exchange on behalf of a Balance Responsible Party. For example in the Polish market a Scheduling Coordinator is responsible for information interchange for scheduling and settlement."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "SchedulingCoordinator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.SystemOperator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party that is responsible for a stable power system operationincluding the organisation of physical balance through a transmission grid in a geographical area. The System Operator will also determine and be responsible for cross border capacity and exchanges. If necessary they may reduce allocated capacity to ensure operational stability. Transmission as mentioned above means the transport of electricity on the extra high or high voltage network with a view to its delivery to final customers or to distributors. Operation of transmission includes as well the tasks of system operation concerning its management of energy flows reliability of the system and availability of all necessary system services. definition taken from the ENTSOE RGCE Operation handbook Glossary.biNote ibadditional obligations may be imposed through local market rules."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "SystemOperator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.TradeResponsibleParty",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A party who can be brought to rights legally and financially for any imbalance between energy nominated and consumed for all associated Accounting Points.biNoteibA power exchange without any privileged responsibilities acts as a Trade Responsible Party.biAdditional informationibThis is a type of Balance Responsible Party."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "TradeResponsibleParty"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.TransmissionCapacityAllocator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Manages the allocation of transmission capacity for an Allocated Capacity Area.biFor explicit auctionsibThe Transmission Capacity Allocator manages on behalf of the System Operators the allocation of available transmission capacity for an Allocated capacity Area. They offer the available transmission capacity to the market allocates the available transmission capacity to individual Capacity Traders and calculates the billing amount of already allocated capacities to the Capacity Traders."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "TransmissionCapacityAllocator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.balancingAuthority",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Balancing authority."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "balancingAuthority"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.competitiveRetailer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Competitive retailer."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "competitiveRetailer"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.complianceMonitor",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Compliance monitor."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "complianceMonitor"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.distributionProvider",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Distribution provider."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "distributionProvider"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.energyServiceConsumer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Energy service consumer."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "energyServiceConsumer"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.generatorOperator",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Generator merchant operator."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "generatorOperator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind.generatorOwner",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#MarketRoleKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Generator merchant owner."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "generatorOwner"
