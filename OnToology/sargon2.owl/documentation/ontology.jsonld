    "@value" : "Aggregate motor dynamic load associated with this aggregate load."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#LoadAggregate"
  } ],
