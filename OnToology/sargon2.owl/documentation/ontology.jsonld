  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#StaticLoadModelKind",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Type of static load model."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "StaticLoadModelKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Enumeration"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#StaticLoadModelKind.constantZ",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#StaticLoadModelKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The load is represented as a constant impedance.  ConstantZ equations are used  for active and reactive power and no attributes are required."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "constantZ"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#StaticLoadModelKind.exponential",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#StaticLoadModelKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "This model is an exponential representation of the load. Exponential equations for active and reactive power are used and the following attributes are requiredkp1 kp2 kp3 kpf ep1 ep2 ep3kq1 kq2 kq3 kqf eq1 eq2 eq3."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "exponential"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#StaticLoadModelKind.zIP1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#StaticLoadModelKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "This model integrates the frequencydependent load primarily motors.  ZIP1 equations for active and reactive power are used and the following attributes are requiredkp1 kp2 kp3 kpfkq1 kq2 kq3 kqf."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "zIP1"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#StaticLoadModelKind.zIP2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#StaticLoadModelKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "This model separates the frequencydependent load primarily motors from other load.  ZIP2 equations for active and reactive power are used and the following attributes are requiredkp1 kp2 kp3 kq4 kpfkq1 kq2 kq3 kq4 kqf."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "zIP2"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#StaticVarCompensator",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A facility for providing variable and controllable shunt reactive power. The SVC typically consists of a stepdown transformer filter thyristorcontrolled reactor and thyristorswitched capacitor arms.The SVC may operate in fixed MVar output mode or in voltage control mode. When in voltage control mode the output of the SVC will be proportional to the deviation of voltage at the controlled bus from the voltage setpoint.  The SVC characteristic slope defines the proportion.  If the voltage at the controlled bus is equal to the voltage setpoint the SVC MVar output is zero."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "StaticVarCompensator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#RegulatingCondEq"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#StaticVarCompensator.StaticVarCompensatorDynamics",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Static Var Compensator dynamics model used to describe dynamic behaviour of this Static Var Compensator."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#StaticVarCompensator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "StaticVarCompensatorDynamics"
  }, {
    "@value" : "ClientEnd"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#StaticVarCompensatorDynamics"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#StaticVarCompensatorDynamics.StaticVarCompensator"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#StaticVarCompensator.capacitiveRating",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Capacitive reactance at maximum capacitive reactive power.  Shall always be positive."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#StaticVarCompensator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "capacitiveRating"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Reactance"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#StaticVarCompensator.inductiveRating",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Inductive reactance at maximum inductive reactive power.  Shall always be negative.  "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#StaticVarCompensator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "inductiveRating"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Reactance"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#StaticVarCompensator.sVCControlMode",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "SVC control mode."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#StaticVarCompensator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "sVCControlMode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#SVCControlMode"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#StaticVarCompensator.slope",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The characteristics slope of an SVC defines how the reactive power output changes in proportion to the difference between the regulated bus voltage and the voltage setpoint.The attribute shall be a positive value or zero."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#StaticVarCompensator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "slope"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#VoltagePerReactivePower"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#StaticVarCompensator.voltageSetPoint",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The reactive power output of the SVC is proportional to the difference between the voltage at the regulated bus and the voltage setpoint.  When the regulated bus voltage is equal to the voltage setpoint the reactive power output is zero."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#StaticVarCompensator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "voltageSetPoint"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#Voltage"
  } ]
}, {
  "@id" : "http://www.iec.ch/TC57/CIM#StaticVarCompensatorDynamics",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Static var compensator whose behaviour is described by reference to a standard model font color0f0f0for by definition of a userdefined model.font"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
