  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Positive sequence reactance. Used to represent ExtendedWard IEC 60909.Usage  ExtendedWard is a result of network reduction prior to the data exchange. "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.iec.ch/TC57/CIM#EquivalentInjection"
