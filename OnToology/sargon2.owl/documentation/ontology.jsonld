  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Interval at which the scheduled action repeats e.g. first Monday of every month last day of the month etc.."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
