}, {
  "@id" : "http://www.iec.ch/TC57/CIM#type",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Classification by utilitys corporate standards and practices relative to the location itself e.g. geographical functional accounting etc. not a given property that happens to exist at that location."
  }, {
    "@value" : "Classification by utilitys corporate standards and practices."
  }, {
    "@value" : "Classification by utilitys work management standards and practices."
  }, {
    "@value" : "Classification by utilitys work mangement standards and practices."
  }, {
    "@value" : "Description of type of asset."
  }, {
    "@value" : "The coded type of an ACE tariff."
  }, {
    "@value" : "The description of the type of the quantity."
  }, {
    "@value" : "The kind of market roles that can be played by parties for given domains within the electricity market. Types are flexible using dataType of string for freeentry of role types."
  }, {
    "@value" : "The kind of the Auction e.g. implicit explicit ...."
  }, {
    "@value" : "The type of profile.  It could be amount price or quantity."
  }, {
    "@value" : "The type of the constraint."
  }, {
    "@value" : "Type describing rank e.g. high emergency etc."
  }, {
    "@value" : "Type of demand response program examples are CPP criticalpeak pricing RTP realtime pricing DLC direct load control DBP demand bidding program BIP base interruptible program. Note that possible types change a lot and it would be impossible to enumerate them all."
  }, {
    "@value" : "Type of event resulting in this activity record."
  }, {
    "@value" : "Type of physical device from which the control was created. A value of zero 0 can be used when the source is unknown."
  }, {
    "@value" : "Type of physical device from which the event was created. A value of zero 0 can be used when the source is unknown."
  }, {
    "@value" : "Type of role."
  }, {
    "@value" : "Type of scheduled event."
  }, {
    "@value" : "Type of street. Examples include street circle boulevard avenue road drive etc."
  }, {
    "@value" : "Type of test or group of tests that was conducted on dateTime."
  }, {
    "@value" : "Type of this group."
  }, {
    "@value" : "Type of this hazard."
  }, {
    "@value" : "Utilityspecific classification for this person according to the utilitys corporate standards and practices. Examples include employee contractor agent not affiliated etc.Note that this field is not used to indicate whether this person is a customer of the utility. Often an employee or contractor is also a customer. Customer information is gained with relationship to Organisation and CustomerData. In similar fashion this field does not indicate the various roles this person may fill as part of utility operations."
  }, {
    "@value" : "Utilityspecific classification of Asset and its subtypes according to their corporate standards practices and existing IT systems e.g. for management of assets maintenance work outage customers etc.."
  }, {
    "@value" : "Utilityspecific classification of this document according to its corporate standards practices and existing IT systems e.g. for management of assets maintenance work outage customers etc.."
  } ],
