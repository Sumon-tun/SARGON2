  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Describes a tap changer with a table defining the relation between the tap step and the phase angle difference across the transformer. "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "PhaseTapChangerTabular"
  } ],
