<http://www.iec.ch/TC57/CIM#LocationKind> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                          rdfs:comment "The nature of the location being defined for an environmental entity. Possible values are center perimeter primary secondary." ;
                                          rdfs:label "LocationKind"@en .


###  http://www.iec.ch/TC57/CIM#LookUpTableFunctionKind
<http://www.iec.ch/TC57/CIM#LookUpTableFunctionKind> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                     rdfs:label "LookUpTableFunctionKind"@en .


###  http://www.iec.ch/TC57/CIM#LossClearing
<http://www.iec.ch/TC57/CIM#LossClearing> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#MarketFactors> ;
                                          rdfs:comment "RT only and is published on 5 minute intervals for the previous RT time interval results." ;
                                          rdfs:label "LossClearing"@en .


