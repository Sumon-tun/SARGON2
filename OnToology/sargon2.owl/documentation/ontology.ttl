                                                                  rdfs:range <http://www.iec.ch/TC57/CIM#Money> ;
                                                                  rdfs:comment "Cumulative amount in error due to process rounding not reflected in transactionsGandTotal. Values are obtained from Transaction attributessumTransaction.transactionRounding." ;
                                                                  rdfs:label "transactionsGrandTotalRounding"@en .


