                                            rdfs:comment "Reconditioning information for an asset." ;
                                            rdfs:label "Reconditioning"@en .


###  http://www.iec.ch/TC57/CIM#RedLine
<http://www.iec.ch/TC57/CIM#RedLine> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
