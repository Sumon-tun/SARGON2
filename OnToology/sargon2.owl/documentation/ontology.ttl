<http://www.iec.ch/TC57/CIM#TextDiagramObject> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#DiagramObject> ;
                                               rdfs:comment "A diagram object for placing freetext or text derived from an associated domain object." ;
                                               rdfs:label "TextDiagramObject"@en .


###  http://www.iec.ch/TC57/CIM#ThermalGeneratingUnit
<http://www.iec.ch/TC57/CIM#ThermalGeneratingUnit> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#GeneratingUnit> ;
                                                   rdfs:comment "A generating unit whose prime mover could be a steam turbine combustion turbine or diesel engine." ;
                                                   rdfs:label "ThermalGeneratingUnit"@en .


###  http://www.iec.ch/TC57/CIM#TieFlow
<http://www.iec.ch/TC57/CIM#TieFlow> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                     rdfs:comment "Defines the structure in terms of location and direction of the net interchange constraint for a control area. This constraint may be used by either AGC or power flow." ;
                                     rdfs:label "TieFlow"@en .


###  http://www.iec.ch/TC57/CIM#TieLine
<http://www.iec.ch/TC57/CIM#TieLine> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                     rdfs:label "TieLine"@en .


###  http://www.iec.ch/TC57/CIM#TiePoint
<http://www.iec.ch/TC57/CIM#TiePoint> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                      rdfs:comment "Site of an interface between interchange areas. The tie point can be a network branch e.g. transmission line or transformer or a switching device. For transmission lines the interchange area boundary is usually at a designated point such as the middle of the line. Line end metering is then corrected for line losses." ;
                                      rdfs:label "TiePoint"@en .


###  http://www.iec.ch/TC57/CIM#Time
<http://www.iec.ch/TC57/CIM#Time> rdf:type owl:Class ;
                                  owl:equivalentClass <https://w3id.org/saref#Time> ;
                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Primitive> ;
                                  rdfs:comment "Time as hhmmss.sss which conforms with ISO 8601. UTC time zone is specified as hhmmss.sssZ. A local timezone relative UTC is specified as hhmmss.ssshhmm. The second component shown here as ss.sss could have any number of digits in its fractional part to allow any kind of precision beyond seconds." ;
                                  rdfs:label "Time"@en .


###  http://www.iec.ch/TC57/CIM#TimeInterval
<http://www.iec.ch/TC57/CIM#TimeInterval> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Compound> ,
                                                          <https://w3id.org/saref#Time> ;
                                          rdfs:comment "Interval between two times." ;
                                          rdfs:label "TimeInterval"@en .


###  http://www.iec.ch/TC57/CIM#TimeIntervalKind
<http://www.iec.ch/TC57/CIM#TimeIntervalKind> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                              rdfs:label "TimeIntervalKind"@en .


###  http://www.iec.ch/TC57/CIM#TimeOfUse
<http://www.iec.ch/TC57/CIM#TimeOfUse> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                       rdfs:comment "Time of Use used by a CRR definition for specifying the time the CRR spans. ON  CRR spans the on peak hours of the day OFF  CRR spans the off peak hours of the day 24HR  CRR spans the entire day." ;
                                       rdfs:label "TimeOfUse"@en .


###  http://www.iec.ch/TC57/CIM#TimePeriodUnit
<http://www.iec.ch/TC57/CIM#TimePeriodUnit> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                            rdfs:comment "Units in which reporting frequency is specified." ;
                                            rdfs:label "TimePeriodUnit"@en .


###  http://www.iec.ch/TC57/CIM#TimePoint
<http://www.iec.ch/TC57/CIM#TimePoint> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                       rdfs:comment "A point in time within a sequence of points in time relative to a time schedule." ;
                                       rdfs:label "TimePoint"@en .


###  http://www.iec.ch/TC57/CIM#TimeSchedule
<http://www.iec.ch/TC57/CIM#TimeSchedule> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Document> ,
                                                          <https://w3id.org/saref#Time> ;
                                          rdfs:comment "Description of anything that changes through time. Time schedule is used to perform a singlevalued function of time. Use inherited type attribute to give additional information on this schedule such as periodic hourly daily weekly monthly etc. day of the month by date calendar specific times and dates." ;
                                          rdfs:label "TimeSchedule"@en .


###  http://www.iec.ch/TC57/CIM#TimeSeries
<http://www.iec.ch/TC57/CIM#TimeSeries> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                        rdfs:comment "A set of regular timeordered measurements or values of quantitative nature of an individual or collective phenomenon taken at successive in most cases equidistant periods  points of time." ;
                                        rdfs:label "TimeSeries"@en .


###  http://www.iec.ch/TC57/CIM#TimeTariffInterval
<http://www.iec.ch/TC57/CIM#TimeTariffInterval> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                rdfs:comment "One of a sequence of time intervals defined in terms of real time. It is typically used in association with TariffProfile to define the intervals in a time of use tariff structure where startDateTime simultaneously determines the starting point of this interval and the ending point of the previous interval." ;
                                                rdfs:label "TimeTariffInterval"@en .


###  http://www.iec.ch/TC57/CIM#TimeZoneType
<http://www.iec.ch/TC57/CIM#TimeZoneType> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                          rdfs:label "TimeZoneType"@en .


###  http://www.iec.ch/TC57/CIM#Tool
<http://www.iec.ch/TC57/CIM#Tool> rdf:type owl:Class ;
                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#WorkAsset> ;
                                  rdfs:comment "Tool asset." ;
                                  rdfs:label "Tool"@en .


###  http://www.iec.ch/TC57/CIM#Toplevel
<http://www.iec.ch/TC57/CIM#Toplevel> rdf:type owl:Class .


###  http://www.iec.ch/TC57/CIM#TopologicalIsland
<http://www.iec.ch/TC57/CIM#TopologicalIsland> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                               rdfs:comment "An electrically connected subset of the network. Topological islands can change as the current network state changes e.g. due to  disconnect switches or breakers changing state in a SCADAEMS. manual creation change or deletion of topological nodes in a planning tool.Only energised TopologicalNodes shall be part of the topological island." ;
                                               rdfs:label "TopologicalIsland"@en .


###  http://www.iec.ch/TC57/CIM#TopologicalNode
<http://www.iec.ch/TC57/CIM#TopologicalNode> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                             rdfs:comment "For a detailed substation model a topological node is a set of connectivity nodes that in the current network state are connected together through any type of closed switches including  jumpers. Topological nodes change as the current network state changes i.e. switches breakers etc. change state.For a planning model switch statuses are not used to form topological nodes. Instead they are manually created or deleted in a model builder tool. Topological nodes maintained this way are also called busses." ;
                                             rdfs:label "TopologicalNode"@en .


###  http://www.iec.ch/TC57/CIM#Tornado
<http://www.iec.ch/TC57/CIM#Tornado> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#AtmosphericPhenomenon> ;
                                     rdfs:comment "A tornado a violent destructive whirling wind accompanied by a funnelshaped cloud that progresses in a narrow path over the land." ;
                                     rdfs:label "Tornado"@en .


###  http://www.iec.ch/TC57/CIM#Tower
<http://www.iec.ch/TC57/CIM#Tower> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Structure> ;
                                   rdfs:comment "Tower asset. Dimensions of the Tower are specified in associated DimensionsInfo class.When used for planning purposes a transmission tower carrying two 3phase circuits will have 2 instances of Connection each of which will have 3 MountingPoint instances one for each phase all with coordinates relative to a common origin on the tower. It may also have a 3rd Connection with a single MountingPoint for the Neutral line." ;
                                   rdfs:label "Tower"@en .


###  http://www.iec.ch/TC57/CIM#TowerConstructionKind
<http://www.iec.ch/TC57/CIM#TowerConstructionKind> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                   rdfs:comment "Kind of tower construction." ;
                                                   rdfs:label "TowerConstructionKind"@en .


###  http://www.iec.ch/TC57/CIM#TownDetail
<http://www.iec.ch/TC57/CIM#TownDetail> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Compound> ;
                                        rdfs:comment "Town details in the context of address." ;
                                        rdfs:label "TownDetail"@en .


###  http://www.iec.ch/TC57/CIM#Trade
<http://www.iec.ch/TC57/CIM#Trade> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                   rdfs:comment "Inter Scheduling Coordinator Trades to model financial trades which may impact settlement." ;
                                   rdfs:label "Trade"@en .


###  http://www.iec.ch/TC57/CIM#TradeError
<http://www.iec.ch/TC57/CIM#TradeError> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                        rdfs:comment "Trade error and warning messages associated with the rule engine processing of the submitted trade." ;
                                        rdfs:label "TradeError"@en .


###  http://www.iec.ch/TC57/CIM#TradeProduct
<http://www.iec.ch/TC57/CIM#TradeProduct> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                          rdfs:comment "bTradeTypeb                                        bTradeProductbIST  InterSC Trade                          PHY Physical Energy TradeIST                                                  APN Energy Trades at Aggregated Pricing NodesIST                                                  CPT Converted Physical Energy TradeAST Ancilliary Services Trade             RUT Regulation Up TradeAST                                                 RDT Regulation Down TradeAST                                                 SRT Spinning Reserve TradeAST                                                 NRT NonSpinning Reserve TradeUCT Unit Commitment Trade            null" ;
                                          rdfs:label "TradeProduct"@en .


###  http://www.iec.ch/TC57/CIM#TradeProductType
<http://www.iec.ch/TC57/CIM#TradeProductType> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                              rdfs:label "TradeProductType"@en .


###  http://www.iec.ch/TC57/CIM#TradeStatusType
<http://www.iec.ch/TC57/CIM#TradeStatusType> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                             rdfs:comment "RJ  Rejected TradeI  Invalid TradeV  Valid TradeM  Modified TradeCV  Conditionally Valid TradeCM  Conditionally Modified TradeCI  Conditionally Invalid TradeCX  Cancelled TradeO  Obsolete TradeMT  Matched TradeU  Unmatched Trade" ;
                                             rdfs:label "TradeStatusType"@en .


###  http://www.iec.ch/TC57/CIM#TradeType
<http://www.iec.ch/TC57/CIM#TradeType> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                       rdfs:comment "Trade type." ;
                                       rdfs:label "TradeType"@en .


