<http://www.iec.ch/TC57/CIM#BidStatusType> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                           rdfs:comment "Status indication for bidsCV  Conditionally Valid BidCM  Conditionally Modified BidV  Valid BidM  Modified BidRJ  Rejected BidI  Invalid BidCX  Cancelled BidO  Obsolete BidCL  Clean BidRP  Replicated Bid" ;
                                           rdfs:label "BidStatusType"@en .


