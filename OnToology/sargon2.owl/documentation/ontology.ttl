<http://www.iec.ch/TC57/CIM#MeasurementCalculator> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                   rdfs:comment "Result of a calculation of one or more measurement. " ;
                                                   rdfs:label "MeasurementCalculator"@en .


