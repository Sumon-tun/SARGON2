<http://www.iec.ch/TC57/CIM#EPAStandardKind> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                             rdfs:comment "List of EPA standards." ;
                                             rdfs:label "EPAStandardKind"@en .


###  http://www.iec.ch/TC57/CIM#ERTConfidenceKind
<http://www.iec.ch/TC57/CIM#ERTConfidenceKind> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                               rdfs:comment "The estimated time of restoration can have a confidence factor applied such as high or low confidence that the ERT will be accomplished.  This confidence factor may be updated as needed during the outage period  just as the actual ERT can be updated." ;
                                               rdfs:label "ERTConfidenceKind"@en .


###  http://www.iec.ch/TC57/CIM#EarthFaultCompensator
<http://www.iec.ch/TC57/CIM#EarthFaultCompensator> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ConductingEquipment> ;
                                                   rdfs:comment "A conducting equipment used to represent a connection to ground which is typically used to compensate earth faults.   An earth fault compensator device modelled with a single terminal implies a second terminal solidly connected to ground.  If two terminals are modelled the ground is not assumed and normal connection rules apply." ;
                                                   rdfs:label "EarthFaultCompensator"@en .


###  http://www.iec.ch/TC57/CIM#Earthquake
<http://www.iec.ch/TC57/CIM#Earthquake> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#GeosphericPhenomenon> ;
                                        rdfs:comment "An earthquake." ;
                                        rdfs:label "Earthquake"@en .


###  http://www.iec.ch/TC57/CIM#Editor
<http://www.iec.ch/TC57/CIM#Editor> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#DocumentPersonRole> ;
                                    rdfs:comment "Person who modified the document." ;
                                    rdfs:label "Editor"@en .


###  http://www.iec.ch/TC57/CIM#ElectronicAddress
<http://www.iec.ch/TC57/CIM#ElectronicAddress> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Compound> ;
                                               rdfs:comment "Electronic address information." ;
                                               rdfs:label "ElectronicAddress"@en .


###  http://www.iec.ch/TC57/CIM#Emission
<http://www.iec.ch/TC57/CIM#Emission> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#CIMDatatype> ;
                                      rdfs:comment "Quantity of emission per fuel heat content." ;
                                      rdfs:label "Emission"@en .


###  http://www.iec.ch/TC57/CIM#EmissionAccount
<http://www.iec.ch/TC57/CIM#EmissionAccount> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Curve> ;
                                             rdfs:comment "Accounts for tracking emissions usage and credits for thermal generating units. A unit may have zero or more emission accounts and will typically have one for tracking usage and one for tracking credits." ;
                                             rdfs:label "EmissionAccount"@en .


###  http://www.iec.ch/TC57/CIM#EmissionCurve
<http://www.iec.ch/TC57/CIM#EmissionCurve> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Curve> ;
                                           rdfs:comment "Relationship between the units emission rate in units of mass per hour Yaxis and output active power Xaxis for a given type of emission. This curve applies when only one type of fuel is being burned." ;
                                           rdfs:label "EmissionCurve"@en .


###  http://www.iec.ch/TC57/CIM#EmissionType
<http://www.iec.ch/TC57/CIM#EmissionType> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                          rdfs:comment "The type of emission." ;
                                          rdfs:label "EmissionType"@en .


###  http://www.iec.ch/TC57/CIM#EmissionValueSource
<http://www.iec.ch/TC57/CIM#EmissionValueSource> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                 rdfs:comment "The source of the emission value." ;
                                                 rdfs:label "EmissionValueSource"@en .


###  http://www.iec.ch/TC57/CIM#EndDevice
<http://www.iec.ch/TC57/CIM#EndDevice> rdf:type owl:Class ;
                                       owl:equivalentClass <https://w3id.org/saref#Device> ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#AssetContainer> ;
                                       rdfs:comment "Asset container that performs one or more end device functions. One type of end device is a meter which can perform metering load management connectdisconnect accounting functions etc. Some end devices such as ones monitoring and controlling air conditioners refrigerators pool pumps may be connected to a meter. All end devices may have communication capability defined by the associated communication functions. An end device may be owned by a consumer a service provider utility or otherwise.There may be a related end device function that identifies a sensor or control point within a metering application or communications systems e.g. water gas electricity.Some devices may use an optical port that conforms to the ANSI C12.18 standard for communications." ;
                                       rdfs:label "EndDevice"@en .


###  http://www.iec.ch/TC57/CIM#EndDeviceAction
<http://www.iec.ch/TC57/CIM#EndDeviceAction> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                             rdfs:comment "Actioncommand performed by an end device on a device other than the end device." ;
                                             rdfs:label "EndDeviceAction"@en .


###  http://www.iec.ch/TC57/CIM#EndDeviceCapability
<http://www.iec.ch/TC57/CIM#EndDeviceCapability> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Compound> ;
                                                 rdfs:comment "Inherent capabilities of an end device i.e. the functions it supports." ;
                                                 rdfs:label "EndDeviceCapability"@en .


###  http://www.iec.ch/TC57/CIM#EndDeviceControl
<http://www.iec.ch/TC57/CIM#EndDeviceControl> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                              rdfs:comment "Instructs an end device or an end device group to perform a specified action." ;
                                              rdfs:label "EndDeviceControl"@en .


###  http://www.iec.ch/TC57/CIM#EndDeviceControlType
<http://www.iec.ch/TC57/CIM#EndDeviceControlType> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                  rdfs:comment "Detailed description for a control produced by an end device. Values in attributes allow for creation of recommended codes to be used for identifying end device controls as follows type.domain.subDomain.eventOrAction." ;
                                                  rdfs:label "EndDeviceControlType"@en .


###  http://www.iec.ch/TC57/CIM#EndDeviceEvent
<http://www.iec.ch/TC57/CIM#EndDeviceEvent> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ActivityRecord> ;
                                            rdfs:comment "Event detected by a device function associated with the end device." ;
                                            rdfs:label "EndDeviceEvent"@en .


###  http://www.iec.ch/TC57/CIM#EndDeviceEventDetail
<http://www.iec.ch/TC57/CIM#EndDeviceEventDetail> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                  rdfs:comment "Namevalue pair specific to end device events." ;
                                                  rdfs:label "EndDeviceEventDetail"@en .


###  http://www.iec.ch/TC57/CIM#EndDeviceEventType
<http://www.iec.ch/TC57/CIM#EndDeviceEventType> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                rdfs:comment "Detailed description for an event produced by an end device. Values in attributes allow for creation of recommended codes to be used for identifying end device events as follows type.domain.subDomain.eventOrAction." ;
                                                rdfs:label "EndDeviceEventType"@en .


###  http://www.iec.ch/TC57/CIM#EndDeviceFunction
<http://www.iec.ch/TC57/CIM#EndDeviceFunction> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#AssetFunction> ;
                                               rdfs:comment "Function performed by an end device such as a meter communication equipment controllers etc." ;
                                               rdfs:label "EndDeviceFunction"@en .


###  http://www.iec.ch/TC57/CIM#EndDeviceFunctionKind
<http://www.iec.ch/TC57/CIM#EndDeviceFunctionKind> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                   rdfs:comment "Kind of end device function." ;
                                                   rdfs:label "EndDeviceFunctionKind"@en .


###  http://www.iec.ch/TC57/CIM#EndDeviceGroup
<http://www.iec.ch/TC57/CIM#EndDeviceGroup> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                            rdfs:comment "Abstraction for management of group communications within a twoway AMR system or the data for a group of related end devices. Commands can be issued to all of the end devices that belong to the group using a defined group address and the underlying AMR communication infrastructure. A DERGroup and a PANDeviceGroup is an EndDeviceGroup." ;
                                            rdfs:label "EndDeviceGroup"@en .


###  http://www.iec.ch/TC57/CIM#EndDeviceInfo
<http://www.iec.ch/TC57/CIM#EndDeviceInfo> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#AssetInfo> ;
                                           rdfs:comment "End device data." ;
                                           rdfs:label "EndDeviceInfo"@en .


###  http://www.iec.ch/TC57/CIM#EndDeviceTiming
<http://www.iec.ch/TC57/CIM#EndDeviceTiming> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Compound> ;
                                             rdfs:comment "Timing for the control actions of end devices." ;
                                             rdfs:label "EndDeviceTiming"@en .


###  http://www.iec.ch/TC57/CIM#EnergyArea
<http://www.iec.ch/TC57/CIM#EnergyArea> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                        rdfs:comment "Describes an area having energy production or consumption.  Specializations are intended to support the load allocation function as typically required in energy management systems or planning studies to allocate hypothesized load levels to individual load points for power flow analysis.  Often the energy area can be linked to both measured and forecast load levels." ;
                                        rdfs:label "EnergyArea"@en .


###  http://www.iec.ch/TC57/CIM#EnergyComponent
<http://www.iec.ch/TC57/CIM#EnergyComponent> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                             rdfs:label "EnergyComponent"@en .


###  http://www.iec.ch/TC57/CIM#EnergyConnection
<http://www.iec.ch/TC57/CIM#EnergyConnection> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ConductingEquipment> ;
                                              rdfs:comment "A connection of energy generation or consumption on the power system model." ;
                                              rdfs:label "EnergyConnection"@en .


###  http://www.iec.ch/TC57/CIM#EnergyConsumer
<http://www.iec.ch/TC57/CIM#EnergyConsumer> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#EnergyConnection> ;
                                            rdfs:comment "Generic user of energy  a  point of consumption on the power system model.EnergyConsumer.pfixed .qfixed .pfixedPct and .qfixedPct have meaning only if there is no LoadResponseCharacteristic associated with EnergyConsumer or if LoadResponseCharacteristic.exponentModel is set to False." ;
                                            rdfs:label "EnergyConsumer"@en .


###  http://www.iec.ch/TC57/CIM#EnergyConsumerAction
<http://www.iec.ch/TC57/CIM#EnergyConsumerAction> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#SwitchingAction> ;
                                                  rdfs:comment "Action to connect or disconnect the Energy Consumer from its Terminal" ;
                                                  rdfs:label "EnergyConsumerAction"@en .


###  http://www.iec.ch/TC57/CIM#EnergyConsumerPhase
<http://www.iec.ch/TC57/CIM#EnergyConsumerPhase> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemResource> ;
                                                 rdfs:comment "A single phase of an energy consumer." ;
                                                 rdfs:label "EnergyConsumerPhase"@en .


###  http://www.iec.ch/TC57/CIM#EnergyGroup
<http://www.iec.ch/TC57/CIM#EnergyGroup> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemResource> ;
                                         rdfs:label "EnergyGroup"@en .


###  http://www.iec.ch/TC57/CIM#EnergyMarket
<http://www.iec.ch/TC57/CIM#EnergyMarket> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Market> ;
                                          rdfs:comment "Energy and Ancillary Market e.g. Energy Spinning Reserve NonSpinning Reserve with a description of the Market operation control parameters." ;
                                          rdfs:label "EnergyMarket"@en .


###  http://www.iec.ch/TC57/CIM#EnergyPriceCurve
<http://www.iec.ch/TC57/CIM#EnergyPriceCurve> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                              rdfs:comment "Relationship between a price in or other monetary unit hour Yaxis and a MW value Xaxis. " ;
                                              rdfs:label "EnergyPriceCurve"@en .


###  http://www.iec.ch/TC57/CIM#EnergyPriceIndex
<http://www.iec.ch/TC57/CIM#EnergyPriceIndex> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                              rdfs:comment "An Energy Price Index for each Resource is valid for a period e.g. daily that is identified by a Valid Period Start Time and a Valid Period End Time. An Energy Price Index is in MWh." ;
                                              rdfs:label "EnergyPriceIndex"@en .


###  http://www.iec.ch/TC57/CIM#EnergyPriceIndexType
<http://www.iec.ch/TC57/CIM#EnergyPriceIndexType> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                  rdfs:comment "For exampleWHOLESALERETAILBOTH" ;
                                                  rdfs:label "EnergyPriceIndexType"@en .


###  http://www.iec.ch/TC57/CIM#EnergyProduct
<http://www.iec.ch/TC57/CIM#EnergyProduct> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Agreement> ;
                                           rdfs:comment "An EnergyProduct is offered commercially as a ContractOrTariff." ;
                                           rdfs:label "EnergyProduct"@en .


###  http://www.iec.ch/TC57/CIM#EnergyProductType
<http://www.iec.ch/TC57/CIM#EnergyProductType> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                               rdfs:comment "Energy product type." ;
                                               rdfs:label "EnergyProductType"@en .


###  http://www.iec.ch/TC57/CIM#EnergyProfile
<http://www.iec.ch/TC57/CIM#EnergyProfile> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Profile> ;
                                           rdfs:comment "Specifies the start time stop time level for an EnergyTransaction." ;
                                           rdfs:label "EnergyProfile"@en .


###  http://www.iec.ch/TC57/CIM#EnergySchedulingType
<http://www.iec.ch/TC57/CIM#EnergySchedulingType> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                  rdfs:comment "Used to define the type of generation for scheduling purposes." ;
                                                  rdfs:label "EnergySchedulingType"@en .


###  http://www.iec.ch/TC57/CIM#EnergySource
<http://www.iec.ch/TC57/CIM#EnergySource> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#EnergyConnection> ;
                                          rdfs:comment "A generic equivalent for an energy supplier on a transmission or distribution voltage level." ;
                                          rdfs:label "EnergySource"@en .


###  http://www.iec.ch/TC57/CIM#EnergySourceAction
<http://www.iec.ch/TC57/CIM#EnergySourceAction> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#SwitchingAction> ;
                                                rdfs:comment "Action on energy source as a switching step." ;
                                                rdfs:label "EnergySourceAction"@en .


###  http://www.iec.ch/TC57/CIM#EnergySourcePhase
<http://www.iec.ch/TC57/CIM#EnergySourcePhase> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemResource> ;
                                               rdfs:comment "Represents the single phase information of an unbalanced energy source." ;
                                               rdfs:label "EnergySourcePhase"@en .


###  http://www.iec.ch/TC57/CIM#EnergyTransaction
<http://www.iec.ch/TC57/CIM#EnergyTransaction> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Document> ;
                                               rdfs:comment "Specifies the schedule for energy transfers between interchange areas that are necessary to satisfy the associated interchange transaction." ;
                                               rdfs:label "EnergyTransaction"@en .


###  http://www.iec.ch/TC57/CIM#EnergyTransactionType
<http://www.iec.ch/TC57/CIM#EnergyTransactionType> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                   rdfs:comment "Defines the state of a transaction." ;
                                                   rdfs:label "EnergyTransactionType"@en .


###  http://www.iec.ch/TC57/CIM#EnergyTypeCode
<http://www.iec.ch/TC57/CIM#EnergyTypeCode> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                            rdfs:comment "Valid Enumerations1 DASE Day Ahead Scheduled Energy 2 DSSE Day Ahead Incremental Self Schedule Energy 3 DABE Day Ahead Incremental Energy Bid Awarded Energy 4 OE Optimal Energy 5 HASE Hour ahead predispatched schedule energy 6 SRE Standard Ramping Energy 7 RED Ramping Energy Deviation 8 EDE Exceptional Dispatch energy 9 RMRE RMR Energy 10 MSSLFE MSSLF Energy 11 RE Residual Energy 12 MLE Minimum Load Energy 13 SE SLIC Energy 14 RTSSE Real time self scheduled energy 15 DMLE Day ahead minimum load energy 16 PE Pumping Energy 17 TEE Total Expected Energy 18 DAPE  DayAhead Pumping Energy" ;
                                            rdfs:label "EnergyTypeCode"@en .


###  http://www.iec.ch/TC57/CIM#EnergyTypeKind
<http://www.iec.ch/TC57/CIM#EnergyTypeKind> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                            rdfs:label "EnergyTypeKind"@en .


###  http://www.iec.ch/TC57/CIM#EnergyTypeReference
<http://www.iec.ch/TC57/CIM#EnergyTypeReference> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                 rdfs:label "EnergyTypeReference"@en .


###  http://www.iec.ch/TC57/CIM#Enumeration
<http://www.iec.ch/TC57/CIM#Enumeration> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Datatype> .


###  http://www.iec.ch/TC57/CIM#EnvironmentalAlert
<http://www.iec.ch/TC57/CIM#EnvironmentalAlert> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ActivityRecord> ;
                                                rdfs:comment "An environmental alert issued by a provider or system." ;
                                                rdfs:label "EnvironmentalAlert"@en .


###  http://www.iec.ch/TC57/CIM#EnvironmentalAnalog
<http://www.iec.ch/TC57/CIM#EnvironmentalAnalog> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Analog> ;
                                                 rdfs:comment "Analog float measurement of relevance in the environmental domain." ;
                                                 rdfs:label "EnvironmentalAnalog"@en .


###  http://www.iec.ch/TC57/CIM#EnvironmentalCodedValue
<http://www.iec.ch/TC57/CIM#EnvironmentalCodedValue> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#StringMeasurementValue> ;
                                                     rdfs:comment "An environmental value described using a coded value. A triplicate of enumerated values representing intensity coverage type of weather is used. These may be concatenated into the string value." ;
                                                     rdfs:label "EnvironmentalCodedValue"@en .


###  http://www.iec.ch/TC57/CIM#EnvironmentalDataAuthority
<http://www.iec.ch/TC57/CIM#EnvironmentalDataAuthority> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#OrganisationRole> ;
                                                        rdfs:comment "An entity defining classifications or categories of environmental information like phenomena or alerts." ;
                                                        rdfs:label "EnvironmentalDataAuthority"@en .


###  http://www.iec.ch/TC57/CIM#EnvironmentalDataProvider
<http://www.iec.ch/TC57/CIM#EnvironmentalDataProvider> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#OrganisationRole> ;
                                                       rdfs:comment "Entity providing environmental data.  Could be an observed weather data provider an entity providing forecasts an authority providing alerts etc." ;
                                                       rdfs:label "EnvironmentalDataProvider"@en .


###  http://www.iec.ch/TC57/CIM#EnvironmentalDependentLimit
<http://www.iec.ch/TC57/CIM#EnvironmentalDependentLimit> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#LimitDependency> ;
                                                         rdfs:comment "This is a environmental based limit dependency model for calculating operational limits." ;
                                                         rdfs:label "EnvironmentalDependentLimit"@en .


###  http://www.iec.ch/TC57/CIM#EnvironmentalDiscrete
<http://www.iec.ch/TC57/CIM#EnvironmentalDiscrete> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Discrete> ;
                                                   rdfs:comment "Discrete integer measurement of relevance in the environmental domain." ;
                                                   rdfs:label "EnvironmentalDiscrete"@en .


###  http://www.iec.ch/TC57/CIM#EnvironmentalDiscreteKind
<http://www.iec.ch/TC57/CIM#EnvironmentalDiscreteKind> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                       rdfs:comment "Discrete integer measuring an environmental condition." ;
                                                       rdfs:label "EnvironmentalDiscreteKind"@en .


###  http://www.iec.ch/TC57/CIM#EnvironmentalEvent
<http://www.iec.ch/TC57/CIM#EnvironmentalEvent> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ActivityRecord> ;
                                                rdfs:comment "An environmental event to which one or more forecasts or observations may be tied and which may relate to or affect one or more assets.This class is intended to be used as a means of grouping forecasts andor observations and could be used for a variety of purposes includingullito define a named event like Hurricane Katrina and allow the historic or forecast values for phenomena and measurements precipitation temperature across time to be  associated with itlilito identify assets that were or are forecast to be affected by a phenomenon or set of measurementsliul" ;
                                                rdfs:label "EnvironmentalEvent"@en .


###  http://www.iec.ch/TC57/CIM#EnvironmentalInformation
<http://www.iec.ch/TC57/CIM#EnvironmentalInformation> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                      rdfs:comment "Abstract class with concrete child classes of Observation and Forecast that groups phenomenon andor environmental value sets. " ;
                                                      rdfs:label "EnvironmentalInformation"@en .


###  http://www.iec.ch/TC57/CIM#EnvironmentalLocationType
<http://www.iec.ch/TC57/CIM#EnvironmentalLocationType> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                       rdfs:comment "Type of environmental location. Used when an environmental alert or phenomenon has multiple locations associated with it." ;
                                                       rdfs:label "EnvironmentalLocationType"@en .


###  http://www.iec.ch/TC57/CIM#EnvironmentalMonitoringStation
<http://www.iec.ch/TC57/CIM#EnvironmentalMonitoringStation> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                            rdfs:comment "An environmental monitoring station examples of which could be a weather station or a seismic monitoring station.  " ;
                                                            rdfs:label "EnvironmentalMonitoringStation"@en .


###  http://www.iec.ch/TC57/CIM#EnvironmentalPhenomenon
<http://www.iec.ch/TC57/CIM#EnvironmentalPhenomenon> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                     rdfs:comment "The actual or forecast characteristics of an environmental phenomenon at a specific point in time or during a specific time interval that may have both a center and arealine location. " ;
                                                     rdfs:label "EnvironmentalPhenomenon"@en .


###  http://www.iec.ch/TC57/CIM#EnvironmentalStringMeasurement
<http://www.iec.ch/TC57/CIM#EnvironmentalStringMeasurement> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#StringMeasurement> ;
                                                            rdfs:comment "String measurement of relevance in the environmental domain." ;
                                                            rdfs:label "EnvironmentalStringMeasurement"@en .


###  http://www.iec.ch/TC57/CIM#Equipment
<http://www.iec.ch/TC57/CIM#Equipment> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemResource> ;
                                       rdfs:comment "The parts of a power system that are physical devices electronic or mechanical." ;
                                       rdfs:label "Equipment"@en .


###  http://www.iec.ch/TC57/CIM#EquipmentContainer
<http://www.iec.ch/TC57/CIM#EquipmentContainer> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ConnectivityNodeContainer> ;
                                                rdfs:comment "A modelling construct to provide a root class for containing equipment. " ;
                                                rdfs:label "EquipmentContainer"@en .


###  http://www.iec.ch/TC57/CIM#EquipmentFault
<http://www.iec.ch/TC57/CIM#EquipmentFault> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Fault> ;
                                            rdfs:comment "A fault applied at the terminal external to the equipment. This class is not used to specify faults internal to the equipment." ;
                                            rdfs:label "EquipmentFault"@en .


###  http://www.iec.ch/TC57/CIM#EquipmentLimitSeriesComponent
<http://www.iec.ch/TC57/CIM#EquipmentLimitSeriesComponent> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                           rdfs:comment "This represents one instance of an equipment that contributes to the calculation of an operational limit." ;
                                                           rdfs:label "EquipmentLimitSeriesComponent"@en .


###  http://www.iec.ch/TC57/CIM#EquipmentStatusType
<http://www.iec.ch/TC57/CIM#EquipmentStatusType> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                 rdfs:comment "Status of equipment." ;
                                                 rdfs:label "EquipmentStatusType"@en .


###  http://www.iec.ch/TC57/CIM#EquipmentUnavailabilitySchedule
<http://www.iec.ch/TC57/CIM#EquipmentUnavailabilitySchedule> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                             rdfs:label "EquipmentUnavailabilitySchedule"@en .


###  http://www.iec.ch/TC57/CIM#EquivalentBranch
<http://www.iec.ch/TC57/CIM#EquivalentBranch> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#EquivalentEquipment> ;
                                              rdfs:comment "The class represents equivalent branches. In cases where a transformer phase shift is modelled and the EquivalentBranch is spanning the same nodes the impedance quantities for the EquivalentBranch shall consider the needed phase shift." ;
                                              rdfs:label "EquivalentBranch"@en .


###  http://www.iec.ch/TC57/CIM#EquivalentEquipment
<http://www.iec.ch/TC57/CIM#EquivalentEquipment> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ConductingEquipment> ;
                                                 rdfs:comment "The class represents equivalent objects that are the result of a network reduction. The class is the base for equivalent objects of different types." ;
                                                 rdfs:label "EquivalentEquipment"@en .


###  http://www.iec.ch/TC57/CIM#EquivalentInjection
<http://www.iec.ch/TC57/CIM#EquivalentInjection> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#EquivalentEquipment> ;
                                                 rdfs:comment "This class represents equivalent injections generation or load.  Voltage regulation is allowed only at the point of connection." ;
                                                 rdfs:label "EquivalentInjection"@en .


###  http://www.iec.ch/TC57/CIM#EquivalentNetwork
<http://www.iec.ch/TC57/CIM#EquivalentNetwork> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ConnectivityNodeContainer> ;
                                               rdfs:comment "A class that groups electrical equivalents including internal nodes of a network that has been reduced. The ConnectivityNodes contained in the equivalent are intended to reflect internal nodes of the equivalent. The boundary Connectivity nodes where the equivalent connects outside itself are not contained by the equivalent." ;
                                               rdfs:label "EquivalentNetwork"@en .


###  http://www.iec.ch/TC57/CIM#EquivalentShunt
<http://www.iec.ch/TC57/CIM#EquivalentShunt> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#EquivalentEquipment> ;
                                             rdfs:comment "The class represents equivalent shunts." ;
                                             rdfs:label "EquivalentShunt"@en .


###  http://www.iec.ch/TC57/CIM#ErpAccountKind
<http://www.iec.ch/TC57/CIM#ErpAccountKind> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                            rdfs:comment "Kind of ERP account." ;
                                            rdfs:label "ErpAccountKind"@en .


###  http://www.iec.ch/TC57/CIM#ErpBOM
<http://www.iec.ch/TC57/CIM#ErpBOM> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpDocument> ;
                                    rdfs:comment "Information that generally describes the Bill of Material Structure and its contents for a utility.This is used by ERP systems to transfer Bill of Material information between two business applications." ;
                                    rdfs:label "ErpBOM"@en .


###  http://www.iec.ch/TC57/CIM#ErpBankAccount
<http://www.iec.ch/TC57/CIM#ErpBankAccount> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#BankAccount> ;
                                            rdfs:comment "Relationship under a particular name usually evidenced by a deposit against which withdrawals can be made. Types of bank accounts include demand time custodial joint trustee corporate special and regular accounts.A statement of transactions during a fiscal period and the resulting balance is maintained on each account.For Payment metering the account is associated with Bank and Supplier reflecting details of the bank account used for depositing revenue collected by TokenVendor. The name of the account holder should be specified in name attribute." ;
                                            rdfs:label "ErpBankAccount"@en .


###  http://www.iec.ch/TC57/CIM#ErpBomItemData
<http://www.iec.ch/TC57/CIM#ErpBomItemData> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> ;
                                            rdfs:comment "An individual item on a bill of materials." ;
                                            rdfs:label "ErpBomItemData"@en .


###  http://www.iec.ch/TC57/CIM#ErpCompetency
<http://www.iec.ch/TC57/CIM#ErpCompetency> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> ;
                                           rdfs:comment "Information that describes aptitudes of a utility employee. Unlike Skills that an ErpPerson must be certified to perform before undertaking certain type of assignments to be able to perfrom a Craft ErpCompetency has more to do with typical Human Resource HR matters such as schooling training etc." ;
                                           rdfs:label "ErpCompetency"@en .


###  http://www.iec.ch/TC57/CIM#ErpDocument
<http://www.iec.ch/TC57/CIM#ErpDocument> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Document> ;
                                         rdfs:comment "Shadow class for Document to isolate subclassing from this package. If any subclass gets normative and needs inheritance it will inherit directly from Document." ;
                                         rdfs:label "ErpDocument"@en .


###  http://www.iec.ch/TC57/CIM#ErpIdentifiedObject
<http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                 rdfs:comment "Shadow class for IdentifiedObject to isolate subclassing from this package. If any subclass gets normative and needs inheritance it will inherit directly from IdentifiedObject." ;
                                                 rdfs:label "ErpIdentifiedObject"@en .


###  http://www.iec.ch/TC57/CIM#ErpInventory
<http://www.iec.ch/TC57/CIM#ErpInventory> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> ;
                                          rdfs:comment "Utility inventoryrelated information about an item or part and not for description of the item and its attributes. It is used by ERP applications to enable the synchronization of Inventory data that exists on separate Item Master databases. This data is not the master data that describes the attributes of the item such as dimensions weight or unit of measure  it describes the item as it exists at a specific location." ;
                                          rdfs:label "ErpInventory"@en .


###  http://www.iec.ch/TC57/CIM#ErpInventoryCount
<http://www.iec.ch/TC57/CIM#ErpInventoryCount> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> ;
                                               rdfs:comment "This is related to Inventory physical counts organized by AssetModel. Note that a count of a type of asset can be accomplished by the association inherited by AssetModel from Document to Asset.It enables ERP applications to transfer an inventory count between ERP and the actual physical inventory location. This count may be a cycle count or a physical count." ;
                                               rdfs:label "ErpInventoryCount"@en .


###  http://www.iec.ch/TC57/CIM#ErpInvoice
<http://www.iec.ch/TC57/CIM#ErpInvoice> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpDocument> ;
                                        rdfs:comment "A roll up of invoice line items. The whole invoice has a due date and amount to be paid with information such as customer banks etc. being obtained through associations. The invoice roll up is based on individual line items that each contain amounts and descriptions for specific services or products." ;
                                        rdfs:label "ErpInvoice"@en .


###  http://www.iec.ch/TC57/CIM#ErpInvoiceKind
<http://www.iec.ch/TC57/CIM#ErpInvoiceKind> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                            rdfs:comment "Kind of ERP invoice." ;
                                            rdfs:label "ErpInvoiceKind"@en .


###  http://www.iec.ch/TC57/CIM#ErpInvoiceLineItem
<http://www.iec.ch/TC57/CIM#ErpInvoiceLineItem> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpDocument> ;
                                                rdfs:comment "An individual line item on an invoice." ;
                                                rdfs:label "ErpInvoiceLineItem"@en .


###  http://www.iec.ch/TC57/CIM#ErpInvoiceLineItemKind
<http://www.iec.ch/TC57/CIM#ErpInvoiceLineItemKind> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                    rdfs:comment "Kind of invoice line item." ;
                                                    rdfs:label "ErpInvoiceLineItemKind"@en .


###  http://www.iec.ch/TC57/CIM#ErpIssueInventory
<http://www.iec.ch/TC57/CIM#ErpIssueInventory> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> ;
                                               rdfs:comment "Can be used to request an application to process an issue or request information about an issue." ;
                                               rdfs:label "ErpIssueInventory"@en .


###  http://www.iec.ch/TC57/CIM#ErpItemMaster
<http://www.iec.ch/TC57/CIM#ErpItemMaster> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> ;
                                           rdfs:comment "Any unique purchased part for manufactured product tracked by ERP systems for a utility.Item as used by the OAG refers to the basic information about an item including its attributes cost and locations. It does not include item quantities. Compare to the Inventory which includes all quantities and other locationspecific information." ;
                                           rdfs:label "ErpItemMaster"@en .


###  http://www.iec.ch/TC57/CIM#ErpJournal
<http://www.iec.ch/TC57/CIM#ErpJournal> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpDocument> ;
                                        rdfs:comment "Book for recording accounting transactions as they occur. Transactions and adjustments are first recorded in a journal which is like a diary of instructions advising which account to be charged and by how much.A journal represents a change in the balances of a businesss financial accounts. Many tasks or transactions throughout an enterprise will result in the creation of a journal. Some examples are creating a customer invoice paying a vendor transferring inventory or paying employees." ;
                                        rdfs:label "ErpJournal"@en .


###  http://www.iec.ch/TC57/CIM#ErpJournalEntry
<http://www.iec.ch/TC57/CIM#ErpJournalEntry> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> ;
                                             rdfs:comment "Details of an individual entry in a journal which is to be posted to a ledger on the posting date." ;
                                             rdfs:label "ErpJournalEntry"@en .


###  http://www.iec.ch/TC57/CIM#ErpLedBudLineItem
<http://www.iec.ch/TC57/CIM#ErpLedBudLineItem> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> ;
                                               rdfs:comment "Individual entry of a given Ledger Budget typically containing information such as amount accounting date accounting period and is associated with the applicable general ledger account." ;
                                               rdfs:label "ErpLedBudLineItem"@en .


###  http://www.iec.ch/TC57/CIM#ErpLedger
<http://www.iec.ch/TC57/CIM#ErpLedger> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpDocument> ;
                                       rdfs:comment "In accounting transactions a ledger is a book containing accounts to which debits and credits are posted from journals where transactions are initially recorded. Journal entries are periodically posted to the ledger. Ledger Actual represents actual amounts by account within ledger within company or business area. Actual amounts may be generated in a source application and then loaded to a specific ledger within the enterprise general ledger or budget application." ;
                                       rdfs:label "ErpLedger"@en .


###  http://www.iec.ch/TC57/CIM#ErpLedgerBudget
<http://www.iec.ch/TC57/CIM#ErpLedgerBudget> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpDocument> ;
                                             rdfs:comment "Information for utility Ledger Budgets. They support the transfer budget amounts between all possible source applications throughout an enterprise and a general ledger or budget application." ;
                                             rdfs:label "ErpLedgerBudget"@en .


###  http://www.iec.ch/TC57/CIM#ErpLedgerEntry
<http://www.iec.ch/TC57/CIM#ErpLedgerEntry> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> ;
                                            rdfs:comment "Details of an individual entry in a ledger which was posted from a journal on the posted date." ;
                                            rdfs:label "ErpLedgerEntry"@en .


###  http://www.iec.ch/TC57/CIM#ErpPOLineItem
<http://www.iec.ch/TC57/CIM#ErpPOLineItem> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpDocument> ;
                                           rdfs:comment "Of an ErpPurchaseOrder this is an individually ordered item or product along with the quantity price and other descriptive information." ;
                                           rdfs:label "ErpPOLineItem"@en .


###  http://www.iec.ch/TC57/CIM#ErpPayable
<http://www.iec.ch/TC57/CIM#ErpPayable> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpDocument> ;
                                        rdfs:comment "A transaction that represents an invoice from a supplier. A payable or voucher is an open item approved and ready for payment in the Accounts Payable ledger." ;
                                        rdfs:label "ErpPayable"@en .


###  http://www.iec.ch/TC57/CIM#ErpPayableLineItem
<http://www.iec.ch/TC57/CIM#ErpPayableLineItem> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> ;
                                                rdfs:comment "Of an ErpPayable a line item references an ErpInvoiceLineitem or other source such as credit memos." ;
                                                rdfs:label "ErpPayableLineItem"@en .


###  http://www.iec.ch/TC57/CIM#ErpPayment
<http://www.iec.ch/TC57/CIM#ErpPayment> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpDocument> ;
                                        rdfs:comment "Payment infromation and status for any individual line item of an ErpInvoice e.g. when payment is from a customer. ErpPayable is also updated when payment is to a supplier and ErpReceivable is updated when payment is from a customer. Multiple payments can be made against a single line item and an individual payment can apply to more that one line item." ;
                                        rdfs:label "ErpPayment"@en .


###  http://www.iec.ch/TC57/CIM#ErpPersonnel
<http://www.iec.ch/TC57/CIM#ErpPersonnel> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> ;
                                          rdfs:comment "Information that applies to the basic data about a utility person used by ERP applications to transfer Personnel data for a worker." ;
                                          rdfs:label "ErpPersonnel"@en .


###  http://www.iec.ch/TC57/CIM#ErpProjectAccounting
<http://www.iec.ch/TC57/CIM#ErpProjectAccounting> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpDocument> ;
                                                  rdfs:comment "Utility Project Accounting information used by ERP applications to enable all relevant subsystems that submit single sided transactions to transfer information with a Project Accounting Application. This would include but not necessarily be limited to Accounts Payable Accounts Receivable Budget Order Management Purchasing Time and Labor Travel and Expense." ;
                                                  rdfs:label "ErpProjectAccounting"@en .


###  http://www.iec.ch/TC57/CIM#ErpPurchaseOrder
<http://www.iec.ch/TC57/CIM#ErpPurchaseOrder> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpDocument> ;
                                              rdfs:comment "A document that communicates an order to purchase goods from a buyer to a supplier. The PurchaseOrder carries information to and from the buyer and supplier. It is a legally binding document once both Parties agree to the contents and the specified terms and conditions of the order." ;
                                              rdfs:label "ErpPurchaseOrder"@en .


###  http://www.iec.ch/TC57/CIM#ErpQuote
<http://www.iec.ch/TC57/CIM#ErpQuote> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpDocument> ;
                                      rdfs:comment "Document describing the prices of goods or services provided by a supplier. It includes the terms of the purchase delivery proposals identification of goods or services ordered as well as their quantities." ;
                                      rdfs:label "ErpQuote"@en .


###  http://www.iec.ch/TC57/CIM#ErpQuoteLineItem
<http://www.iec.ch/TC57/CIM#ErpQuoteLineItem> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> ;
                                              rdfs:comment "Of an ErpQuote the item or product quoted along with quantity price and other descriptive information." ;
                                              rdfs:label "ErpQuoteLineItem"@en .


###  http://www.iec.ch/TC57/CIM#ErpRecDelvLineItem
<http://www.iec.ch/TC57/CIM#ErpRecDelvLineItem> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> ;
                                                rdfs:comment "Of an ErpReceiveDelivery this is an individually received good or service by the Organisation receiving goods or services. It may be used to indicate receipt of goods in conjunction with a purchase order line item." ;
                                                rdfs:label "ErpRecDelvLineItem"@en .


###  http://www.iec.ch/TC57/CIM#ErpRecLineItem
<http://www.iec.ch/TC57/CIM#ErpRecLineItem> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> ;
                                            rdfs:comment "Individual entry of an ErpReceivable it is a particular transaction representing an invoice credit memo or debit memo to a customer." ;
                                            rdfs:label "ErpRecLineItem"@en .


###  http://www.iec.ch/TC57/CIM#ErpReceivable
<http://www.iec.ch/TC57/CIM#ErpReceivable> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpDocument> ;
                                           rdfs:comment "Transaction representing an invoice credit memo or debit memo to a customer. It is an open unpaid item in the Accounts Receivable ledger." ;
                                           rdfs:label "ErpReceivable"@en .


###  http://www.iec.ch/TC57/CIM#ErpReceiveDelivery
<http://www.iec.ch/TC57/CIM#ErpReceiveDelivery> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpDocument> ;
                                                rdfs:comment "Transaction for an Organisation receiving goods or services that may be used to indicate receipt of goods in conjunction with a purchase order. A receivable is an open unpaid item in the Accounts Receivable ledger." ;
                                                rdfs:label "ErpReceiveDelivery"@en .


###  http://www.iec.ch/TC57/CIM#ErpReqLineItem
<http://www.iec.ch/TC57/CIM#ErpReqLineItem> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> ;
                                            rdfs:comment "Information that describes a requested item and its attributes." ;
                                            rdfs:label "ErpReqLineItem"@en .


###  http://www.iec.ch/TC57/CIM#ErpRequisition
<http://www.iec.ch/TC57/CIM#ErpRequisition> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpDocument> ;
                                            rdfs:comment "General information that applies to a utility requisition that is a request for the purchase of goods or services. Typically a requisition leads to the creation of a purchase order to a specific supplier." ;
                                            rdfs:label "ErpRequisition"@en .


###  http://www.iec.ch/TC57/CIM#ErpSiteLevelData
<http://www.iec.ch/TC57/CIM#ErpSiteLevelData> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> ;
                                              rdfs:comment "For a utility general information that describes physical locations of organizations or the location codes and their meanings. This enables ERP applications to ensure that the physical location identifiers are synchronized between the business applications." ;
                                              rdfs:label "ErpSiteLevelData"@en .


###  http://www.iec.ch/TC57/CIM#ErpTimeEntry
<http://www.iec.ch/TC57/CIM#ErpTimeEntry> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpIdentifiedObject> ;
                                          rdfs:comment "An individual entry on an ErpTimeSheet." ;
                                          rdfs:label "ErpTimeEntry"@en .


###  http://www.iec.ch/TC57/CIM#ErpTimeSheet
<http://www.iec.ch/TC57/CIM#ErpTimeSheet> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ErpDocument> ;
                                          rdfs:comment "Time sheet for employees and contractors. Note that ErpTimeSheet inherits the relationship to ErpPerson from Document." ;
                                          rdfs:label "ErpTimeSheet"@en .


###  http://www.iec.ch/TC57/CIM#EstimatedRestorationTime
<http://www.iec.ch/TC57/CIM#EstimatedRestorationTime> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                      rdfs:comment "The Estimated Restoration Time for a single outage" ;
                                                      rdfs:label "EstimatedRestorationTime"@en .


###  http://www.iec.ch/TC57/CIM#ExPostLoss
<http://www.iec.ch/TC57/CIM#ExPostLoss> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#MarketFactors> ;
                                        rdfs:comment "Model of expost calcultion of MW losses.  " ;
                                        rdfs:label "ExPostLoss"@en .


###  http://www.iec.ch/TC57/CIM#ExPostLossResults
<http://www.iec.ch/TC57/CIM#ExPostLossResults> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                               rdfs:comment "Model results of expost calculation of MW losses. Summarizes loss in two categories losses on the the extra high voltage transmission and total losses. Calculated for each subcontrol area." ;
                                               rdfs:label "ExPostLossResults"@en .


###  http://www.iec.ch/TC57/CIM#ExPostMarketRegion
<http://www.iec.ch/TC57/CIM#ExPostMarketRegion> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#MarketFactors> ;
                                                rdfs:comment "Model of expost calculation of cleared MW on a regional basis." ;
                                                rdfs:label "ExPostMarketRegion"@en .


###  http://www.iec.ch/TC57/CIM#ExPostMarketRegionResults
<http://www.iec.ch/TC57/CIM#ExPostMarketRegionResults> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                       rdfs:comment "Model of expost calculation of cleared MW on a region basis.  Includes cleared price." ;
                                                       rdfs:label "ExPostMarketRegionResults"@en .


###  http://www.iec.ch/TC57/CIM#ExPostPricing
<http://www.iec.ch/TC57/CIM#ExPostPricing> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#MarketFactors> ;
                                           rdfs:comment "Model of expost pricing of nodes." ;
                                           rdfs:label "ExPostPricing"@en .


###  http://www.iec.ch/TC57/CIM#ExPostPricingResults
<http://www.iec.ch/TC57/CIM#ExPostPricingResults> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                  rdfs:comment "Model of expost pricing of nodes.  Includes LMP information pnode based." ;
                                                  rdfs:label "ExPostPricingResults"@en .


###  http://www.iec.ch/TC57/CIM#ExPostResource
<http://www.iec.ch/TC57/CIM#ExPostResource> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#MarketFactors> ;
                                            rdfs:comment "Model of expost pricing of resources.  " ;
                                            rdfs:label "ExPostResource"@en .


###  http://www.iec.ch/TC57/CIM#ExPostResourceResults
<http://www.iec.ch/TC57/CIM#ExPostResourceResults> rdf:type owl:Class ;
