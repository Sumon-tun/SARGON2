###  http://www.iec.ch/TC57/CIM#TailbayLossCurve
<http://www.iec.ch/TC57/CIM#TailbayLossCurve> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Curve> ;
                                              rdfs:comment "Relationship between tailbay head loss height Yaxis and the total discharge into the power stations tailbay volume per time unit Xaxis . There could be more than one curve depending on the level of the tailbay reservoir or river level." ;
                                              rdfs:label "TailbayLossCurve"@en .


###  http://www.iec.ch/TC57/CIM#TapChanger
<http://www.iec.ch/TC57/CIM#TapChanger> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemResource> ;
                                        rdfs:comment "Mechanism for changing transformer winding tap positions." ;
                                        rdfs:label "TapChanger"@en .


###  http://www.iec.ch/TC57/CIM#TapChangerControl
<http://www.iec.ch/TC57/CIM#TapChangerControl> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#RegulatingControl> ;
                                               rdfs:comment "Describes behaviour specific to tap changers e.g. how the voltage at the end of a line varies with the load level and compensation of the voltage drop by tap adjustment." ;
                                               rdfs:label "TapChangerControl"@en .


###  http://www.iec.ch/TC57/CIM#TapChangerDynamicData
<http://www.iec.ch/TC57/CIM#TapChangerDynamicData> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                   rdfs:comment "Optimal Power Flow or State Estimator Phase Shifter Data. This is used for RealTime Study and Maintenance Users. SE Solution Phase Shifter Measurements from the last run of SE." ;
                                                   rdfs:label "TapChangerDynamicData"@en .


###  http://www.iec.ch/TC57/CIM#TapChangerInfo
<http://www.iec.ch/TC57/CIM#TapChangerInfo> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#AssetInfo> ;
                                            rdfs:comment "Tap changer data." ;
                                            rdfs:label "TapChangerInfo"@en .


###  http://www.iec.ch/TC57/CIM#TapChangerTablePoint
<http://www.iec.ch/TC57/CIM#TapChangerTablePoint> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                  rdfs:comment "Describes each tap step in the tabular curve." ;
                                                  rdfs:label "TapChangerTablePoint"@en .


###  http://www.iec.ch/TC57/CIM#TapSchedule
<http://www.iec.ch/TC57/CIM#TapSchedule> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#SeasonDayTypeSchedule> ;
                                         rdfs:comment "A preestablished pattern over time for a tap step." ;
                                         rdfs:label "TapSchedule"@en .


###  http://www.iec.ch/TC57/CIM#TapeShieldCableInfo
<http://www.iec.ch/TC57/CIM#TapeShieldCableInfo> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#CableInfo> ;
                                                 rdfs:comment "Tape shield cable data." ;
                                                 rdfs:label "TapeShieldCableInfo"@en .


###  http://www.iec.ch/TC57/CIM#TargetLevelSchedule
<http://www.iec.ch/TC57/CIM#TargetLevelSchedule> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Curve> ;
                                                 rdfs:comment "Reservoir water level targets from advanced studies or rule curves. Typically in one hour increments for up to 10 days." ;
                                                 rdfs:label "TargetLevelSchedule"@en .


###  http://www.iec.ch/TC57/CIM#Tariff
<http://www.iec.ch/TC57/CIM#Tariff> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Document> ;
                                    rdfs:comment "Document approved by the responsible regulatory agency listing the terms and conditions including a schedule of prices under which utility services will be provided. It has a unique number within the state or province. For rate schedules it is frequently allocated by the affiliated Public utilities commission PUC." ;
                                    rdfs:label "Tariff"@en .


###  http://www.iec.ch/TC57/CIM#TariffProfile
<http://www.iec.ch/TC57/CIM#TariffProfile> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Document> ;
                                           rdfs:comment "A schedule of charges structure associated with Tariff that allows the definition of complex tarif structures such as step and time of use when used in conjunction with TimeTariffInterval and Charge. Inherited status.value is defined in the context of the utilitys business rules for example active inactive etc." ;
                                           rdfs:label "TariffProfile"@en .


###  http://www.iec.ch/TC57/CIM#TelephoneNumber
<http://www.iec.ch/TC57/CIM#TelephoneNumber> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Compound> ;
                                             rdfs:comment "Telephone number." ;
                                             rdfs:label "TelephoneNumber"@en .


###  http://www.iec.ch/TC57/CIM#TempEquipActionKind
<http://www.iec.ch/TC57/CIM#TempEquipActionKind> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                 rdfs:comment "Kind of action on temporary equipment such as cut jumper ground energy source." ;
                                                 rdfs:label "TempEquipActionKind"@en .


###  http://www.iec.ch/TC57/CIM#Temperature
<http://www.iec.ch/TC57/CIM#Temperature> rdf:type owl:Class ;
                                         owl:equivalentClass <https://w3id.org/saref#Temperature> ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#CIMDatatype> ;
                                         rdfs:comment "Value of temperature in degrees Celsius." ;
                                         rdfs:label "Temperature"@en .


###  http://www.iec.ch/TC57/CIM#TemperatureDependentLimitPoint
<http://www.iec.ch/TC57/CIM#TemperatureDependentLimitPoint> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                            rdfs:comment "A point on a table of limit verses temperature." ;
                                                            rdfs:label "TemperatureDependentLimitPoint"@en .


###  http://www.iec.ch/TC57/CIM#TemperatureDependentLimitTable
<http://www.iec.ch/TC57/CIM#TemperatureDependentLimitTable> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#EnvironmentalDependentLimit> ;
                                                            rdfs:comment "This is a table lookup that provides limit values corresponding to a temperature input." ;
                                                            rdfs:label "TemperatureDependentLimitTable"@en .


###  http://www.iec.ch/TC57/CIM#TemperaturePolynomialLimit
<http://www.iec.ch/TC57/CIM#TemperaturePolynomialLimit> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#EnvironmentalDependentLimit> ;
                                                        rdfs:comment "This describes the coefficients of a polynomial function that has temperature as input and calculates limit values as output." ;
                                                        rdfs:label "TemperaturePolynomialLimit"@en .


###  http://www.iec.ch/TC57/CIM#TenMinAuxiliaryData
<http://www.iec.ch/TC57/CIM#TenMinAuxiliaryData> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                 rdfs:comment "Models 10Minutes Auxiliary Data." ;
                                                 rdfs:label "TenMinAuxiliaryData"@en .


###  http://www.iec.ch/TC57/CIM#Tender
<http://www.iec.ch/TC57/CIM#Tender> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                    rdfs:comment "Tender is what is offered by the customer towards making a payment and is often more than the required payment hence the need for change. The payment is thus that part of the Tender that goes towards settlement of a particular transaction.Tender is modelled as an aggregation of Cheque and Card. Both these tender types can exist in a single tender bid thus accountHolderName has to exist separately in each of Cheque and Card as each could have a different account holder name." ;
                                    rdfs:label "Tender"@en .


###  http://www.iec.ch/TC57/CIM#TenderKind
<http://www.iec.ch/TC57/CIM#TenderKind> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                        rdfs:comment "Kind of tender." ;
                                        rdfs:label "TenderKind"@en .


###  http://www.iec.ch/TC57/CIM#Terminal
<http://www.iec.ch/TC57/CIM#Terminal> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ACDCTerminal> ;
                                      rdfs:comment "An AC electrical connection point to a piece of conducting equipment. Terminals are connected at physical connection points called connectivity nodes." ;
                                      rdfs:label "Terminal"@en .


###  http://www.iec.ch/TC57/CIM#TerminalConstraintTerm
<http://www.iec.ch/TC57/CIM#TerminalConstraintTerm> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ConstraintTerm> ;
                                                    rdfs:comment "A constraint term associated with a specific terminal on a physical piece of equipment." ;
                                                    rdfs:label "TerminalConstraintTerm"@en .


###  http://www.iec.ch/TC57/CIM#TestDataSet
<http://www.iec.ch/TC57/CIM#TestDataSet> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ProcedureDataSet> ;
                                         rdfs:comment "Test results usually obtained by a lab or other independent organisation." ;
                                         rdfs:label "TestDataSet"@en .


###  http://www.iec.ch/TC57/CIM#TestKind
<http://www.iec.ch/TC57/CIM#TestKind> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                      rdfs:comment "The test applied to determine if the condition is met." ;
                                      rdfs:label "TestKind"@en .


###  http://www.iec.ch/TC57/CIM#TestMethod
<http://www.iec.ch/TC57/CIM#TestMethod> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                        rdfs:comment "Possible test methods." ;
                                        rdfs:label "TestMethod"@en .


###  http://www.iec.ch/TC57/CIM#TestReason
<http://www.iec.ch/TC57/CIM#TestReason> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                        rdfs:comment "Reason for test." ;
                                        rdfs:label "TestReason"@en .


###  http://www.iec.ch/TC57/CIM#TestStandard
<http://www.iec.ch/TC57/CIM#TestStandard> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                          rdfs:comment "The precise standard used in executing a lab test including the standard and standard version test method and variant if needed." ;
                                          rdfs:label "TestStandard"@en .


###  http://www.iec.ch/TC57/CIM#TestVariantKind
<http://www.iec.ch/TC57/CIM#TestVariantKind> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                             rdfs:comment "Test variants." ;
                                             rdfs:label "TestVariantKind"@en .


