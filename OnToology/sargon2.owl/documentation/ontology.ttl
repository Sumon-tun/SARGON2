###  http://www.iec.ch/TC57/CIM#TapChangerTablePoint.b
<http://www.iec.ch/TC57/CIM#TapChangerTablePoint.b> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <http://www.iec.ch/TC57/CIM#TapChangerTablePoint> ;
