                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                   rdfs:comment "Market power mitigation test identifier type for example1  Global Price Test2  Global Conduct Test3  Global Impact Test4  Local Price Test5  Local Conduct Test6  Local Impact Test" ;
                                                   rdfs:label "MPMTestIdentifierType"@en .


