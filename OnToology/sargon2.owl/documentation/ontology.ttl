###  http://www.iec.ch/TC57/CIM#ASTMStandardKind.D924
<http://www.iec.ch/TC57/CIM#ASTMStandardKind.D924> rdf:type owl:NamedIndividual ,
                                                            <http://www.iec.ch/TC57/CIM#ASTMStandardKind> ;
                                                   rdfs:comment "Standard Test Method for Dissipation Factor or Power Factor and Relative Permittivity Dielectric Constant of Electrical Insulating Liquids." ;
                                                   rdfs:label "D924"@en .


###  http://www.iec.ch/TC57/CIM#ASTMStandardKind.D93
<http://www.iec.ch/TC57/CIM#ASTMStandardKind.D93> rdf:type owl:NamedIndividual ,
                                                           <http://www.iec.ch/TC57/CIM#ASTMStandardKind> ;
                                                  rdfs:comment "Standard Test Methods for Flash Point by PenskyMartens Closed Cup Tester  orStandard Test Method for Flash Point by PenskyMartens Closed Tester  orStandard Method Of Test For Flash Point by PenskyMartens Closed Tester." ;
                                                  rdfs:label "D93"@en .


###  http://www.iec.ch/TC57/CIM#ASTMStandardKind.D97
<http://www.iec.ch/TC57/CIM#ASTMStandardKind.D97> rdf:type owl:NamedIndividual ,
                                                           <http://www.iec.ch/TC57/CIM#ASTMStandardKind> ;
                                                  rdfs:comment "Standard Test Method for Pour Point of Petroleum Products  orStandard Test Method for Pour Point of Petroleum Oils." ;
                                                  rdfs:label "D97"@en .


###  http://www.iec.ch/TC57/CIM#ASTMStandardKind.D974
<http://www.iec.ch/TC57/CIM#ASTMStandardKind.D974> rdf:type owl:NamedIndividual ,
                                                            <http://www.iec.ch/TC57/CIM#ASTMStandardKind> ;
