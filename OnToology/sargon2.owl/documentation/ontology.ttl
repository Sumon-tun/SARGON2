                                           rdfs:comment "The formal specification of specific characteristics related to a bid." ;
                                           rdfs:label "BidTimeSeries"@en .


###  http://www.iec.ch/TC57/CIM#BidType
<http://www.iec.ch/TC57/CIM#BidType> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                     rdfs:comment "For exampleDEFAULTENERGYBIDDEFAULTSTARTUPBIDDEFAULTMINIMUMLOADBID" ;
                                     rdfs:label "BidType"@en .


