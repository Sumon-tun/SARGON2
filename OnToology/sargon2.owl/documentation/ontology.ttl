                                                              rdfs:range <http://www.iec.ch/TC57/CIM#Money> ;
                                                              rdfs:comment "Cumulative amount in error due to process rounding not reflected in receiptsGrandTotal. Values are obtained from Receipt attributessumReceipt.receiptRounding." ;
                                                              rdfs:label "receiptsGrandTotalRounding"@en .


###  http://www.iec.ch/TC57/CIM#Shift.transactionsGrandTotal
<http://www.iec.ch/TC57/CIM#Shift.transactionsGrandTotal> rdf:type owl:ObjectProperty ;
