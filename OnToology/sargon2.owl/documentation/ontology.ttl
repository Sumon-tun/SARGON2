<http://www.iec.ch/TC57/CIM#GroundAction> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#SwitchingAction> ;
                                          rdfs:comment "Action on ground as a switching step." ;
                                          rdfs:label "GroundAction"@en .


