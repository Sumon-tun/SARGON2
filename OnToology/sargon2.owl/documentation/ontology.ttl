<http://www.iec.ch/TC57/CIM#TroubleTicket> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Document> ;
                                           rdfs:label "TroubleTicket"@en .


