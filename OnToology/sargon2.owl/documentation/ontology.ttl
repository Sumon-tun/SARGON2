                                                         rdfs:domain <http://www.iec.ch/TC57/CIM#SurgeArresterInfo> ;
                                                         rdfs:range xsd:boolean ;
                                                         rdfs:comment "If true the arrester has a polymer housing porcelain otherwise." ;
                                                         rdfs:label "isPolymer"@en .


###  http://www.iec.ch/TC57/CIM#SurgeArresterInfo.lineDischargeClass
<http://www.iec.ch/TC57/CIM#SurgeArresterInfo.lineDischargeClass> rdf:type owl:DatatypeProperty ;
                                                                  rdfs:domain <http://www.iec.ch/TC57/CIM#SurgeArresterInfo> ;
                                                                  rdfs:range xsd:integer ;
                                                                  rdfs:comment "Determines the arrester energy discharge capability.  Choices are limited to 0 none through 5 highest by IEC 60099. Classes 1..3 require a 10kA nominal discharge current. Classes 4..5 require a 20kA nominal discharge current. Lower nominal discharge currents must use class 0." ;
                                                                  rdfs:label "lineDischargeClass"@en .


###  http://www.iec.ch/TC57/CIM#SvShuntCompensatorSections.sections
