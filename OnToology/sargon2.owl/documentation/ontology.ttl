###  http://www.iec.ch/TC57/CIM#Shift.receiptsGrandTotalBankable
<http://www.iec.ch/TC57/CIM#Shift.receiptsGrandTotalBankable> rdf:type owl:ObjectProperty ;
                                                              rdfs:domain <http://www.iec.ch/TC57/CIM#Shift> ;
                                                              rdfs:range <http://www.iec.ch/TC57/CIM#Money> ;
                                                              rdfs:comment "Total of amounts receipted during this shift that can be manually banked cash and cheques for example. Values are obtained from Receipt attributessumReceipt.receiptAmount for all Receipt.bankable  true." ;
                                                              rdfs:label "receiptsGrandTotalBankable"@en .


###  http://www.iec.ch/TC57/CIM#Shift.receiptsGrandTotalNonBankable
<http://www.iec.ch/TC57/CIM#Shift.receiptsGrandTotalNonBankable> rdf:type owl:ObjectProperty ;
                                                                 rdfs:domain <http://www.iec.ch/TC57/CIM#Shift> ;
                                                                 rdfs:range <http://www.iec.ch/TC57/CIM#Money> ;
                                                                 rdfs:comment "Total of amounts receipted during this shift that cannot be manually banked card payments for example. Values are obtained from Receipt attributessumReceipt.receiptAmount for all Receipt.bankable  false." ;
                                                                 rdfs:label "receiptsGrandTotalNonBankable"@en .


###  http://www.iec.ch/TC57/CIM#Shift.receiptsGrandTotalRounding
<http://www.iec.ch/TC57/CIM#Shift.receiptsGrandTotalRounding> rdf:type owl:ObjectProperty ;
