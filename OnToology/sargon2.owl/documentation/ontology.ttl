                                                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Compound> ;
                                                                    rdfs:comment "Represent the base lifecycle of a functional model change that could be a construction of new elements." ;
                                                                    rdfs:label "PowerSystemProjectLifecycleToBeDeleted"@en .


###  http://www.iec.ch/TC57/CIM#PowerSystemResource
<http://www.iec.ch/TC57/CIM#PowerSystemResource> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
