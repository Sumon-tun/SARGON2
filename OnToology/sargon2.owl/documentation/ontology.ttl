<http://www.iec.ch/TC57/CIM#MarketProductType.NR> rdf:type owl:NamedIndividual ,
                                                           <http://www.iec.ch/TC57/CIM#MarketProductType> ;
                                                  rdfs:comment "non spinning reserve" ;
                                                  rdfs:label "NR"@en .


