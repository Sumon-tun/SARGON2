<http://www.iec.ch/TC57/CIM#EPAStandard> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Compound> ;
                                         rdfs:comment "Standard published by EPA United States Environmental Protection Agency." ;
                                         rdfs:label "EPAStandard"@en .


