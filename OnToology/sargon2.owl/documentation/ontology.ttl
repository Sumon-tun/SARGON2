<http://www.iec.ch/TC57/CIM#MarketProductType.RD> rdf:type owl:NamedIndividual ,
                                                           <http://www.iec.ch/TC57/CIM#MarketProductType> ;
                                                  rdfs:comment "regulation down" ;
                                                  rdfs:label "RD"@en .


###  http://www.iec.ch/TC57/CIM#MarketProductType.REG
<http://www.iec.ch/TC57/CIM#MarketProductType.REG> rdf:type owl:NamedIndividual ,
                                                            <http://www.iec.ch/TC57/CIM#MarketProductType> ;
                                                   rdfs:comment "Regulation" ;
                                                   rdfs:label "REG"@en .


###  http://www.iec.ch/TC57/CIM#MarketProductType.RU
<http://www.iec.ch/TC57/CIM#MarketProductType.RU> rdf:type owl:NamedIndividual ,
                                                           <http://www.iec.ch/TC57/CIM#MarketProductType> ;
                                                  rdfs:comment "regulation up" ;
                                                  rdfs:label "RU"@en .


###  http://www.iec.ch/TC57/CIM#MarketProductType.SR
<http://www.iec.ch/TC57/CIM#MarketProductType.SR> rdf:type owl:NamedIndividual ,
                                                           <http://www.iec.ch/TC57/CIM#MarketProductType> ;
                                                  rdfs:comment "spinning reserve" ;
                                                  rdfs:label "SR"@en .


###  http://www.iec.ch/TC57/CIM#MarketProductTypeAsReq.AS
<http://www.iec.ch/TC57/CIM#MarketProductTypeAsReq.AS> rdf:type owl:NamedIndividual ,
                                                                <http://www.iec.ch/TC57/CIM#MarketProductTypeAsReq> ;
                                                       rdfs:label "AS"@en .


###  http://www.iec.ch/TC57/CIM#MarketProductTypeAsReq.NR
<http://www.iec.ch/TC57/CIM#MarketProductTypeAsReq.NR> rdf:type owl:NamedIndividual ,
                                                                <http://www.iec.ch/TC57/CIM#MarketProductTypeAsReq> ;
                                                       rdfs:comment "non spinning reserve" ;
                                                       rdfs:label "NR"@en .


###  http://www.iec.ch/TC57/CIM#MarketProductTypeAsReq.RD
<http://www.iec.ch/TC57/CIM#MarketProductTypeAsReq.RD> rdf:type owl:NamedIndividual ,
