                                                          rdfs:label "RUCAward"@en .


###  http://www.iec.ch/TC57/CIM#RUCAwardInstruction.RUCCapacity
<http://www.iec.ch/TC57/CIM#RUCAwardInstruction.RUCCapacity> rdf:type owl:DatatypeProperty ;
                                                             rdfs:domain <http://www.iec.ch/TC57/CIM#RUCAwardInstruction> ;
                                                             rdfs:range xsd:float ;
                                                             rdfs:comment "The RUC Capacity of a resource is the difference between i the RUC Schedule and ii the higher of the DA Schedule and the Minimum Load." ;
                                                             rdfs:label "RUCCapacity"@en .


###  http://www.iec.ch/TC57/CIM#RUCAwardInstruction.RUCSchedule
<http://www.iec.ch/TC57/CIM#RUCAwardInstruction.RUCSchedule> rdf:type owl:DatatypeProperty ;
                                                             rdfs:domain <http://www.iec.ch/TC57/CIM#RUCAwardInstruction> ;
