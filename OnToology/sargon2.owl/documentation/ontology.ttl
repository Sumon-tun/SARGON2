<http://www.iec.ch/TC57/CIM#DocumentPersonRole> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PersonRole> ;
                                                rdfs:comment "Person role with respect to documents." ;
                                                rdfs:label "DocumentPersonRole"@en .


