                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                             rdfs:comment "Demographic kind of a land property." ;
                                             rdfs:label "DemographicKind"@en .


###  http://www.iec.ch/TC57/CIM#DependencyKind
<http://www.iec.ch/TC57/CIM#DependencyKind> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                            rdfs:label "DependencyKind"@en .


###  http://www.iec.ch/TC57/CIM#DeploymentDate
<http://www.iec.ch/TC57/CIM#DeploymentDate> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Compound> ;
                                            rdfs:comment "Dates for deployment events of an asset.  May have multiple deployment type dates for this device and a compound type allows a query to return multiple dates." ;
                                            rdfs:label "DeploymentDate"@en .


###  http://www.iec.ch/TC57/CIM#DeploymentStateKind
<http://www.iec.ch/TC57/CIM#DeploymentStateKind> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                 rdfs:comment "Possible states of asset deployment." ;
                                                 rdfs:label "DeploymentStateKind"@en .


###  http://www.iec.ch/TC57/CIM#Deprecated
<http://www.iec.ch/TC57/CIM#Deprecated> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Datatype> .


###  http://www.iec.ch/TC57/CIM#Design
<http://www.iec.ch/TC57/CIM#Design> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#WorkDocument> ;
                                    rdfs:comment "A design for consideration by customers potential customers or internal work.Note that the Version of design is the revision attribute that is inherited from Document." ;
                                    rdfs:label "Design"@en .


###  http://www.iec.ch/TC57/CIM#DesignKind
<http://www.iec.ch/TC57/CIM#DesignKind> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                        rdfs:comment "Kind of design." ;
                                        rdfs:label "DesignKind"@en .


###  http://www.iec.ch/TC57/CIM#DesignLocation
<http://www.iec.ch/TC57/CIM#DesignLocation> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#WorkIdentifiedObject> ;
                                            rdfs:comment "A logical part of the design e.g. pole and all equipment on a pole. This includes points and spans." ;
                                            rdfs:label "DesignLocation"@en .


###  http://www.iec.ch/TC57/CIM#DesignLocationCU
<http://www.iec.ch/TC57/CIM#DesignLocationCU> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#WorkIdentifiedObject> ;
                                              rdfs:comment "Compatible unit at a given design location." ;
                                              rdfs:label "DesignLocationCU"@en .


###  http://www.iec.ch/TC57/CIM#DiagnosisDataSet
<http://www.iec.ch/TC57/CIM#DiagnosisDataSet> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ProcedureDataSet> ;
                                              rdfs:comment "The result of a problem typically an asset failure diagnosis. Contains complete information like what might be received from a lab doing forensic analysis of a failed asset. " ;
                                              rdfs:label "DiagnosisDataSet"@en .


###  http://www.iec.ch/TC57/CIM#Diagram
<http://www.iec.ch/TC57/CIM#Diagram> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                     rdfs:comment "The diagram being exchanged. The coordinate system is a standard Cartesian coordinate system and the orientation attribute defines the orientation. The initial view related attributes can be used to specify an initial view with the xy coordinates of the diagonal points." ;
                                     rdfs:label "Diagram"@en .


###  http://www.iec.ch/TC57/CIM#DiagramObject
<http://www.iec.ch/TC57/CIM#DiagramObject> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                           rdfs:comment "An object that defines one or more points in a given space. This object can be associated with anything that specializes IdentifiedObject. For single line diagrams such objects typically include such items as analog values breakers disconnectors power transformers and transmission lines." ;
                                           rdfs:label "DiagramObject"@en .


###  http://www.iec.ch/TC57/CIM#DiagramObjectGluePoint
<http://www.iec.ch/TC57/CIM#DiagramObjectGluePoint> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                    rdfs:comment "This is used for grouping diagram object points from different diagram objects that are considered to be glued together in a diagram even if they are not at the exact same coordinates." ;
                                                    rdfs:label "DiagramObjectGluePoint"@en .


###  http://www.iec.ch/TC57/CIM#DiagramObjectPoint
<http://www.iec.ch/TC57/CIM#DiagramObjectPoint> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                rdfs:comment "A point in a given space defined by 3 coordinates and associated to a diagram object.  The coordinates may be positive or negative as the origin does not have to be in the corner of a diagram.  " ;
                                                rdfs:label "DiagramObjectPoint"@en .


###  http://www.iec.ch/TC57/CIM#DiagramObjectStyle
<http://www.iec.ch/TC57/CIM#DiagramObjectStyle> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                rdfs:comment "A reference to a style used by the originating system for a diagram object.  A diagram object style describes information such as line thickness shape such as circle or rectangle etc and colour." ;
                                                rdfs:label "DiagramObjectStyle"@en .


###  http://www.iec.ch/TC57/CIM#DiagramStyle
<http://www.iec.ch/TC57/CIM#DiagramStyle> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                          rdfs:comment "The diagram style refers to a style used by the originating system for a diagram.  A diagram style describes information such as schematic geographic etc." ;
                                          rdfs:label "DiagramStyle"@en .


###  http://www.iec.ch/TC57/CIM#DifferentialModel
<http://www.iec.ch/TC57/CIM#DifferentialModel> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                               rdfs:comment "A set of statements describing the changes in the network model. The statement is defined in the incremental model. " ;
                                               rdfs:label "DifferentialModel"@en .


###  http://www.iec.ch/TC57/CIM#DimensionsInfo
<http://www.iec.ch/TC57/CIM#DimensionsInfo> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                            rdfs:comment "As applicable the basic linear area or volume dimensions of an asset asset type AssetModel or other type of object such as land area. Units and multipliers are specified per dimension." ;
                                            rdfs:label "DimensionsInfo"@en .


###  http://www.iec.ch/TC57/CIM#DiscExcContIEEEDEC1A
<http://www.iec.ch/TC57/CIM#DiscExcContIEEEDEC1A> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#DiscontinuousExcitationControlDynamics> ;
                                                  rdfs:comment "IEEE type DEC1A discontinuous excitation control model that boosts generator excitation to a level higher than that demanded by the voltage regulator and stabilizer immediately following a system fault.Reference IEEE 421.52005 12.2. " ;
                                                  rdfs:label "DiscExcContIEEEDEC1A"@en .


###  http://www.iec.ch/TC57/CIM#DiscExcContIEEEDEC2A
<http://www.iec.ch/TC57/CIM#DiscExcContIEEEDEC2A> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#DiscontinuousExcitationControlDynamics> ;
                                                  rdfs:comment "IEEE type DEC2A model for discontinuous excitation control. This system provides transient excitation boosting via an openloop control as initiated by a trigger signal generated remotely.Reference IEEE 421.52005 12.3. " ;
                                                  rdfs:label "DiscExcContIEEEDEC2A"@en .


###  http://www.iec.ch/TC57/CIM#DiscExcContIEEEDEC3A
<http://www.iec.ch/TC57/CIM#DiscExcContIEEEDEC3A> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#DiscontinuousExcitationControlDynamics> ;
                                                  rdfs:comment "IEEE type DEC3A model. In some systems the stabilizer output is disconnected from the regulator immediately following a severe fault to prevent the stabilizer from competing with action of voltage regulator during the first swing.Reference IEEE 421.52005 12.4. " ;
                                                  rdfs:label "DiscExcContIEEEDEC3A"@en .


###  http://www.iec.ch/TC57/CIM#DisconnectingCircuitBreaker
<http://www.iec.ch/TC57/CIM#DisconnectingCircuitBreaker> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Breaker> ;
                                                         rdfs:comment "A circuit breaking device including disconnecting function eliminating the need for separate disconnectors." ;
                                                         rdfs:label "DisconnectingCircuitBreaker"@en .


###  http://www.iec.ch/TC57/CIM#Disconnector
<http://www.iec.ch/TC57/CIM#Disconnector> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Switch> ;
                                          rdfs:comment "A manually operated or motor operated mechanical switching device used for changing the connections in a circuit or for isolating a circuit or equipment from a source of power. It is required to open or close circuits when negligible current is broken or made. " ;
                                          rdfs:label "Disconnector"@en .


###  http://www.iec.ch/TC57/CIM#DiscontinuousExcitationControlDynamics
<http://www.iec.ch/TC57/CIM#DiscontinuousExcitationControlDynamics> rdf:type owl:Class ;
                                                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#DynamicsFunctionBlock> ;
                                                                    rdfs:comment "Discontinuous excitation control function block whose behaviour is described by reference to a standard model font color0f0f0for by definition of a userdefined modelfont." ;
                                                                    rdfs:label "DiscontinuousExcitationControlDynamics"@en .


###  http://www.iec.ch/TC57/CIM#DiscontinuousExcitationControlUserDefined
<http://www.iec.ch/TC57/CIM#DiscontinuousExcitationControlUserDefined> rdf:type owl:Class ;
                                                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#DiscontinuousExcitationControlDynamics> ;
                                                                       rdfs:comment "Discontinuous excitation control function block whose dynamic behaviour is described by font color0f0f0fa userdefined model.font" ;
                                                                       rdfs:label "DiscontinuousExcitationControlUserDefined"@en .


###  http://www.iec.ch/TC57/CIM#Discrete
<http://www.iec.ch/TC57/CIM#Discrete> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Measurement> ;
                                      rdfs:comment "Discrete represents a discrete Measurement i.e. a Measurement representing discrete values e.g. a Breaker position." ;
                                      rdfs:label "Discrete"@en .


