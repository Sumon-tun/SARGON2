<http://www.iec.ch/TC57/CIM#ResourceCertificationKind> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                       rdfs:comment "Types used for resource certification." ;
                                                       rdfs:label "ResourceCertificationKind"@en .


###  http://www.iec.ch/TC57/CIM#ResourceCertificationType
<http://www.iec.ch/TC57/CIM#ResourceCertificationType> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                       rdfs:label "ResourceCertificationType"@en .


###  http://www.iec.ch/TC57/CIM#ResourceClearing
<http://www.iec.ch/TC57/CIM#ResourceClearing> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#MarketFactors> ;
                                              rdfs:comment "Model of market results including cleaing result of resources. Associated with ResourceDispatchResults." ;
                                              rdfs:label "ResourceClearing"@en .


###  http://www.iec.ch/TC57/CIM#ResourceDeploymentStatus
<http://www.iec.ch/TC57/CIM#ResourceDeploymentStatus> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                      rdfs:label "ResourceDeploymentStatus"@en .


###  http://www.iec.ch/TC57/CIM#ResourceDispatchResults
<http://www.iec.ch/TC57/CIM#ResourceDispatchResults> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                     rdfs:comment "The ResourceDispatchResults class provides market results that can be provided to a SC. The specific data provided consists of several indicators such as contingency flags blocked start up and RMR dispatch. It also provides the projected overall and the regulating status of the resource." ;
                                                     rdfs:label "ResourceDispatchResults"@en .


###  http://www.iec.ch/TC57/CIM#ResourceGroup
<http://www.iec.ch/TC57/CIM#ResourceGroup> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                           rdfs:comment "A logical grouping of resources that are used to model location of types of requirements for ancillary services such as spinning reserve zones regulation zones etc.  " ;
                                           rdfs:label "ResourceGroup"@en .


###  http://www.iec.ch/TC57/CIM#ResourceGroupReq
<http://www.iec.ch/TC57/CIM#ResourceGroupReq> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                              rdfs:comment "Ancillary service requirements for a market." ;
                                              rdfs:label "ResourceGroupReq"@en .


###  http://www.iec.ch/TC57/CIM#ResourceLimitIndicator
<http://www.iec.ch/TC57/CIM#ResourceLimitIndicator> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                    rdfs:comment "Locational AS Flags indicating whether the Upper or Lower Bound limit of the AS regional procurement is binding." ;
                                                    rdfs:label "ResourceLimitIndicator"@en .


###  http://www.iec.ch/TC57/CIM#ResourceLoadFollowingInst
<http://www.iec.ch/TC57/CIM#ResourceLoadFollowingInst> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                       rdfs:comment "Model of market clearing results for resources that bid to follow load." ;
                                                       rdfs:label "ResourceLoadFollowingInst"@en .


###  http://www.iec.ch/TC57/CIM#ResourceOperationMaintenanceCost
<http://www.iec.ch/TC57/CIM#ResourceOperationMaintenanceCost> rdf:type owl:Class ;
                                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Curve> ;
                                                              rdfs:comment "To model the Operation and Maintenance O and M costs of a generation resource." ;
                                                              rdfs:label "ResourceOperationMaintenanceCost"@en .


###  http://www.iec.ch/TC57/CIM#ResourcePerformanceEvaluation
<http://www.iec.ch/TC57/CIM#ResourcePerformanceEvaluation> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                           rdfs:comment "Represents an the performance evaluation of a resource deployment. Every resource deployment may have many performance evaluations using different evaluation metrics or algorithms or produced by different evaluation authorities." ;
                                                           rdfs:label "ResourcePerformanceEvaluation"@en .


###  http://www.iec.ch/TC57/CIM#ResourcePerformanceGlobalFactor
<http://www.iec.ch/TC57/CIM#ResourcePerformanceGlobalFactor> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                             rdfs:comment "Global factors are propertyvalue pairs that are used to adjust resource performance values. Example include scale factors e.g. scale a baseline up or down adders positive or negative etc." ;
                                                             rdfs:label "ResourcePerformanceGlobalFactor"@en .


###  http://www.iec.ch/TC57/CIM#ResourcePerformanceRating
<http://www.iec.ch/TC57/CIM#ResourcePerformanceRating> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                       rdfs:comment "Rating of a resource for its demand response performance. e.g. given a set on monthly resource demand response performance evaluations the resource may be rated with excellent average or poor performance for the sample set." ;
                                                       rdfs:label "ResourcePerformanceRating"@en .


###  http://www.iec.ch/TC57/CIM#ResourcePerformanceTimeSeriesFactor
<http://www.iec.ch/TC57/CIM#ResourcePerformanceTimeSeriesFactor> rdf:type owl:Class ;
                                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#RegularIntervalSchedule> ;
                                                                 rdfs:comment "Represents the performance of a resource as time series data for a specified time period time interval and evaluation criteria." ;
                                                                 rdfs:label "ResourcePerformanceTimeSeriesFactor"@en .


###  http://www.iec.ch/TC57/CIM#ResourceRegistrationStatus
<http://www.iec.ch/TC57/CIM#ResourceRegistrationStatus> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                        rdfs:comment "Types of resource registration status for exampleActiveMothballedPlannedDecommissioned" ;
                                                        rdfs:label "ResourceRegistrationStatus"@en .


###  http://www.iec.ch/TC57/CIM#ResourceStartupCost
<http://www.iec.ch/TC57/CIM#ResourceStartupCost> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                 rdfs:comment "To model the startup costs of a generation resource." ;
                                                 rdfs:label "ResourceStartupCost"@en .


###  http://www.iec.ch/TC57/CIM#ResourceVerifiableCosts
<http://www.iec.ch/TC57/CIM#ResourceVerifiableCosts> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                     rdfs:comment "This class is defined to describe the verifiable costs associated with a generation resource." ;
                                                     rdfs:label "ResourceVerifiableCosts"@en .


###  http://www.iec.ch/TC57/CIM#ResponseMethod
<http://www.iec.ch/TC57/CIM#ResponseMethod> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                            rdfs:comment "Specifies a category of energy usage that the demand response applies for e.g. energy from lighting HVAC other." ;
                                            rdfs:label "ResponseMethod"@en .


###  http://www.iec.ch/TC57/CIM#ResultsConstraintType
<http://www.iec.ch/TC57/CIM#ResultsConstraintType> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                   rdfs:comment "Market results binding constraint types." ;
                                                   rdfs:label "ResultsConstraintType"@en .


###  http://www.iec.ch/TC57/CIM#RetiredReasonKind
<http://www.iec.ch/TC57/CIM#RetiredReasonKind> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                               rdfs:comment "Reason asset retired." ;
                                               rdfs:label "RetiredReasonKind"@en .


###  http://www.iec.ch/TC57/CIM#RevenueKind
<http://www.iec.ch/TC57/CIM#RevenueKind> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                         rdfs:comment "Accounting classification of the type of revenue collected for the customer agreement typically used to break down accounts for revenue accounting." ;
                                         rdfs:label "RevenueKind"@en .


###  http://www.iec.ch/TC57/CIM#RightOfWay
<http://www.iec.ch/TC57/CIM#RightOfWay> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Agreement> ;
                                        rdfs:comment " A rightofway ROW is for land where it is lawful to use for a public road an electric power line etc. Note that the association to Location Asset Organisation etc. for the Grant is inherited from Agreement a type of Document." ;
                                        rdfs:label "RightOfWay"@en .


###  http://www.iec.ch/TC57/CIM#RiskScore
<http://www.iec.ch/TC57/CIM#RiskScore> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#AggregateScore> ;
                                       rdfs:comment "Score that is indicative of the risk associated with one or more assets." ;
                                       rdfs:label "RiskScore"@en .


###  http://www.iec.ch/TC57/CIM#RiskScoreKind
<http://www.iec.ch/TC57/CIM#RiskScoreKind> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                           rdfs:comment "Types of risk scores." ;
                                           rdfs:label "RiskScoreKind"@en .


