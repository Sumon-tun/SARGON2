<http://www.iec.ch/TC57/CIM#SwitchingStepGroup.isFreeSequence> rdf:type owl:DatatypeProperty ;
                                                               rdfs:domain <http://www.iec.ch/TC57/CIM#SwitchingStepGroup> ;
                                                               rdfs:range xsd:boolean ;
                                                               rdfs:comment "If true the sequence number serves for presentation purposes only and the activity itself may be executed at any time." ;
                                                               rdfs:label "isFreeSequence"@en .


