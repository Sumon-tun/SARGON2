                                                            <http://www.iec.ch/TC57/CIM#MacroPeriodKind> ;
                                                   rdfs:comment "Daily period starting at midnight. If for the current day this specifies the time from midnight to now." ;
                                                   rdfs:label "daily"@en .


###  http://www.iec.ch/TC57/CIM#MacroPeriodKind.monthly
<http://www.iec.ch/TC57/CIM#MacroPeriodKind.monthly> rdf:type owl:NamedIndividual ,
                                                              <http://www.iec.ch/TC57/CIM#MacroPeriodKind> ;
                                                     rdfs:comment "Monthly period starting at midnight on the first day of the month. If within the current month this specifies the period from the start of the month until now." ;
                                                     rdfs:label "monthly"@en .


