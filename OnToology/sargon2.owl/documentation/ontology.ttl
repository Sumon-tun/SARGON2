                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                      rdfs:comment "This class represent the error information for a bid that is detected during bid validation." ;
                                      rdfs:label "BidError"@en .


###  http://www.iec.ch/TC57/CIM#BidHourlyProductSchedule
<http://www.iec.ch/TC57/CIM#BidHourlyProductSchedule> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#RegularIntervalSchedule> ;
                                                      rdfs:comment "Containment for bid parameters that are dependent on a market product type." ;
                                                      rdfs:label "BidHourlyProductSchedule"@en .


