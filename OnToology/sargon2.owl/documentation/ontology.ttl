###  http://www.iec.ch/TC57/CIM#Pss1
<http://www.iec.ch/TC57/CIM#Pss1> rdf:type owl:Class ;
                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemStabilizerDynamics> ;
                                  rdfs:comment "Italian PSS with three inputs speed frequency power." ;
                                  rdfs:label "Pss1"@en .


###  http://www.iec.ch/TC57/CIM#Pss1A
<http://www.iec.ch/TC57/CIM#Pss1A> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemStabilizerDynamics> ;
                                   rdfs:comment "Single input power system stabilizer. It is a modified version in order to allow representation of various vendors implementations on PSS type 1A." ;
                                   rdfs:label "Pss1A"@en .


###  http://www.iec.ch/TC57/CIM#Pss2B
<http://www.iec.ch/TC57/CIM#Pss2B> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemStabilizerDynamics> ;
                                   rdfs:comment "Modified IEEE PSS2B.  Extra leadlag or rate block added at end up to 4 leadlags total." ;
                                   rdfs:label "Pss2B"@en .


###  http://www.iec.ch/TC57/CIM#Pss2ST
<http://www.iec.ch/TC57/CIM#Pss2ST> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemStabilizerDynamics> ;
                                    rdfs:comment "PTI microprocessorbased stabilizer type 1." ;
                                    rdfs:label "Pss2ST"@en .


###  http://www.iec.ch/TC57/CIM#Pss5
<http://www.iec.ch/TC57/CIM#Pss5> rdf:type owl:Class ;
                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemStabilizerDynamics> ;
                                  rdfs:comment "Detailed Italian PSS." ;
                                  rdfs:label "Pss5"@en .


###  http://www.iec.ch/TC57/CIM#PssELIN2
<http://www.iec.ch/TC57/CIM#PssELIN2> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemStabilizerDynamics> ;
                                      rdfs:comment "Power system stabilizer typically associated with ExcELIN2 though PssIEEE2B or Pss2B can also be used." ;
                                      rdfs:label "PssELIN2"@en .


###  http://www.iec.ch/TC57/CIM#PssIEEE1A
<http://www.iec.ch/TC57/CIM#PssIEEE1A> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemStabilizerDynamics> ;
                                       rdfs:comment "IEEE 421.52005 type PSS1A power system stabilizer model. PSS1A is the generalized form of a PSS with a single input signal. Reference IEEE 1A 421.52005 8.1. " ;
                                       rdfs:label "PssIEEE1A"@en .


###  http://www.iec.ch/TC57/CIM#PssIEEE2B
<http://www.iec.ch/TC57/CIM#PssIEEE2B> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemStabilizerDynamics> ;
                                       rdfs:comment "IEEE 421.52005 type PSS2B power system stabilizer model. This stabilizer model is designed to represent a variety of dualinput stabilizers which normally use combinations of power and speed or frequency to derive the stabilizing signal.Reference IEEE 2B 421.52005 8.2." ;
                                       rdfs:label "PssIEEE2B"@en .


###  http://www.iec.ch/TC57/CIM#PssIEEE3B
<http://www.iec.ch/TC57/CIM#PssIEEE3B> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemStabilizerDynamics> ;
                                       rdfs:comment "IEEE 421.52005 type PSS3B power system stabilizer model. The PSS model PSS3B has dual inputs of electrical power and rotor angular frequency deviation. The signals are used to derive an equivalent mechanical power signal.This model has 2 input signals. They have the following fixed types expressed in terms of InputSignalKind values the first one is of rotorAngleFrequencyDeviation type and the second one is of generatorElectricalPower type.Reference IEEE 3B 421.52005 8.3. " ;
                                       rdfs:label "PssIEEE3B"@en .


###  http://www.iec.ch/TC57/CIM#PssIEEE4B
<http://www.iec.ch/TC57/CIM#PssIEEE4B> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemStabilizerDynamics> ;
                                       rdfs:comment "IEEE 421.52005 type PSS4B power system stabilizer. The PSS4B model represents a structure based on multiple working frequency bands. Three separate bands respectively dedicated to the low intermediate and highfrequency modes of oscillations are used in this delta omega speed input PSS.There is an error in the in IEEE 421.52005 PSS4B model the iPei input should read iPei. This implies that the input iPei needs to be multiplied by 1.Reference IEEE 4B 421.52005 8.4. Parameter detailsThis model has 2 input signals. They have the following fixed types expressed in terms of InputSignalKind values the first one is of rotorAngleFrequencyDeviation type and the second one is of generatorElectricalPower type." ;
                                       rdfs:label "PssIEEE4B"@en .


###  http://www.iec.ch/TC57/CIM#PssPTIST1
<http://www.iec.ch/TC57/CIM#PssPTIST1> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemStabilizerDynamics> ;
                                       rdfs:comment "PTI microprocessorbased stabilizer type 1." ;
                                       rdfs:label "PssPTIST1"@en .


###  http://www.iec.ch/TC57/CIM#PssPTIST3
<http://www.iec.ch/TC57/CIM#PssPTIST3> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemStabilizerDynamics> ;
                                       rdfs:comment "PTI microprocessorbased stabilizer type 3." ;
                                       rdfs:label "PssPTIST3"@en .


###  http://www.iec.ch/TC57/CIM#PssRQB
<http://www.iec.ch/TC57/CIM#PssRQB> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemStabilizerDynamics> ;
                                    rdfs:comment "Power system stabilizer type RQB. This power system stabilizer is intended to be used together with excitation system type ExcRQB which is primarily used in nuclear or thermal generating units." ;
                                    rdfs:label "PssRQB"@en .


###  http://www.iec.ch/TC57/CIM#PssSB4
<http://www.iec.ch/TC57/CIM#PssSB4> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemStabilizerDynamics> ;
                                    rdfs:comment "Power sensitive stabilizer model." ;
                                    rdfs:label "PssSB4"@en .


###  http://www.iec.ch/TC57/CIM#PssSH
<http://www.iec.ch/TC57/CIM#PssSH> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemStabilizerDynamics> ;
                                   rdfs:comment "SiemenssupTMsup H infinity power system stabilizer with generator electrical power input.Footnote Siemens H infinity power system stabilizers are an example of suitable products available commercially. This information is given for the convenience of users of this document and does not constitute an endorsement by IEC of these products. " ;
                                   rdfs:label "PssSH"@en .


###  http://www.iec.ch/TC57/CIM#PssSK
<http://www.iec.ch/TC57/CIM#PssSK> rdf:type owl:Class ;
