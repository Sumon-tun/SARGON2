<http://www.iec.ch/TC57/CIM#BidPriceCapType> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                             rdfs:label "BidPriceCapType"@en .


