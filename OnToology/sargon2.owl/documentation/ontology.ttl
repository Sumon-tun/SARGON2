                                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#MarketFactors> ;
                                                    rdfs:comment "Contains the intervals relavent for the associated TransactionBidResults. For example Day Ahead cleared results for the transaction bids for each interval of the market day." ;
                                                    rdfs:label "TransactionBidClearing"@en .


###  http://www.iec.ch/TC57/CIM#TransactionBidResults
<http://www.iec.ch/TC57/CIM#TransactionBidResults> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                   rdfs:comment "Contains the cleared results for each TransactionBid submitted to and accepted by the market." ;
                                                   rdfs:label "TransactionBidResults"@en .


###  http://www.iec.ch/TC57/CIM#TransactionKind
<http://www.iec.ch/TC57/CIM#TransactionKind> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                             rdfs:comment "Kind of transaction." ;
                                             rdfs:label "TransactionKind"@en .


###  http://www.iec.ch/TC57/CIM#Transactor
