                                                                              rdfs:subClassOf <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#SolarIrradiance> ;
                                                                              rdfs:comment "The intensity of global solar radiation in horizontal level"@en ;
                                                                              rdfs:label "GlobalHorizontalSolar"@en .


