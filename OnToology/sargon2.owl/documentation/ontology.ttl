                                           rdfs:comment "The units defined for usage in the CIM." ;
                                           rdfs:label "DERUnitSymbol"@en .


###  http://www.iec.ch/TC57/CIM#DINStandard
<http://www.iec.ch/TC57/CIM#DINStandard> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Compound> ;
                                         rdfs:comment "Standard published by DIN German Institute of Standards." ;
                                         rdfs:label "DINStandard"@en .


###  http://www.iec.ch/TC57/CIM#DINStandardEditionKind
<http://www.iec.ch/TC57/CIM#DINStandardEditionKind> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                    rdfs:comment "List of editions for DIN standards." ;
                                                    rdfs:label "DINStandardEditionKind"@en .


###  http://www.iec.ch/TC57/CIM#DINStandardKind
<http://www.iec.ch/TC57/CIM#DINStandardKind> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                             rdfs:comment "List of DIN standards." ;
                                             rdfs:label "DINStandardKind"@en .


###  http://www.iec.ch/TC57/CIM#Damping
<http://www.iec.ch/TC57/CIM#Damping> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#CIMDatatype> ;
                                     rdfs:comment "Perunit active power variation with frequency referenced on the system apparent power base. Typical values are in the range 10  20." ;
                                     rdfs:label "Damping"@en .


###  http://www.iec.ch/TC57/CIM#DataSet
<http://www.iec.ch/TC57/CIM#DataSet> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                     rdfs:comment "A generic container of a version of instance data. The MRID can be used in an audit trail not in reusable script intended to work with new versions of data.A dataset could be serialized multiple times and in multiple technologies yet retain the same identity." ;
                                     rdfs:label "DataSet"@en .


###  http://www.iec.ch/TC57/CIM#DatasetArg
<http://www.iec.ch/TC57/CIM#DatasetArg> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ModelOperationArg> ;
                                        rdfs:comment "A model operation argument referencing a dataset instance." ;
                                        rdfs:label "DatasetArg"@en .


###  http://www.iec.ch/TC57/CIM#DatasetArgDescription
<http://www.iec.ch/TC57/CIM#DatasetArgDescription> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ModelOperationArgDescription> ;
                                                   rdfs:label "DatasetArgDescription"@en .


###  http://www.iec.ch/TC57/CIM#Datatype
<http://www.iec.ch/TC57/CIM#Datatype> rdf:type owl:Class .


###  http://www.iec.ch/TC57/CIM#Date
<http://www.iec.ch/TC57/CIM#Date> rdf:type owl:Class ;
                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Primitive> ;
                                  rdfs:comment "Date as yyyymmdd which conforms with ISO 8601. UTC time zone is specified as yyyymmddZ. A local timezone relative UTC is specified as yyyymmddhhmm." ;
                                  rdfs:label "Date"@en .


###  http://www.iec.ch/TC57/CIM#DateAndOrTime
<http://www.iec.ch/TC57/CIM#DateAndOrTime> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                           rdfs:comment "The date andor the time." ;
                                           rdfs:label "DateAndOrTime"@en .


###  http://www.iec.ch/TC57/CIM#DateInterval
<http://www.iec.ch/TC57/CIM#DateInterval> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Compound> ;
                                          rdfs:comment "Interval between two dates." ;
                                          rdfs:label "DateInterval"@en .


###  http://www.iec.ch/TC57/CIM#DateTime
<http://www.iec.ch/TC57/CIM#DateTime> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Primitive> ;
                                      rdfs:comment "Date and time as yyyymmddThhmmss.sss which conforms with ISO 8601. UTC time zone is specified as yyyymmddThhmmss.sssZ. A local timezone relative UTC is specified as yyyymmddThhmmss.ssshhmm. The second component shown here as ss.sss could have any number of digits in its fractional part to allow any kind of precision beyond seconds." ;
                                      rdfs:label "DateTime"@en .


###  http://www.iec.ch/TC57/CIM#DateTimeInterval
<http://www.iec.ch/TC57/CIM#DateTimeInterval> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Compound> ;
                                              rdfs:comment "Interval between two date and time points where the interval includes the start time but excludes end time.  " ;
                                              rdfs:label "DateTimeInterval"@en .


###  http://www.iec.ch/TC57/CIM#DayType
<http://www.iec.ch/TC57/CIM#DayType> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                     rdfs:comment "Group of similar days.   For example it could be used to represent weekdays weekend or holidays." ;
                                     rdfs:label "DayType"@en .


###  http://www.iec.ch/TC57/CIM#Decimal
<http://www.iec.ch/TC57/CIM#Decimal> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Primitive> ;
                                     rdfs:comment "Decimal is the base10 notational system for representing real numbers." ;
                                     rdfs:label "Decimal"@en .


###  http://www.iec.ch/TC57/CIM#DecimalQuantity
<http://www.iec.ch/TC57/CIM#DecimalQuantity> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Compound> ;
                                             rdfs:comment "Quantity with decimal value and associated unit or currency information." ;
                                             rdfs:label "DecimalQuantity"@en .


###  http://www.iec.ch/TC57/CIM#DefaultBid
<http://www.iec.ch/TC57/CIM#DefaultBid> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Bid> ;
                                        rdfs:comment "DefaultBid is a generic class to hold Default Energy Bid Default Startup Bid and Default Minimum Load BidDefault Energy BidA Default Energy Bid is a monotonically increasing staircase function consisting at maximum 10 economic bid segments or 10 MW MW pairs. There are three methods for determining the Default Energy BidulliCost Based derived from the Heat Rate or Average Cost multiplied by the Gas Price Index plus 10.liliLMP Based a weighted average of LMPs in the preceding 90 days.liliNegotiated an amount negotiated with the designated Independent Entity.liulDefault Startup BidA Default Startup Bid DSUB shall be calculated for each RMR unit based on the Startup Cost stored in the Master File and the applicable GPI and EPI.Default Minimum Load BidA Default Minimum Load Bid DMLB shall be calculated for each RMR unit based on the Minimum Load Cost stored in the Master File and the applicable GPI." ;
                                        rdfs:label "DefaultBid"@en .


###  http://www.iec.ch/TC57/CIM#DefaultBidCurve
<http://www.iec.ch/TC57/CIM#DefaultBidCurve> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Curve> ;
                                             rdfs:comment "Default bid curve for default energy bid curve and default startup curves cost and time." ;
                                             rdfs:label "DefaultBidCurve"@en .


###  http://www.iec.ch/TC57/CIM#DefaultBidCurveData
<http://www.iec.ch/TC57/CIM#DefaultBidCurveData> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#CurveData> ;
                                                 rdfs:comment "Curve data for default bid curve and startup cost curve." ;
                                                 rdfs:label "DefaultBidCurveData"@en .


###  http://www.iec.ch/TC57/CIM#DefaultConstraintLimit
<http://www.iec.ch/TC57/CIM#DefaultConstraintLimit> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Curve> ;
                                                    rdfs:comment "Possibly timevarying max MW or MVA and optionally Min MW limit or MVA limit Y1 and Y2 respectively applied as a default value if no specific constraint limits are specified for a contingency analysis. Use CurveSchedule XAxisUnits to specify MW or MVA." ;
                                                    rdfs:label "DefaultConstraintLimit"@en .


###  http://www.iec.ch/TC57/CIM#Delay
<http://www.iec.ch/TC57/CIM#Delay> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                   rdfs:comment "All the measurements are filtered by a first lag element with a time constant TM." ;
                                   rdfs:label "Delay"@en .


