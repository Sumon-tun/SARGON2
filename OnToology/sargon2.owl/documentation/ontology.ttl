<http://www.iec.ch/TC57/CIM#DERMonitorableParameter> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                     rdfs:label "DERMonitorableParameter"@en .


