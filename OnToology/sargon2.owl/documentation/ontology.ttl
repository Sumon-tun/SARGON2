###  http://www.iec.ch/TC57/CIM#BranchEndFlow
<http://www.iec.ch/TC57/CIM#BranchEndFlow> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                           rdfs:comment "Dynamic flows and ratings associated with a branch end." ;
                                           rdfs:label "BranchEndFlow"@en .


###  http://www.iec.ch/TC57/CIM#BranchGroup
<http://www.iec.ch/TC57/CIM#BranchGroup> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                         rdfs:comment "A group of branch terminals whose directed flow summation is to be monitored. A branch group need not form a cutset of the network." ;
                                         rdfs:label "BranchGroup"@en .


###  http://www.iec.ch/TC57/CIM#BranchGroupTerminal
<http://www.iec.ch/TC57/CIM#BranchGroupTerminal> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                 rdfs:comment "A specific directed terminal flow for a branch group." ;
                                                 rdfs:label "BranchGroupTerminal"@en .


###  http://www.iec.ch/TC57/CIM#Breaker
<http://www.iec.ch/TC57/CIM#Breaker> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ProtectedSwitch> ;
                                     rdfs:comment "A mechanical switching device capable of making carrying and breaking currents under normal circuit conditions and also making carrying for a specified time and breaking currents under specified abnormal circuit conditions e.g.  those of short circuit." ;
                                     rdfs:label "Breaker"@en .


###  http://www.iec.ch/TC57/CIM#BreakerApplicationKind
<http://www.iec.ch/TC57/CIM#BreakerApplicationKind> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                    rdfs:comment "Classifications of network roles in which breakers can be deployed. The classifications are intended to reflect both criticality of breaker in network operations and typical usage experienced by breaker.Note This enumeration provides essential information to asset health analytics. The existing list is a starting point and is anticipated to be fleshed out further as requirements are better understood PAB 20160109." ;
                                                    rdfs:label "BreakerApplicationKind"@en .


###  http://www.iec.ch/TC57/CIM#BreakerConfiguration
<http://www.iec.ch/TC57/CIM#BreakerConfiguration> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                  rdfs:comment "Switching arrangement for bay. " ;
                                                  rdfs:label "BreakerConfiguration"@en .


###  http://www.iec.ch/TC57/CIM#BreakerFailureReasonKind
<http://www.iec.ch/TC57/CIM#BreakerFailureReasonKind> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                      rdfs:comment "Reason for breaker failure.Note This enumeration provides essential information to asset health analytics. The existing list is a starting point and is anticipated to be fleshed out further as requirements are better understood PAB 20160109." ;
                                                      rdfs:label "BreakerFailureReasonKind"@en .


###  http://www.iec.ch/TC57/CIM#BreakerInfo
<http://www.iec.ch/TC57/CIM#BreakerInfo> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#OldSwitchInfo> ;
                                         rdfs:comment "Properties of breaker assets." ;
                                         rdfs:label "BreakerInfo"@en .


###  http://www.iec.ch/TC57/CIM#BreakerMaintenanceKind
<http://www.iec.ch/TC57/CIM#BreakerMaintenanceKind> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                    rdfs:comment "Possible types of breaker maintenance work." ;
                                                    rdfs:label "BreakerMaintenanceKind"@en .


###  http://www.iec.ch/TC57/CIM#BreakerRepairItemKind
<http://www.iec.ch/TC57/CIM#BreakerRepairItemKind> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                   rdfs:comment "Breaker components and problem areas which can be the focus of a repair work task." ;
                                                   rdfs:label "BreakerRepairItemKind"@en .


###  http://www.iec.ch/TC57/CIM#BusNameMarker
<http://www.iec.ch/TC57/CIM#BusNameMarker> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                           rdfs:comment "Used to apply user standard names to TopologicalNodes. Associated with one or more terminals that are normally connected with the bus name.    The associated terminals are normally connected by nonretained switches. For a ring bus station configuration all BusbarSection terminals in the ring are typically associated.   For a breaker and a half scheme both BusbarSections would normally be associated.  For a ring bus all BusbarSections would normally be associated.  For a straight busbar configuration normally only the main terminal at the BusbarSection would be associated.  " ;
                                           rdfs:label "BusNameMarker"@en .


###  http://www.iec.ch/TC57/CIM#BusbarConfiguration
<http://www.iec.ch/TC57/CIM#BusbarConfiguration> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                 rdfs:comment "Busbar layout for bay." ;
                                                 rdfs:label "BusbarConfiguration"@en .


###  http://www.iec.ch/TC57/CIM#BusbarSection
<http://www.iec.ch/TC57/CIM#BusbarSection> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Connector> ;
                                           rdfs:comment "A conductor or group of conductors with negligible impedance that serve to connect other conducting equipment within a single substation. Voltage measurements are typically obtained from voltage transformers that are connected to busbar sections. A bus bar section may have many physical terminals but for analysis is modelled with exactly one logical terminal." ;
                                           rdfs:label "BusbarSection"@en .


###  http://www.iec.ch/TC57/CIM#BusbarSectionInfo
<http://www.iec.ch/TC57/CIM#BusbarSectionInfo> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#AssetInfo> ;
                                               rdfs:comment "Busbar section data." ;
                                               rdfs:label "BusbarSectionInfo"@en .


###  http://www.iec.ch/TC57/CIM#Bushing
<http://www.iec.ch/TC57/CIM#Bushing> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Asset> ;
                                     rdfs:comment "Bushing asset." ;
                                     rdfs:label "Bushing"@en .


###  http://www.iec.ch/TC57/CIM#BushingInfo
