###  http://energy.linkeddata.es/em-kpi/ontology#EnergyDemandForecast
<http://energy.linkeddata.es/em-kpi/ontology#EnergyDemandForecast> rdf:type owl:Class ;
                                                                   rdfs:subClassOf <http://energy.linkeddata.es/em-kpi/ontology#EnergyForecast> ;
                                                                   owl:disjointWith <http://energy.linkeddata.es/em-kpi/ontology#EnergyProductionForecast> ;
                                                                   rdfs:label "EnergyDemandForecast"@en .


###  http://energy.linkeddata.es/em-kpi/ontology#EnergyForecast
<http://energy.linkeddata.es/em-kpi/ontology#EnergyForecast> rdf:type owl:Class ;
                                                             rdfs:comment "The forecast of energy demand or production"@en ;
                                                             rdfs:label "EnergyForecast"@en .


###  http://energy.linkeddata.es/em-kpi/ontology#EnergyProduction
<http://energy.linkeddata.es/em-kpi/ontology#EnergyProduction> rdf:type owl:Class ;
                                                               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <http://energy.linkeddata.es/em-kpi/ontology#hasForecast> ;
                                                                                 owl:someValuesFrom <http://energy.linkeddata.es/em-kpi/ontology#EnergyProductionForecast>
                                                                               ] ;
                                                               rdfs:comment "Energy producted by generation system"@en ;
                                                               rdfs:label "EnergyProduction"@en .


###  http://energy.linkeddata.es/em-kpi/ontology#EnergyProductionForecast
<http://energy.linkeddata.es/em-kpi/ontology#EnergyProductionForecast> rdf:type owl:Class ;
                                                                       rdfs:subClassOf <http://energy.linkeddata.es/em-kpi/ontology#EnergyForecast> ;
                                                                       rdfs:label "EnergyProductionForecast" .


