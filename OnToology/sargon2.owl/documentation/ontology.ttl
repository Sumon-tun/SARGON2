<http://www.iec.ch/TC57/CIM#DiscreteValue> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#MeasurementValue> ;
                                           rdfs:comment "DiscreteValue represents a discrete MeasurementValue." ;
                                           rdfs:label "DiscreteValue"@en .


