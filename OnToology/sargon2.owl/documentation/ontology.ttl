<http://www.iec.ch/TC57/CIM#TradingHubPrice> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                             rdfs:comment "Models prices at Trading Hubs interval based." ;
                                             rdfs:label "TradingHubPrice"@en .


