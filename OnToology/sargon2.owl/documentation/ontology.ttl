###  http://www.iec.ch/TC57/CIM#AuxiliaryAccount
<http://www.iec.ch/TC57/CIM#AuxiliaryAccount> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Document> ;
                                              rdfs:comment "Variable and dynamic part of auxiliary agreement generally representing the current state of the account related to the outstanding balance defined in auxiliary agreement." ;
                                              rdfs:label "AuxiliaryAccount"@en .


###  http://www.iec.ch/TC57/CIM#AuxiliaryAgreement
<http://www.iec.ch/TC57/CIM#AuxiliaryAgreement> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Agreement> ;
                                                rdfs:comment "An adhoc auxiliary account agreement associated with a customer agreement not part of the customers account but typically subject to formal agreement between customer and supplier utility. Typically this is used to collect revenue owed by the customer for other services or arrears accrued with the utility for other services. It is typically linked to a prepaid token purchase transaction thus forcing the customer to make a payment towards settlement of the auxiliary account balance whenever the customer needs to purchase a prepaid token for electricity.The present status of the auxiliary agreement can be defined in the context of the utilitys business rules for example enabled disabled pending over recovered under recovered written off etc." ;
                                                rdfs:label "AuxiliaryAgreement"@en .


###  http://www.iec.ch/TC57/CIM#AuxiliaryCost
<http://www.iec.ch/TC57/CIM#AuxiliaryCost> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                           rdfs:comment "Models Market clearing results for Auxiliary costs." ;
                                           rdfs:label "AuxiliaryCost"@en .


###  http://www.iec.ch/TC57/CIM#AuxiliaryEquipment
<http://www.iec.ch/TC57/CIM#AuxiliaryEquipment> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Equipment> ;
                                                rdfs:comment "AuxiliaryEquipment describe equipment that is not performing any primary functions but support for the equipment performing the primary function.AuxiliaryEquipment is attached to primary equipment via an association with Terminal." ;
                                                rdfs:label "AuxiliaryEquipment"@en .


###  http://www.iec.ch/TC57/CIM#AuxiliaryObject
<http://www.iec.ch/TC57/CIM#AuxiliaryObject> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                             rdfs:comment "Models Auxiliary Values." ;
                                             rdfs:label "AuxiliaryObject"@en .


###  http://www.iec.ch/TC57/CIM#AuxiliaryValues
<http://www.iec.ch/TC57/CIM#AuxiliaryValues> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#AuxiliaryObject> ;
                                             rdfs:comment "Models Auxiliary Values." ;
                                             rdfs:label "AuxiliaryValues"@en .


###  http://www.iec.ch/TC57/CIM#AvailablityPlan
<http://www.iec.ch/TC57/CIM#AvailablityPlan> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                             rdfs:comment "The collection of all the availability schedules for a given time range.  Only one availability plan shall be valid for the same period. " ;
                                             rdfs:label "AvailablityPlan"@en .


###  http://www.iec.ch/TC57/CIM#BWRSteamSupply
