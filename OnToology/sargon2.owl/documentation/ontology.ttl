                                               rdfs:comment "A Modeling Authority Set is a group of objects in a network model where the data is supplied and maintained by the same Modeling Authority.This class is typically not included in instance data exchange as this information is tracked by other mechanisms in the exchange." ;
                                               rdfs:label "ModelAuthoritySet"@en .


###  http://www.iec.ch/TC57/CIM#ModelFrameType
<http://www.iec.ch/TC57/CIM#ModelFrameType> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                            rdfs:comment "Examples would be Boundary or Region type of frame." ;
                                            rdfs:label "ModelFrameType"@en .


###  http://www.iec.ch/TC57/CIM#ModelOperation
<http://www.iec.ch/TC57/CIM#ModelOperation> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                            rdfs:comment "An operation performed on models. " ;
                                            rdfs:label "ModelOperation"@en .


###  http://www.iec.ch/TC57/CIM#ModelOperationArg
<http://www.iec.ch/TC57/CIM#ModelOperationArg> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                               rdfs:comment "Describes the role a dataset plays in a model operation.   The role is applicable only in the context of a single operation." ;
                                               rdfs:label "ModelOperationArg"@en .


###  http://www.iec.ch/TC57/CIM#ModelOperationArgDescription
<http://www.iec.ch/TC57/CIM#ModelOperationArgDescription> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                          rdfs:comment "The type of custom operation dataset role for an operation description." ;
                                                          rdfs:label "ModelOperationArgDescription"@en .


###  http://www.iec.ch/TC57/CIM#ModelOperationDescription
<http://www.iec.ch/TC57/CIM#ModelOperationDescription> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                       rdfs:comment "The type of model operation.   This class is referenced by model operations and defines the kind of operation." ;
                                                       rdfs:label "ModelOperationDescription"@en .


###  http://www.iec.ch/TC57/CIM#ModelOperationSequence
<http://www.iec.ch/TC57/CIM#ModelOperationSequence> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                    rdfs:comment "A concrete sequence of operations.    For example this may be used to describe a specific audit trail a script or other specific set of actions on specific datasets." ;
                                                    rdfs:label "ModelOperationSequence"@en .


###  http://www.iec.ch/TC57/CIM#ModelPartSpecification
<http://www.iec.ch/TC57/CIM#ModelPartSpecification> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                    rdfs:comment "The type of model.  For example  state estimator planning planning dynamics short circuit or realtime dynamics etc.     The model must conform to a profile. " ;
                                                    rdfs:label "ModelPartSpecification"@en .


###  http://www.iec.ch/TC57/CIM#ModelPartVersion
<http://www.iec.ch/TC57/CIM#ModelPartVersion> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ModelToBeDeleted> ;
                                              rdfs:comment "This is a version of a part of a model.  New instances of this class with new identity are instantiated upon changes to the content of this class or changes to the associated data set.  Instances of this class are considered immutable.  The case audit trail can reference this immutable data to exactly reproduce a case." ;
                                              rdfs:label "ModelPartVersion"@en .


###  http://www.iec.ch/TC57/CIM#ModelToBeDeleted
<http://www.iec.ch/TC57/CIM#ModelToBeDeleted> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                              rdfs:comment "A Model is a collection of Datasets." ;
                                              rdfs:label "ModelToBeDeleted"@en .


###  http://www.iec.ch/TC57/CIM#Money
<http://www.iec.ch/TC57/CIM#Money> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#CIMDatatype> ;
                                   rdfs:comment "Amount of money." ;
                                   rdfs:label "Money"@en .


###  http://www.iec.ch/TC57/CIM#MonthDay
<http://www.iec.ch/TC57/CIM#MonthDay> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Primitive> ;
                                      rdfs:comment "MonthDay format as mmdd which conforms with XSD data type gMonthDay." ;
                                      rdfs:label "MonthDay"@en .


