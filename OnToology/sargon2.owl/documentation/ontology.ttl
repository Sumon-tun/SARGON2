<http://www.iec.ch/TC57/CIM#BidPriceCap> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                         rdfs:comment "This class represent the bid price cap." ;
                                         rdfs:label "BidPriceCap"@en .


