###  http://www.iec.ch/TC57/CIM#SensitivityPriceCurve
<http://www.iec.ch/TC57/CIM#SensitivityPriceCurve> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Curve> ;
                                                   rdfs:comment "Optionally this curve expresses elasticity of the associated requirement.  For example used to reduce requirements when clearing price exceeds reasonable values when the supply quantity becomes scarce. For example a single point value of 1000MW for a spinning reserve will cause a reduction in the required spinning reserve. X axis is constrained quantity e.g. MWY1 axis is money per constrained quantity" ;
                                                   rdfs:label "SensitivityPriceCurve"@en .


###  http://www.iec.ch/TC57/CIM#Sensor
<http://www.iec.ch/TC57/CIM#Sensor> rdf:type owl:Class ;
                                    owl:equivalentClass <https://w3id.org/saref#Sensor> ;
                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#AuxiliaryEquipment> ;
                                    rdfs:comment "This class describe devices that transform a measured quantity into signals that can be presented at displays used in control or be recorded." ;
                                    rdfs:label "Sensor"@en .


###  http://www.iec.ch/TC57/CIM#Series
<http://www.iec.ch/TC57/CIM#Series> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#TimeSeries> ;
                                    rdfs:comment "A set of similar physical or conceptual objects defined for the same period or point of time." ;
                                    rdfs:label "Series"@en .


###  http://www.iec.ch/TC57/CIM#SeriesCompensator
<http://www.iec.ch/TC57/CIM#SeriesCompensator> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ConductingEquipment> ;
                                               rdfs:comment "A Series Compensator is a series capacitor or reactor or an AC transmission line without charging susceptance.  It is a two terminal device." ;
                                               rdfs:label "SeriesCompensator"@en .


###  http://www.iec.ch/TC57/CIM#ServiceCategory
<http://www.iec.ch/TC57/CIM#ServiceCategory> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                             rdfs:comment "Category of service provided to the customer." ;
                                             rdfs:label "ServiceCategory"@en .


###  http://www.iec.ch/TC57/CIM#ServiceGuarantee
<http://www.iec.ch/TC57/CIM#ServiceGuarantee> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Document> ;
                                              rdfs:comment "A service guarantee often imposed by a regulator defines conditions that if not satisfied will result in the utility making a monetary payment to the customer. Note that guarantees identifier is in the name attribute and the status of the guarantee is in the Status.status attribute.Example service requirements include1 If power is not restored within 24 hours customers can claim 50 for residential customers or 100 for commercial and industrial customers. In addition for each extra period of 12 hours the customers supply has not been activated the customer can claim 25.2 If a customer has a question about their electricity bill the utility will investigate and respond to the inquiry within 15 working days. If utility fails to meet its guarantee utility will automatically pay the customer 50." ;
                                              rdfs:label "ServiceGuarantee"@en .


###  http://www.iec.ch/TC57/CIM#ServiceKind
<http://www.iec.ch/TC57/CIM#ServiceKind> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                         rdfs:comment "Kind of service." ;
                                         rdfs:label "ServiceKind"@en .


###  http://www.iec.ch/TC57/CIM#ServiceLocation
<http://www.iec.ch/TC57/CIM#ServiceLocation> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#WorkLocation> ;
                                             rdfs:comment "A real estate location commonly referred to as premises." ;
                                             rdfs:label "ServiceLocation"@en .


###  http://www.iec.ch/TC57/CIM#ServiceMultiplier
<http://www.iec.ch/TC57/CIM#ServiceMultiplier> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                               rdfs:comment "Multiplier applied at the usage point." ;
                                               rdfs:label "ServiceMultiplier"@en .


###  http://www.iec.ch/TC57/CIM#ServiceMultiplierKind
<http://www.iec.ch/TC57/CIM#ServiceMultiplierKind> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                   rdfs:comment "Kind of service multiplier." ;
                                                   rdfs:label "ServiceMultiplierKind"@en .


###  http://www.iec.ch/TC57/CIM#ServicePoint
<http://www.iec.ch/TC57/CIM#ServicePoint> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                          rdfs:comment "The defined termination points of a transmission path. Service points are defined from the viewpoint of the transmission service. Each service point is contained within or on the boundary of an interchange area. A service point is source or destination of a transaction." ;
                                          rdfs:label "ServicePoint"@en .


###  http://www.iec.ch/TC57/CIM#ServicePointOutageSummary
<http://www.iec.ch/TC57/CIM#ServicePointOutageSummary> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Compound> ;
                                                       rdfs:comment "Summary counts of service points affected by an outage. These counts are sometimes referred to as total and critical customer count." ;
                                                       rdfs:label "ServicePointOutageSummary"@en .


