                                           rdfs:domain <http://www.iec.ch/TC57/CIM#SvSwitch> ;
                                           rdfs:range xsd:boolean ;
                                           rdfs:comment "The attribute tells if the computed state of the switch is considered open." ;
                                           rdfs:label "open"@en .


