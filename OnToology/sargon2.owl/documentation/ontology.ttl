                                                   <http://www.iec.ch/TC57/CIM#SwitchingAction> ;
                                   rdfs:comment "A Clamp is a galvanic connection at a line segment where other equipment is connected. A Clamp does not cut the line segment. A Clamp is ConductingEquipment and has one Terminal with an associated ConnectivityNode. Any other ConductingEquipment can be connected to the Clamp ConnectivityNode." ;
                                   rdfs:label "Clamp"@en .


###  http://www.iec.ch/TC57/CIM#ClampAction
<http://www.iec.ch/TC57/CIM#ClampAction> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#SwitchingAction> ;
                                         rdfs:comment "Action on Clamp as a switching step" ;
                                         rdfs:label "ClampAction"@en .


###  http://www.iec.ch/TC57/CIM#Classification
<http://www.iec.ch/TC57/CIM#Classification> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#CIMDatatype> ;
                                            rdfs:comment "Classification of level.  Specify as 1..n with 1 being the most detailed highest priority etc as described on the attribute using this data type." ;
                                            rdfs:label "Classification"@en .


###  http://www.iec.ch/TC57/CIM#ClassificationCondition
<http://www.iec.ch/TC57/CIM#ClassificationCondition> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                     rdfs:comment "A classification condition used to define preconditions that must be met by a phenomena classification." ;
                                                     rdfs:label "ClassificationCondition"@en .


###  http://www.iec.ch/TC57/CIM#CleanTradeProductType
<http://www.iec.ch/TC57/CIM#CleanTradeProductType> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                   rdfs:label "CleanTradeProductType"@en .


###  http://www.iec.ch/TC57/CIM#ClearanceAction
<http://www.iec.ch/TC57/CIM#ClearanceAction> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#SwitchingAction> ;
                                             rdfs:comment "Action on clearance document as a switching step." ;
                                             rdfs:label "ClearanceAction"@en .


###  http://www.iec.ch/TC57/CIM#ClearanceActionKind
<http://www.iec.ch/TC57/CIM#ClearanceActionKind> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                 rdfs:comment "Type of clearance action." ;
                                                 rdfs:label "ClearanceActionKind"@en .


###  http://www.iec.ch/TC57/CIM#ClearanceDocument
<http://www.iec.ch/TC57/CIM#ClearanceDocument> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#SafetyDocument> ;
                                               rdfs:comment "Safety document used to authorise work on conducting equipment in the field. Tagged equipment is not allowed to be operated." ;
                                               rdfs:label "ClearanceDocument"@en .


###  http://www.iec.ch/TC57/CIM#CloudCondition
<http://www.iec.ch/TC57/CIM#CloudCondition> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#AtmosphericPhenomenon> ;
                                            rdfs:comment "A classified cloud phenomenon with a type." ;
                                            rdfs:label "CloudCondition"@en .


###  http://www.iec.ch/TC57/CIM#CloudKind
<http://www.iec.ch/TC57/CIM#CloudKind> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                       rdfs:comment "Kind of cloud." ;
                                       rdfs:label "CloudKind"@en .


###  http://www.iec.ch/TC57/CIM#CnodeDistributionFactor
<http://www.iec.ch/TC57/CIM#CnodeDistributionFactor> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                     rdfs:comment "Participation factors per Cnode.  Used to calculate participation of Cnode in an AggregateNode. Each Cnode associated to an AggregateNode would be assigned a participation factor for its participation within the AggregateNode. " ;
                                                     rdfs:label "CnodeDistributionFactor"@en .


###  http://www.iec.ch/TC57/CIM#CogenerationPlant
<http://www.iec.ch/TC57/CIM#CogenerationPlant> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemResource> ;
                                               rdfs:comment "A set of thermal generating units for the production of electrical energy and process steam usually from the output of the steam turbines. The steam sendout is typically used for industrial purposes or for municipal heating and cooling." ;
                                               rdfs:label "CogenerationPlant"@en .


###  http://www.iec.ch/TC57/CIM#ComDirectionKind
<http://www.iec.ch/TC57/CIM#ComDirectionKind> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                              rdfs:comment "Kind of communication direction." ;
                                              rdfs:label "ComDirectionKind"@en .


###  http://www.iec.ch/TC57/CIM#ComFunction
<http://www.iec.ch/TC57/CIM#ComFunction> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#EndDeviceFunction> ;
                                         rdfs:comment "Communication function of communication equipment or a device such as a meter. " ;
                                         rdfs:label "ComFunction"@en .


###  http://www.iec.ch/TC57/CIM#ComModule
<http://www.iec.ch/TC57/CIM#ComModule> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Asset> ;
                                       rdfs:comment "An asset having communications capabilities that can be paired with a meter or other end device to provide the device with communication ability through associated communication function. An end device that has communications capabilities through embedded hardware can use that function directly without the communication module or combine embedded communication function with additional communication functions provided through an external communication module e.g. zigbee." ;
                                       rdfs:label "ComModule"@en .


###  http://www.iec.ch/TC57/CIM#ComTechnologyKind
<http://www.iec.ch/TC57/CIM#ComTechnologyKind> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                               rdfs:comment "Kind of communication technology." ;
                                               rdfs:label "ComTechnologyKind"@en .


###  http://www.iec.ch/TC57/CIM#CombinedCycleConfiguration
<http://www.iec.ch/TC57/CIM#CombinedCycleConfiguration> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#RegisteredGenerator> ;
                                                        rdfs:comment "Configuration options for combined cycle units.For example a Combined Cycle with CT1 CT2 ST1 will have CT1 ST1 and CT2 ST1 configurations as part of1CT  1STlogicalconfiguration." ;
                                                        rdfs:label "CombinedCycleConfiguration"@en .


###  http://www.iec.ch/TC57/CIM#CombinedCycleConfigurationMember
<http://www.iec.ch/TC57/CIM#CombinedCycleConfigurationMember> rdf:type owl:Class ;
                                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                              rdfs:comment "Configuration Member of CCP Configuration." ;
                                                              rdfs:label "CombinedCycleConfigurationMember"@en .


###  http://www.iec.ch/TC57/CIM#CombinedCycleLogicalConfiguration
<http://www.iec.ch/TC57/CIM#CombinedCycleLogicalConfiguration> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                               rdfs:comment "Logical Configuration of a Combined Cycle plant.Operating Combined Cycle Plant CCP configurations are represented as Logical CCP Resources. Logical representation shall be used for Market applications to optimize and control Market Operations. Logical representation is also necessary for controlling the number of CCP configurations and to temper performance issues that may otherwise occur. For example2CT configuration1CT  1ST configuration are examples of logical configuration without specifying the specific CT and ST participating in the configuration." ;
                                                               rdfs:label "CombinedCycleLogicalConfiguration"@en .


###  http://www.iec.ch/TC57/CIM#CombinedCyclePlant
<http://www.iec.ch/TC57/CIM#CombinedCyclePlant> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemResource> ;
                                                rdfs:comment "A set of combustion turbines and steam turbines where the exhaust heat from the combustion turbines is recovered to make steam for the steam turbines resulting in greater overall plant efficiency." ;
                                                rdfs:label "CombinedCyclePlant"@en .


###  http://www.iec.ch/TC57/CIM#CombinedCycleTransitionState
<http://www.iec.ch/TC57/CIM#CombinedCycleTransitionState> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                          rdfs:comment "Defines the available from and to Transition States for the Combine Cycle Configurations." ;
                                                          rdfs:label "CombinedCycleTransitionState"@en .


###  http://www.iec.ch/TC57/CIM#CombustionTurbine
<http://www.iec.ch/TC57/CIM#CombustionTurbine> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PrimeMover> ;
                                               rdfs:comment "A prime mover that is typically fuelled by gas or light oil." ;
                                               rdfs:label "CombustionTurbine"@en .


###  http://www.iec.ch/TC57/CIM#Command
<http://www.iec.ch/TC57/CIM#Command> rdf:type owl:Class ;
                                     owl:equivalentClass <https://w3id.org/saref#Command> ;
                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Control> ;
                                     rdfs:comment "A Command is a discrete control used for supervisory control." ;
                                     rdfs:label "Command"@en .


###  http://www.iec.ch/TC57/CIM#CommitmentClearing
<http://www.iec.ch/TC57/CIM#CommitmentClearing> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#MarketFactors> ;
                                                rdfs:comment "Models results of market clearing which call for commitment of units." ;
                                                rdfs:label "CommitmentClearing"@en .


###  http://www.iec.ch/TC57/CIM#CommitmentType
<http://www.iec.ch/TC57/CIM#CommitmentType> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                            rdfs:comment "For exampleSELF  Self commitmentISO  New commitment for this market periodUC  Existing commitment that was a hold over from a previous market" ;
                                            rdfs:label "CommitmentType"@en .


###  http://www.iec.ch/TC57/CIM#Commitments
<http://www.iec.ch/TC57/CIM#Commitments> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                         rdfs:comment "Provides the necessary information on a resource basis to capture the StartupShutdown commitment results. This information is relevant to all markets." ;
                                         rdfs:label "Commitments"@en .


###  http://www.iec.ch/TC57/CIM#CommodityDefinition
<http://www.iec.ch/TC57/CIM#CommodityDefinition> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                 rdfs:comment "Commodities in the context of IEC 62325 are MarketProducts energy regulation reserve etc traded at a specific location which in this case is a Pnode either a specific pricing node or a pricing area or zone defined as a collection of pricing nodes.  The CommodityDefinition is a container for these two parameters plus the unit of measure and the currency in which the Commodity is traded.  Each CommodityDefinition should be relatively static defined once and rarely changed." ;
                                                 rdfs:label "CommodityDefinition"@en .


###  http://www.iec.ch/TC57/CIM#CommodityKind
<http://www.iec.ch/TC57/CIM#CommodityKind> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                           rdfs:comment "Kind of commodity being measured." ;
                                           rdfs:label "CommodityKind"@en .


###  http://www.iec.ch/TC57/CIM#CommodityPrice
<http://www.iec.ch/TC57/CIM#CommodityPrice> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ,
                                                            <https://w3id.org/saref#Commodity> ;
                                            rdfs:comment "The CommodityPrice class is used to define the price of a commodity during a given time interval.  The interval may be long e.g. a year or very short e.g. 5 minutes.  There will be many instances of the CommodityPrice class for each instance of the CommodityDefinition to which it is associated.  Note that there may be more than once price associated with a given interval and these variances are described by the association or associations with the PriceDescriptor class." ;
                                            rdfs:label "CommodityPrice"@en .


###  http://www.iec.ch/TC57/CIM#CommunicationLink
<http://www.iec.ch/TC57/CIM#CommunicationLink> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemResource> ;
                                               rdfs:comment "The connection to remote units is through one or more communication links. Reduntant links may exist. The CommunicationLink class inherits PowerSystemResource. The intention is to allow CommunicationLinks to have Measurements. These Measurements can be used to model link status as operational out of service unit failure etc." ;
                                               rdfs:label "CommunicationLink"@en .


###  http://www.iec.ch/TC57/CIM#CompatibleUnit
<http://www.iec.ch/TC57/CIM#CompatibleUnit> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#WorkDocument> ;
                                            rdfs:comment "A preplanned job model containing labor material and accounting requirements for standardized job planning." ;
                                            rdfs:label "CompatibleUnit"@en .


###  http://www.iec.ch/TC57/CIM#CompleteModelToBeDeleted
<http://www.iec.ch/TC57/CIM#CompleteModelToBeDeleted> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ModelToBeDeleted> ;
                                                      rdfs:comment "A complete model can be used in applications to perform meaningful calculations e.g. a study case in offline tools or a real time model in a SCADAEMS." ;
                                                      rdfs:label "CompleteModelToBeDeleted"@en .


###  http://www.iec.ch/TC57/CIM#ComplianceEvent
<http://www.iec.ch/TC57/CIM#ComplianceEvent> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ActivityRecord> ;
                                             rdfs:comment "Compliance events are used for reporting regulatory or contract compliance issues andor variances. These might be created as a consequence of local business processes and associated rules. It is anticipated that this class will be customised extensively to meet local implementation needs.Use inherited type to indicate that for example expected performance will not be met or reported as mandated." ;
                                             rdfs:label "ComplianceEvent"@en .


###  http://www.iec.ch/TC57/CIM#CompositeSwitch
<http://www.iec.ch/TC57/CIM#CompositeSwitch> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Equipment> ;
                                             rdfs:comment "A model of a set of individual Switches normally enclosed within the same cabinet and possibly with interlocks that restrict the combination of switch positions. These are typically found in medium voltage distribution networks. A CompositeSwitch could represent a RingMainUnit RMU or padmounted switchgear with primitive internal devices such as an internal busbar plus 3 or 4 internal switches each of which may individually be open or closed. A CompositeSwitch and a set of contained Switches can also be used to represent a multiposition switch e.g. a switch that can connect a circuit to Ground Open or Busbar." ;
                                             rdfs:label "CompositeSwitch"@en .


###  http://www.iec.ch/TC57/CIM#CompositeSwitchInfo
<http://www.iec.ch/TC57/CIM#CompositeSwitchInfo> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#AssetInfo> ;
                                                 rdfs:comment "Properties of a composite switch." ;
                                                 rdfs:label "CompositeSwitchInfo"@en .


###  http://www.iec.ch/TC57/CIM#CompositeSwitchKind
<http://www.iec.ch/TC57/CIM#CompositeSwitchKind> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                 rdfs:comment "Kind of composite switch." ;
                                                 rdfs:label "CompositeSwitchKind"@en .


###  http://www.iec.ch/TC57/CIM#Compound
<http://www.iec.ch/TC57/CIM#Compound> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Datatype> .


###  http://www.iec.ch/TC57/CIM#ConcentricNeutralCableInfo
<http://www.iec.ch/TC57/CIM#ConcentricNeutralCableInfo> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#CableInfo> ;
                                                        rdfs:comment "Concentric neutral cable data." ;
                                                        rdfs:label "ConcentricNeutralCableInfo"@en .


###  http://www.iec.ch/TC57/CIM#ConditionFactor
<http://www.iec.ch/TC57/CIM#ConditionFactor> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#WorkIdentifiedObject> ;
                                             rdfs:comment "This is to specify the various condition factors for a design that may alter the cost estimate or the allocation." ;
                                             rdfs:label "ConditionFactor"@en .


###  http://www.iec.ch/TC57/CIM#ConditionFactorKind
<http://www.iec.ch/TC57/CIM#ConditionFactorKind> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                 rdfs:comment "Kind of condition factor." ;
                                                 rdfs:label "ConditionFactorKind"@en .


###  http://www.iec.ch/TC57/CIM#Conductance
<http://www.iec.ch/TC57/CIM#Conductance> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#CIMDatatype> ;
                                         rdfs:comment "Factor by which voltage must be multiplied to give corresponding power lost from a circuit. Real part of admittance." ;
                                         rdfs:label "Conductance"@en .


###  http://www.iec.ch/TC57/CIM#ConductancePerLength
<http://www.iec.ch/TC57/CIM#ConductancePerLength> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#CIMDatatype> ;
                                                  rdfs:comment "Real part of admittance per unit of length." ;
                                                  rdfs:label "ConductancePerLength"@en .


###  http://www.iec.ch/TC57/CIM#ConductingEquipment
<http://www.iec.ch/TC57/CIM#ConductingEquipment> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Equipment> ;
                                                 rdfs:comment "The parts of the AC power system that are designed to carry current or that are conductively connected through terminals." ;
                                                 rdfs:label "ConductingEquipment"@en .


###  http://www.iec.ch/TC57/CIM#Conductor
<http://www.iec.ch/TC57/CIM#Conductor> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ConductingEquipment> ;
                                       rdfs:comment "Combination of conducting material with consistent electrical characteristics building a single electrical system used to carry current between points in the power system.  " ;
                                       rdfs:label "Conductor"@en .


###  http://www.iec.ch/TC57/CIM#ConfigurationEvent
<http://www.iec.ch/TC57/CIM#ConfigurationEvent> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ActivityRecord> ;
                                                rdfs:comment "Used to report details on creation change or deletion of an entity or its configuration." ;
                                                rdfs:label "ConfigurationEvent"@en .


###  http://www.iec.ch/TC57/CIM#ConformLoad
<http://www.iec.ch/TC57/CIM#ConformLoad> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#EnergyConsumer> ;
                                         rdfs:comment "ConformLoad represent loads that follow a daily load change pattern where the pattern can be used to scale the load with a system load." ;
                                         rdfs:label "ConformLoad"@en .


###  http://www.iec.ch/TC57/CIM#ConformLoadGroup
<http://www.iec.ch/TC57/CIM#ConformLoadGroup> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#LoadGroup> ;
                                              rdfs:comment "A group of loads conforming to an allocation pattern. " ;
                                              rdfs:label "ConformLoadGroup"@en .


###  http://www.iec.ch/TC57/CIM#ConformLoadSchedule
<http://www.iec.ch/TC57/CIM#ConformLoadSchedule> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#SeasonDayTypeSchedule> ;
                                                 rdfs:comment "A curve of load  versus time Xaxis showing the active power values Y1axis and reactive power Y2axis for each unit of the period covered. This curve represents a typical pattern of load over the time period for a given day type and season." ;
                                                 rdfs:label "ConformLoadSchedule"@en .


###  http://www.iec.ch/TC57/CIM#CongestionArea
<http://www.iec.ch/TC57/CIM#CongestionArea> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#AggregatedPnode> ;
                                            rdfs:comment "Designated Congestion Area Definition DCA." ;
                                            rdfs:label "CongestionArea"@en .


###  http://www.iec.ch/TC57/CIM#CongestionRevenueRight
<http://www.iec.ch/TC57/CIM#CongestionRevenueRight> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Document> ;
                                                    rdfs:comment "Congestion Revenue Rights CRR class that is inherited from a Document class.A CRR is a financial concept that is used to hedge congestion charges.The CRR is usually settled based on the Locational Marginal Prices LMPs that are calculated in the dayahead market. These LMPs are determined by the Dayahead resource schedulesbids. CRRs will not hedge against marginal losses. If the congestion component of LMP at the sink is greater than at the source then the CRR owner is entitled to receive a portion of congestion revenues. If the congestion component at the sink is less than at the source then an obligationtype CRR owner will be charged but an optiontype CRR owner will not." ;
                                                    rdfs:label "CongestionRevenueRight"@en .


###  http://www.iec.ch/TC57/CIM#ConnectDisconnectFunction
<http://www.iec.ch/TC57/CIM#ConnectDisconnectFunction> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#EndDeviceFunction> ;
                                                       rdfs:comment "A function that will disconnect and reconnect the customers load under defined conditions." ;
                                                       rdfs:label "ConnectDisconnectFunction"@en .


###  http://www.iec.ch/TC57/CIM#ConnectivityNode
<http://www.iec.ch/TC57/CIM#ConnectivityNode> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                              rdfs:comment "Connectivity nodes are points where terminals of AC conducting equipment are connected together with zero impedance." ;
                                              rdfs:label "ConnectivityNode"@en .


###  http://www.iec.ch/TC57/CIM#ConnectivityNodeContainer
<http://www.iec.ch/TC57/CIM#ConnectivityNodeContainer> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#PowerSystemResource> ;
                                                       rdfs:comment "A base class for all objects that may contain connectivity nodes or topological nodes." ;
                                                       rdfs:label "ConnectivityNodeContainer"@en .


###  http://www.iec.ch/TC57/CIM#Connector
<http://www.iec.ch/TC57/CIM#Connector> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ConductingEquipment> ;
                                       rdfs:comment "A conductor or group of conductors with negligible impedance that serve to connect other conducting equipment within a single substation and are modelled with a single logical terminal." ;
                                       rdfs:label "Connector"@en .


###  http://www.iec.ch/TC57/CIM#ConstraintClearing
<http://www.iec.ch/TC57/CIM#ConstraintClearing> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#MarketFactors> ;
                                                rdfs:comment "Groups all items associated with Binding Constraints and Constraint Violations per interval and market." ;
                                                rdfs:label "ConstraintClearing"@en .


###  http://www.iec.ch/TC57/CIM#ConstraintDuration
<http://www.iec.ch/TC57/CIM#ConstraintDuration> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                rdfs:comment "Duration constraint to activate to put in operation to deactivate ... a given event." ;
                                                rdfs:label "ConstraintDuration"@en .


###  http://www.iec.ch/TC57/CIM#ConstraintLimitType
<http://www.iec.ch/TC57/CIM#ConstraintLimitType> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                 rdfs:comment "Binding constraint results limit type For exampleMAXIMUMMINIMUM" ;
                                                 rdfs:label "ConstraintLimitType"@en .


###  http://www.iec.ch/TC57/CIM#ConstraintRampType
<http://www.iec.ch/TC57/CIM#ConstraintRampType> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                rdfs:comment "Constraint Ramp type." ;
