                                      rdfs:comment "An analog control that issues a set point value." ;
                                      rdfs:label "SetPoint"@en .


###  http://www.iec.ch/TC57/CIM#Settlement
<http://www.iec.ch/TC57/CIM#Settlement> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Document> ;
                                        rdfs:comment "Specifies a settlement run." ;
                                        rdfs:label "Settlement"@en .


###  http://www.iec.ch/TC57/CIM#Shift
<http://www.iec.ch/TC57/CIM#Shift> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                   rdfs:comment "Generally referring to a period of operation or work performed. Whether the shift is openclosed can be derived from attributes activityInterval.start and activityInterval.end.The grand total for receipts i.e. cumulative total of all actual receipted amounts during this shift bankable  nonbankable excludes rounding error totals can be derived from receiptsumReceipt.receiptAmount includes bankable and nonbankable receipts.It also has to be reconciled againstsumreceiptsGrandTotalBankable  receiptsGrandTotalNonBankableand against receipt summarysumReceiptSummary.receiptsTotal.The attributes with GrandTotal defined in this class may need to be used when the source data is periodically flushed from the system and then these cannot be derived." ;
                                   rdfs:label "Shift"@en .


###  http://www.iec.ch/TC57/CIM#ShiftPattern
<http://www.iec.ch/TC57/CIM#ShiftPattern> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#WorkIdentifiedObject> ;
                                          rdfs:comment "The patterns of shifts worked by people or crews." ;
                                          rdfs:label "ShiftPattern"@en .


###  http://www.iec.ch/TC57/CIM#ShortCircuitRotorKind
<http://www.iec.ch/TC57/CIM#ShortCircuitRotorKind> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                   rdfs:comment "Type of rotor used by short circuit applications." ;
                                                   rdfs:label "ShortCircuitRotorKind"@en .


###  http://www.iec.ch/TC57/CIM#ShortCircuitTest
<http://www.iec.ch/TC57/CIM#ShortCircuitTest> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#TransformerTest> ;
                                              rdfs:comment "Shortcircuit test results determine mesh impedance parameters. They include load losses and leakage impedances. For threephase windings the excitation can be a positive sequence the default or a zero sequence. There shall be at least one grounded winding." ;
                                              rdfs:label "ShortCircuitTest"@en .


###  http://www.iec.ch/TC57/CIM#ShuntCompensator
<http://www.iec.ch/TC57/CIM#ShuntCompensator> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#RegulatingCondEq> ;
