###  http://www.iec.ch/TC57/CIM#CurveStyle
<http://www.iec.ch/TC57/CIM#CurveStyle> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                        rdfs:comment "Style or shape of curve." ;
                                        rdfs:label "CurveStyle"@en .


###  http://www.iec.ch/TC57/CIM#Customer
<http://www.iec.ch/TC57/CIM#Customer> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#OrganisationRole> ;
                                      rdfs:comment "Organisation receiving services from service supplier." ;
                                      rdfs:label "Customer"@en .


###  http://www.iec.ch/TC57/CIM#CustomerAccount
<http://www.iec.ch/TC57/CIM#CustomerAccount> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Document> ;
                                             rdfs:comment "Assignment of a group of products and services purchased by the customer through a customer agreement used as a mechanism for customer billing and payment. It contains common information from the various types of customer agreements to create billings invoices for a customer and receive payment." ;
                                             rdfs:label "CustomerAccount"@en .


###  http://www.iec.ch/TC57/CIM#CustomerAgreement
<http://www.iec.ch/TC57/CIM#CustomerAgreement> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Agreement> ;
                                               rdfs:comment "Agreement between the customer and the service supplier to pay for service at a specific service location. It records certain billing information about the type of service provided at the service location and is used during charge creation to determine the type of service." ;
                                               rdfs:label "CustomerAgreement"@en .


###  http://www.iec.ch/TC57/CIM#CustomerBillingInfo
<http://www.iec.ch/TC57/CIM#CustomerBillingInfo> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Document> ;
                                                 rdfs:comment "The creation of the monthly customer billing statements is the method employed to notify Customers of charges adjustments and credits applied to their account for Services and Products. The actuall billing occurs through an ErpInvoice. The CustomerBillingInfo includes information from the payment collection meter reading installed meter service site customer customer account customer agreement services and pricing subject areas. Each component price shows up as a separate line item on the ErpInvoice.The Customer Billing Statement may include collection and account messages marketingcivic event messages and bill inserts.One Customer Billing Statement is produced for all Agreements under a CustomerAccount per billing cycle date defined in CustomerAccount.billingCycle.The history of CustomerBillingInfo Invoices and Payments is to be maintained in associated ActivityRecords." ;
                                                 rdfs:label "CustomerBillingInfo"@en .


###  http://www.iec.ch/TC57/CIM#CustomerBillingKind
<http://www.iec.ch/TC57/CIM#CustomerBillingKind> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                 rdfs:comment "Kind of customer billing." ;
                                                 rdfs:label "CustomerBillingKind"@en .


###  http://www.iec.ch/TC57/CIM#CustomerConsumer
<http://www.iec.ch/TC57/CIM#CustomerConsumer> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Organisation> ;
                                              rdfs:comment "The energy buyer in the energy marketplace." ;
                                              rdfs:label "CustomerConsumer"@en .


###  http://www.iec.ch/TC57/CIM#CustomerKind
<http://www.iec.ch/TC57/CIM#CustomerKind> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                          rdfs:comment "Kind of customer." ;
                                          rdfs:label "CustomerKind"@en .


###  http://www.iec.ch/TC57/CIM#CustomerNotification
<http://www.iec.ch/TC57/CIM#CustomerNotification> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                  rdfs:comment "Conditions for notifying the customer about the changes in the status of their service e.g. outage restore estimated restoration time tariff or service level change etc." ;
                                                  rdfs:label "CustomerNotification"@en .


###  http://www.iec.ch/TC57/CIM#Cut
<http://www.iec.ch/TC57/CIM#Cut> rdf:type owl:Class ;
                                 rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Switch> ;
                                 rdfs:comment "A cut separates a line segment into two parts. The cut appears as a switch inserted between these two parts and connects them together. As the cut is normally open there is no galvanic connection between the two line segment parts. But it is possible to close the cut to get galvanic connection.The cut terminals are oriented towards the line segment terminals with the same sequence number. Hence the cut terminal with sequence number equal to 1 is oriented to the line segments terminal with sequence number equal to 1.The cut terminals also act as connection points for jumpers and other equipment e.g. a mobile generator. To enable this connectivity nodes are placed at the cut terminals. Once the connectivity nodes are in place any conducting equipment can be connected at them." ;
                                 rdfs:label "Cut"@en .


###  http://www.iec.ch/TC57/CIM#CutAction
<http://www.iec.ch/TC57/CIM#CutAction> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#SwitchingAction> ;
                                       rdfs:comment "Action on cut as a switching step." ;
                                       rdfs:label "CutAction"@en .


###  http://www.iec.ch/TC57/CIM#Cyclone
<http://www.iec.ch/TC57/CIM#Cyclone> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://www.iec.ch/TC57/CIM#AtmosphericPhenomenon> ;
                                     rdfs:comment "A cyclone or tropical cyclone a rapidlyrotating storm system characterized by a lowpressure center strong winds and a spiral arrangement of thunderstorms that produce heavy rain." ;
                                     rdfs:label "Cyclone"@en .


###  http://www.iec.ch/TC57/CIM#DAMMarketType
<http://www.iec.ch/TC57/CIM#DAMMarketType> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                           rdfs:label "DAMMarketType"@en .


###  http://www.iec.ch/TC57/CIM#DCBaseTerminal
<http://www.iec.ch/TC57/CIM#DCBaseTerminal> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#ACDCTerminal> ;
                                            rdfs:comment "An electrical connection point at a piece of DC conducting equipment. DC terminals are connected at one physical DC node that may have multiple DC terminals connected. A DC node is similar to an AC connectivity node. The model requires that DC connections are distinct from AC connections. " ;
                                            rdfs:label "DCBaseTerminal"@en .


###  http://www.iec.ch/TC57/CIM#DCBreaker
<http://www.iec.ch/TC57/CIM#DCBreaker> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#DCSwitch> ;
                                       rdfs:comment "A breaker within a DC system. " ;
                                       rdfs:label "DCBreaker"@en .


###  http://www.iec.ch/TC57/CIM#DCBusbar
<http://www.iec.ch/TC57/CIM#DCBusbar> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#DCConductingEquipment> ;
                                      rdfs:comment "A busbar within a DC system." ;
                                      rdfs:label "DCBusbar"@en .


###  http://www.iec.ch/TC57/CIM#DCChopper
<http://www.iec.ch/TC57/CIM#DCChopper> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.iec.ch/TC57/CIM#DCConductingEquipment> ;
                                       rdfs:comment "Low resistance equipment used in the internal DC circuit to balance voltages. It has typically positive and negative pole terminals and a ground." ;
                                       rdfs:label "DCChopper"@en .


###  http://www.iec.ch/TC57/CIM#DCConductingEquipment
<http://www.iec.ch/TC57/CIM#DCConductingEquipment> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Equipment> ;
                                                   rdfs:comment "The parts of the DC power system that are designed to carry current or that are conductively connected through DC terminals." ;
                                                   rdfs:label "DCConductingEquipment"@en .


###  http://www.iec.ch/TC57/CIM#DCConverterOperatingModeKind
<http://www.iec.ch/TC57/CIM#DCConverterOperatingModeKind> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                                          rdfs:comment "The operating mode of an HVDC bipole." ;
                                                          rdfs:label "DCConverterOperatingModeKind"@en .


###  http://www.iec.ch/TC57/CIM#DCConverterUnit
<http://www.iec.ch/TC57/CIM#DCConverterUnit> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.iec.ch/TC57/CIM#DCEquipmentContainer> ;
                                             rdfs:comment "Indivisible operative unit comprising all equipment between the point of common coupling on the AC side and the point of common coupling  DC side essentially one or more converters together with one or more converter transformers converter control equipment essential protective and switching devices and auxiliaries if any used for conversion." ;
                                             rdfs:label "DCConverterUnit"@en .


###  http://www.iec.ch/TC57/CIM#DCDisconnector
<http://www.iec.ch/TC57/CIM#DCDisconnector> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#DCSwitch> ;
                                            rdfs:comment "A disconnector within a DC system." ;
                                            rdfs:label "DCDisconnector"@en .


###  http://www.iec.ch/TC57/CIM#DCEquipmentContainer
<http://www.iec.ch/TC57/CIM#DCEquipmentContainer> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#EquipmentContainer> ;
                                                  rdfs:comment "A modelling construct to provide a root class for containment of DC as well as AC equipment. The class differ from the EquipmentContaner for AC in that it may also contain DCNodes. Hence it can contain both AC and DC equipment." ;
                                                  rdfs:label "DCEquipmentContainer"@en .


###  http://www.iec.ch/TC57/CIM#DCGround
<http://www.iec.ch/TC57/CIM#DCGround> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#DCConductingEquipment> ;
                                      rdfs:comment "A ground within a DC system." ;
                                      rdfs:label "DCGround"@en .


###  http://www.iec.ch/TC57/CIM#DCLine
<http://www.iec.ch/TC57/CIM#DCLine> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#DCEquipmentContainer> ;
                                    rdfs:comment "Overhead lines andor cables connecting two or more HVDC substations." ;
                                    rdfs:label "DCLine"@en .


###  http://www.iec.ch/TC57/CIM#DCLineSegment
<http://www.iec.ch/TC57/CIM#DCLineSegment> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#DCConductingEquipment> ;
                                           rdfs:comment "A wire or combination of wires not insulated from one another with consistent electrical characteristics used to carry direct current between points in the DC region of the power system." ;
                                           rdfs:label "DCLineSegment"@en .


