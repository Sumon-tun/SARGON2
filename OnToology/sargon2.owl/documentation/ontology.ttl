                                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                          rdfs:comment "Abstract class for both a network model project and network model change." ;
                                                          rdfs:label "NetworkModelProjectComponent"@en .


