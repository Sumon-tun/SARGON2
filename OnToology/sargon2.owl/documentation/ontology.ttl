<http://www.iec.ch/TC57/CIM#MarketProductType.RC> rdf:type owl:NamedIndividual ,
                                                           <http://www.iec.ch/TC57/CIM#MarketProductType> ;
                                                  rdfs:comment "Residual Unit Commitment" ;
                                                  rdfs:label "RC"@en .


