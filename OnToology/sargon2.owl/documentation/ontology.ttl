<http://www.iec.ch/TC57/CIM#BaseWork> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Document> ;
                                      rdfs:comment "Common representation for work and work tasks." ;
                                      rdfs:label "BaseWork"@en .


