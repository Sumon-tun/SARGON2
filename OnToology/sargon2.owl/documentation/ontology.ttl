@prefix : <http://www.semanticweb.org/stu/ontologies/2024/9/sargon2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/stu/ontologies/2024/9/sargon2#> .

<http://www.semanticweb.org/stu/ontologies/2024/9/sargon2> rdf:type owl:Ontology ;
                                                            <http://purl.org/dc/terms/description> "SARGON2 ontology represents the energy domain including building and non-energy domain including weather and serve as the extension of other ontologies for the digital services in the energy sector, and enable the seamless semantic integration of energy assets in Renewable Energy Valleys. This ontology also fouces on the renewable energy resources including biomass, biogas, wind, solar, geothermal, and hydrogen entities. The main focus of this ontology is to cover the necessary components in the power systems by aligning with IEC61970CIM standard." ;
                                                            <http://purl.org/dc/terms/issued> "2025-03-25"^^xsd:date ;
                                                            <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://webprotege.stanford.edu/R9KdTRIHz9usCNpX2dg4K1f
<http://webprotege.stanford.edu/R9KdTRIHz9usCNpX2dg4K1f> rdf:type owl:AnnotationProperty ;
                                                         rdfs:label "Owner" .


###  http://www.w3.org/2000/01/rdf-schema#flow
rdfs:flow rdf:type owl:AnnotationProperty ;
          rdfs:label "rdfs:flow" .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gMonthDay
xsd:gMonthDay rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#time
xsd:time rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://energy.linkeddata.es/em-kpi/ontology#experiences
<http://energy.linkeddata.es/em-kpi/ontology#experiences> rdf:type owl:ObjectProperty ;
                                                          rdfs:range <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/gbBuildingOntology.owl#Weather> .


###  http://energy.linkeddata.es/em-kpi/ontology#hasForecast
<http://energy.linkeddata.es/em-kpi/ontology#hasForecast> rdf:type owl:ObjectProperty ;
                                                          rdfs:range [ rdf:type owl:Class ;
                                                                       owl:unionOf ( <http://energy.linkeddata.es/em-kpi/ontology#EnergyForecast>
                                                                                     <http://energy.linkeddata.es/em-kpi/ontology#WeatherForecast>
                                                                                   )
                                                                     ] .


###  http://webprotege.stanford.edu/R9WFufxotu4KAAzKLx4qc2U
<http://webprotege.stanford.edu/R9WFufxotu4KAAzKLx4qc2U> rdf:type owl:ObjectProperty ;
                                                         rdfs:subPropertyOf owl:topObjectProperty ;
                                                         rdfs:label "has channel" .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.DCTerminals
<http://www.iec.ch/TC57/CIM#ACDCConverter.DCTerminals> rdf:type owl:ObjectProperty ;
                                                       owl:inverseOf <http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal.DCConductingEquipment> ;
                                                       rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                                       rdfs:range <http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal> ;
                                                       rdfs:comment "A DC converter have DC converter terminals. A converter has two DC converter terminals." ;
                                                       rdfs:label "DCTerminals"@en ,
                                                                  "ClientEnd" .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.PccTerminal
<http://www.iec.ch/TC57/CIM#ACDCConverter.PccTerminal> rdf:type owl:ObjectProperty ;
                                                       owl:inverseOf <http://www.iec.ch/TC57/CIM#Terminal.ConverterDCSides> ;
                                                       rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                                       rdfs:range <http://www.iec.ch/TC57/CIM#Terminal> ;
                                                       rdfs:comment "Point of common coupling terminal for this converter DC side. It is typically the terminal on the power transformer or switch closest to the AC network." ;
                                                       rdfs:label "PccTerminal"@en ,
                                                                  "SupplierEnd" .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.baseS
<http://www.iec.ch/TC57/CIM#ACDCConverter.baseS> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                                 rdfs:range <http://www.iec.ch/TC57/CIM#ApparentPower> ;
                                                 rdfs:comment "Base apparent power of the converter pole. The attribute shall be a positive value." ;
                                                 rdfs:label "baseS"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.idc
<http://www.iec.ch/TC57/CIM#ACDCConverter.idc> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                               rdfs:range <http://www.iec.ch/TC57/CIM#CurrentFlow> ;
                                               rdfs:comment "Converter DC current also called Id. It is converters state variable result from power flow." ;
                                               rdfs:label "idc"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.idleLoss
<http://www.iec.ch/TC57/CIM#ACDCConverter.idleLoss> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                                    rdfs:range <http://www.iec.ch/TC57/CIM#ActivePower> ;
                                                    rdfs:comment "Active power loss in pole at no power transfer. It is converters configuration data used in power flow. The attribute shall be a positive value." ;
                                                    rdfs:label "idleLoss"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.maxP
<http://www.iec.ch/TC57/CIM#ACDCConverter.maxP> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                                rdfs:range <http://www.iec.ch/TC57/CIM#ActivePower> ;
                                                rdfs:comment "Maximum active power limit. The value is overwritten by values of VsCapabilityCurve if present." ;
                                                rdfs:label "maxP"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.maxUdc
<http://www.iec.ch/TC57/CIM#ACDCConverter.maxUdc> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                                  rdfs:range <http://www.iec.ch/TC57/CIM#Voltage> ;
                                                  rdfs:comment "The maximum voltage on the DC side at which the converter should operate. It is converters configuration data used in power flow. The attribute shall be a positive value." ;
                                                  rdfs:label "maxUdc"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.minP
<http://www.iec.ch/TC57/CIM#ACDCConverter.minP> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                                rdfs:range <http://www.iec.ch/TC57/CIM#ActivePower> ;
                                                rdfs:comment "Minimum active power limit. The value is overwritten by values of VsCapabilityCurve if present." ;
                                                rdfs:label "minP"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.minUdc
<http://www.iec.ch/TC57/CIM#ACDCConverter.minUdc> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                                  rdfs:range <http://www.iec.ch/TC57/CIM#Voltage> ;
                                                  rdfs:comment "The minimum voltage on the DC side at which the converter should operate. It is converters configuration data used in power flow. The attribute shall be a positive value." ;
                                                  rdfs:label "minUdc"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.p
<http://www.iec.ch/TC57/CIM#ACDCConverter.p> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                             rdfs:range <http://www.iec.ch/TC57/CIM#ActivePower> ;
                                             rdfs:comment "Active power at the point of common coupling. Load sign convention is used i.e. positive sign means flow out from a node.Starting value for a steady state solution in the case a simplified power flow model is used." ;
                                             rdfs:label "p"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.poleLossP
<http://www.iec.ch/TC57/CIM#ACDCConverter.poleLossP> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                                     rdfs:range <http://www.iec.ch/TC57/CIM#ActivePower> ;
                                                     rdfs:comment "The active power loss at a DC Pole  idleLoss  switchingLossIdc  resitiveLossIdc2.For lossless operation PdcPac.For rectifier operation with losses PdcPaclossP.For inverter operation with losses PdcPaclossP.It is converters state variable used in power flow. The attribute shall be a positive value." ;
                                                     rdfs:label "poleLossP"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.q
<http://www.iec.ch/TC57/CIM#ACDCConverter.q> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                             rdfs:range <http://www.iec.ch/TC57/CIM#ReactivePower> ;
                                             rdfs:comment "Reactive power at the point of common coupling. Load sign convention is used i.e. positive sign means flow out from a node.Starting value for a steady state solution in the case a simplified power flow model is used." ;
                                             rdfs:label "q"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.ratedUdc
<http://www.iec.ch/TC57/CIM#ACDCConverter.ratedUdc> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                                    rdfs:range <http://www.iec.ch/TC57/CIM#Voltage> ;
                                                    rdfs:comment "Rated converter DC voltage also called UdN. The attribute shall be a positive value. It is converters configuration data used in power flow. For instance a bipolar HVDC link with value  200 kV has a 400kV difference between the dc lines." ;
                                                    rdfs:label "ratedUdc"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.resistiveLoss
<http://www.iec.ch/TC57/CIM#ACDCConverter.resistiveLoss> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                                         rdfs:range <http://www.iec.ch/TC57/CIM#Resistance> ;
                                                         rdfs:comment "It is converters configuration data used in power flow. Refer to poleLossP. The attribute shall be a positive value." ;
                                                         rdfs:label "resistiveLoss"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.switchingLoss
<http://www.iec.ch/TC57/CIM#ACDCConverter.switchingLoss> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                                         rdfs:range <http://www.iec.ch/TC57/CIM#ActivePowerPerCurrentFlow> ;
                                                         rdfs:comment "Switching losses relative to the base apparent power baseS. Refer to poleLossP. The attribute shall be a positive value." ;
                                                         rdfs:label "switchingLoss"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.targetPpcc
<http://www.iec.ch/TC57/CIM#ACDCConverter.targetPpcc> rdf:type owl:ObjectProperty ;
                                                      rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                                      rdfs:range <http://www.iec.ch/TC57/CIM#ActivePower> ;
                                                      rdfs:comment "Real power injection target in AC grid at point of common coupling.  Load sign convention is used i.e. positive sign means flow out from a node." ;
                                                      rdfs:label "targetPpcc"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.targetUdc
<http://www.iec.ch/TC57/CIM#ACDCConverter.targetUdc> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                                     rdfs:range <http://www.iec.ch/TC57/CIM#Voltage> ;
                                                     rdfs:comment "Target value for DC voltage magnitude. The attribute shall be a positive value." ;
                                                     rdfs:label "targetUdc"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.uc
<http://www.iec.ch/TC57/CIM#ACDCConverter.uc> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                              rdfs:range <http://www.iec.ch/TC57/CIM#Voltage> ;
                                              rdfs:comment "Linetoline converter voltage the voltage at the AC side of the valve. It is converters state variable result from power flow. The attribute shall be a positive value." ;
                                              rdfs:label "uc"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.udc
<http://www.iec.ch/TC57/CIM#ACDCConverter.udc> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                               rdfs:range <http://www.iec.ch/TC57/CIM#Voltage> ;
                                               rdfs:comment "Converter voltage at the DC side also called Ud. It is converters state variable result from power flow. The attribute shall be a positive value." ;
                                               rdfs:label "udc"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.valveU0
<http://www.iec.ch/TC57/CIM#ACDCConverter.valveU0> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                                   rdfs:range <http://www.iec.ch/TC57/CIM#Voltage> ;
                                                   rdfs:comment "Valve threshold voltage also called Uvalve. Forward voltage drop when the valve is conducting. Used in loss calculations i.e. the switchLoss depend on numberOfValves  valveU0." ;
                                                   rdfs:label "valveU0"@en .


###  http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal.DCConductingEquipment
<http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal.DCConductingEquipment> rdf:type owl:ObjectProperty ;
                                                                           rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal> ;
                                                                           rdfs:range <http://www.iec.ch/TC57/CIM#ACDCConverter> ;
                                                                           rdfs:comment "A DC converter terminal belong to an DC converter." ;
                                                                           rdfs:label "DCConductingEquipment"@en ,
                                                                                      "SupplierEnd" .


###  http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal.polarity
<http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal.polarity> rdf:type owl:ObjectProperty ;
                                                              rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal> ;
                                                              rdfs:range <http://www.iec.ch/TC57/CIM#DCPolarityKind> ;
                                                              rdfs:comment "Represents the normal network polarity condition. Depending on the converter configuration the value shall be set as follows For a monopole with two converter terminals use DCPolarityKind positive and negative. For a bipole or symmetric monopole with three converter terminals use DCPolarityKind positive middle and negative." ;
                                                              rdfs:label "polarity"@en .


###  http://www.iec.ch/TC57/CIM#ACDCTerminal.BusNameMarker
<http://www.iec.ch/TC57/CIM#ACDCTerminal.BusNameMarker> rdf:type owl:ObjectProperty ;
                                                        owl:inverseOf <http://www.iec.ch/TC57/CIM#BusNameMarker.Terminal> ;
                                                        rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCTerminal> ;
                                                        rdfs:range <http://www.iec.ch/TC57/CIM#BusNameMarker> ;
                                                        rdfs:comment "The bus name marker used to name the bus topological node." ;
                                                        rdfs:label "BusNameMarker"@en ,
                                                                   "ClientEnd" .


###  http://www.iec.ch/TC57/CIM#ACDCTerminal.Measurements
<http://www.iec.ch/TC57/CIM#ACDCTerminal.Measurements> rdf:type owl:ObjectProperty ;
                                                       owl:inverseOf <http://www.iec.ch/TC57/CIM#Measurement.Terminal> ;
                                                       rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCTerminal> ;
                                                       rdfs:range <http://www.iec.ch/TC57/CIM#Measurement> ;
                                                       rdfs:comment "Measurements associated with this terminal defining  where the measurement is placed in the network topology.  It may be used for instance to capture the sensor position such as a voltage transformer PT at a busbar or a current transformer CT at the bar between a breaker and an isolator." ;
                                                       rdfs:label "Measurements"@en ,
                                                                  "ClientEnd" .


###  http://www.iec.ch/TC57/CIM#ACDCTerminal.OperationalLimitSet
<http://www.iec.ch/TC57/CIM#ACDCTerminal.OperationalLimitSet> rdf:type owl:ObjectProperty ;
                                                              owl:inverseOf <http://www.iec.ch/TC57/CIM#OperationalLimitSet.Terminal> ;
                                                              rdfs:domain <http://www.iec.ch/TC57/CIM#ACDCTerminal> ;
                                                              rdfs:range <http://www.iec.ch/TC57/CIM#OperationalLimitSet> ;
                                                              rdfs:comment "The operational limit sets at the terminal." ;
                                                              rdfs:label "OperationalLimitSet"@en ,
                                                                         "ClientEnd" .


###  http://www.iec.ch/TC57/CIM#ACLineSegment.ACLineSegmentPhases
<http://www.iec.ch/TC57/CIM#ACLineSegment.ACLineSegmentPhases> rdf:type owl:ObjectProperty ;
                                                               owl:inverseOf <http://www.iec.ch/TC57/CIM#ACLineSegment_merged> ;
                                                               rdfs:domain <http://www.iec.ch/TC57/CIM#ACLineSegment> ;
                                                               rdfs:range <http://www.iec.ch/TC57/CIM#ACLineSegmentPhase> ;
                                                               rdfs:comment "The line segment phases which belong to the line segment." ;
                                                               rdfs:label "ACLineSegmentPhases"@en ,
                                                                          "ClientEnd" .


###  http://www.iec.ch/TC57/CIM#ACLineSegment.Clamp
<http://www.iec.ch/TC57/CIM#ACLineSegment.Clamp> rdf:type owl:ObjectProperty ;
                                                 owl:inverseOf <http://www.iec.ch/TC57/CIM#ACLineSegment_merged> ;
                                                 rdfs:domain <http://www.iec.ch/TC57/CIM#ACLineSegment> ;
                                                 rdfs:range <http://www.iec.ch/TC57/CIM#Clamp> ;
                                                 rdfs:comment "The clamps connected to the line segment." ;
                                                 rdfs:label "Clamp"@en ,
                                                            "SupplierEnd" .


###  http://www.iec.ch/TC57/CIM#ACLineSegment.Cut
<http://www.iec.ch/TC57/CIM#ACLineSegment.Cut> rdf:type owl:ObjectProperty ;
                                               owl:inverseOf <http://www.iec.ch/TC57/CIM#ACLineSegment_merged> ;
                                               rdfs:domain <http://www.iec.ch/TC57/CIM#ACLineSegment> ;
                                               rdfs:range <http://www.iec.ch/TC57/CIM#Cut> ;
                                               rdfs:comment "Cuts applied to the line segment." ;
                                               rdfs:label "Cut"@en ,
                                                          "ClientEnd" .


###  http://www.iec.ch/TC57/CIM#ACLineSegment.LineFaults
<http://www.iec.ch/TC57/CIM#ACLineSegment.LineFaults> rdf:type owl:ObjectProperty ;
                                                      owl:inverseOf <http://www.iec.ch/TC57/CIM#LineFault.ACLineSegment> ;
                                                      rdfs:domain <http://www.iec.ch/TC57/CIM#ACLineSegment> ;
                                                      rdfs:range <http://www.iec.ch/TC57/CIM#LineFault> ;
                                                      rdfs:comment "The line faults of the line segment." ;
                                                      rdfs:label "LineFaults"@en ,
                                                                 "ClientEnd" .


###  http://www.iec.ch/TC57/CIM#ACLineSegment.LineGroundingAction
<http://www.iec.ch/TC57/CIM#ACLineSegment.LineGroundingAction> rdf:type owl:ObjectProperty ;
                                                               owl:inverseOf <http://www.iec.ch/TC57/CIM#GroundAction.AlongACLineSegment> ;
                                                               rdfs:domain <http://www.iec.ch/TC57/CIM#ACLineSegment> ;
                                                               rdfs:range <http://www.iec.ch/TC57/CIM#GroundAction> ;
                                                               rdfs:comment "Ground action involving clamp usage for the case when the ground is applied along the line segment instead of at its terminals." ;
                                                               rdfs:label "LineGroundingAction"@en ,
                                                                          "ClientEnd" .


###  http://www.iec.ch/TC57/CIM#ACLineSegment.LineJumpingAction
<http://www.iec.ch/TC57/CIM#ACLineSegment.LineJumpingAction> rdf:type owl:ObjectProperty ;
                                                             owl:inverseOf <http://www.iec.ch/TC57/CIM#JumperAction.ACLineSegments> ;
                                                             rdfs:domain <http://www.iec.ch/TC57/CIM#ACLineSegment> ;
                                                             rdfs:range <http://www.iec.ch/TC57/CIM#JumperAction> ;
                                                             rdfs:comment "Jumper action involving clamp usage for the case when the jumper is applied along the line segment instead of at its terminals." ;
                                                             rdfs:label "LineJumpingAction"@en ,
                                                                        "ClientEnd" .


###  http://www.iec.ch/TC57/CIM#ACLineSegment.PerLengthImpedance
<http://www.iec.ch/TC57/CIM#ACLineSegment.PerLengthImpedance> rdf:type owl:ObjectProperty ;
                                                              owl:inverseOf <http://www.iec.ch/TC57/CIM#PerLengthImpedance.ACLineSegments> ;
                                                              rdfs:domain <http://www.iec.ch/TC57/CIM#ACLineSegment> ;
                                                              rdfs:range <http://www.iec.ch/TC57/CIM#PerLengthImpedance> ;
                                                              rdfs:comment "Perlength impedance of this line segment." ;
                                                              rdfs:label "PerLengthImpedance"@en ,
                                                                         "ClientEnd" .


###  http://www.iec.ch/TC57/CIM#ACLineSegment.WireSpacingInfo
<http://www.iec.ch/TC57/CIM#ACLineSegment.WireSpacingInfo> rdf:type owl:ObjectProperty ;
                                                           owl:inverseOf <http://www.iec.ch/TC57/CIM#WireSpacingInfo.ACLineSegment> ;
                                                           rdfs:domain <http://www.iec.ch/TC57/CIM#ACLineSegment> ;
                                                           rdfs:range <http://www.iec.ch/TC57/CIM#WireSpacingInfo> ;
                                                           rdfs:label "WireSpacingInfo"@en ,
                                                                      "SupplierEnd" .


###  http://www.iec.ch/TC57/CIM#ACLineSegment.bch
<http://www.iec.ch/TC57/CIM#ACLineSegment.bch> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://www.iec.ch/TC57/CIM#ACLineSegment> ;
                                               rdfs:range <http://www.iec.ch/TC57/CIM#Susceptance> ;
                                               rdfs:comment "Positive sequence shunt charging susceptance uniformly distributed of the entire line section.  This value represents the full charging over the full length of the line." ;
