                                                        rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
                                                        rdfs:comment "Input to measurement calculation.  Support Analog Discrete and Accumulator." ;
                                                        rdfs:label "MeasurementCalculatorInput"@en .


