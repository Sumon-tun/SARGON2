                                               rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                               rdfs:comment "Market power mitigation test method type.Tests with the normal default thresholds or tests with the alternate thresholds." ;
                                               rdfs:label "MPMTestMethodType"@en .


