                                                     rdfs:domain <http://www.iec.ch/TC57/CIM#CsConverter> ;
                                                     rdfs:range <http://www.iec.ch/TC57/CIM#AngleDegrees> ;
                                                     rdfs:comment "Target firing angle. It is converters control variable used in power flow. It is only applicable for rectifier if continuous tap changer control is used. Allowed values are within the range minAlphalttargetAlphaltmaxAlpha. The attribute shall be a positive value." ;
                                                     rdfs:label "targetAlpha"@en .


###  http://www.iec.ch/TC57/CIM#CsConverter.targetGamma
<http://www.iec.ch/TC57/CIM#CsConverter.targetGamma> rdf:type owl:ObjectProperty ;
