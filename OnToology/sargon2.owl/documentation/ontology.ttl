                                    rdfs:comment "An area of activity defined within the energy market." ;
                                    rdfs:label "Domain"@en .


###  http://www.iec.ch/TC57/CIM#DopInstruction
<http://www.iec.ch/TC57/CIM#DopInstruction> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
