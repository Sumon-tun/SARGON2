                                                       rdfs:comment "Self schedule breakdown type." ;
                                                       rdfs:label "SelfScheduleBreakdownType"@en .


###  http://www.iec.ch/TC57/CIM#SelfScheduleType
<http://www.iec.ch/TC57/CIM#SelfScheduleType> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Enumeration> ;
                                              rdfs:comment "self schedule typesPTETCTORRMRRMTRGMRORFCSP" ;
                                              rdfs:label "SelfScheduleType"@en .


