                                                                                rdfs:domain <http://www.iec.ch/TC57/CIM#SurgeArresterInfo> ;
                                                                                rdfs:range <http://www.iec.ch/TC57/CIM#Voltage> ;
                                                                                rdfs:comment "Residual voltage during an 8x20 microsecond current impulse at the nominal discharge current level." ;
                                                                                rdfs:label "lightningImpulseDischargeVoltage"@en .


###  http://www.iec.ch/TC57/CIM#SurgeArresterInfo.nominalDischargeCurrent
<http://www.iec.ch/TC57/CIM#SurgeArresterInfo.nominalDischargeCurrent> rdf:type owl:ObjectProperty ;
                                                                       rdfs:domain <http://www.iec.ch/TC57/CIM#SurgeArresterInfo> ;
                                                                       rdfs:range <http://www.iec.ch/TC57/CIM#CurrentFlow> ;
                                                                       rdfs:comment "The lightning discharge current used to classify the arrester. Choices are limited to 1.5 2.5 5 10 and 20 kA by IEC 60099." ;
                                                                       rdfs:label "nominalDischargeCurrent"@en .


###  http://www.iec.ch/TC57/CIM#SurgeArresterInfo.pressureReliefClass
<http://www.iec.ch/TC57/CIM#SurgeArresterInfo.pressureReliefClass> rdf:type owl:ObjectProperty ;
                                                                   rdfs:domain <http://www.iec.ch/TC57/CIM#SurgeArresterInfo> ;
                                                                   rdfs:range <http://www.iec.ch/TC57/CIM#CurrentFlow> ;
                                                                   rdfs:comment "Fault current level at which all parts of the failed arrester lie within a circle prescribed by IEC 60099." ;
                                                                   rdfs:label "pressureReliefClass"@en .


###  http://www.iec.ch/TC57/CIM#SurgeArresterInfo.ratedVoltage
<http://www.iec.ch/TC57/CIM#SurgeArresterInfo.ratedVoltage> rdf:type owl:ObjectProperty ;
                                                            rdfs:domain <http://www.iec.ch/TC57/CIM#SurgeArresterInfo> ;
                                                            rdfs:range <http://www.iec.ch/TC57/CIM#Voltage> ;
                                                            rdfs:comment "The temporary overvoltage TOV level at power frequency that the surge arrester withstands for 10 seconds." ;
                                                            rdfs:label "ratedVoltage"@en .


###  http://www.iec.ch/TC57/CIM#SurgeArresterInfo.steepFrontDischargeVoltage
<http://www.iec.ch/TC57/CIM#SurgeArresterInfo.steepFrontDischargeVoltage> rdf:type owl:ObjectProperty ;
                                                                          rdfs:domain <http://www.iec.ch/TC57/CIM#SurgeArresterInfo> ;
                                                                          rdfs:range <http://www.iec.ch/TC57/CIM#Voltage> ;
                                                                          rdfs:comment "Residual voltage during a current impulse with front time of 1 microsecond and magnitude equal to the nominal discharge current level." ;
                                                                          rdfs:label "steepFrontDischargeVoltage"@en .


###  http://www.iec.ch/TC57/CIM#SurgeArresterInfo.switchingImpulseDischargeVoltage
<http://www.iec.ch/TC57/CIM#SurgeArresterInfo.switchingImpulseDischargeVoltage> rdf:type owl:ObjectProperty ;
                                                                                rdfs:domain <http://www.iec.ch/TC57/CIM#SurgeArresterInfo> ;
                                                                                rdfs:range <http://www.iec.ch/TC57/CIM#Voltage> ;
                                                                                rdfs:comment "Residual voltage during a current impulse with front time of at least 30 microseconds and magnitude specified in IEC 60099 for the line discharge class. Does not apply to line discharge class 0." ;
                                                                                rdfs:label "switchingImpulseDischargeVoltage"@en .


