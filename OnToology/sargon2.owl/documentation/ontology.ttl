                                                                           rdfs:domain <http://www.iec.ch/TC57/CIM#EquipmentContainer> ;
                                                                           rdfs:range <http://www.iec.ch/TC57/CIM#Equipment> ;
                                                                           rdfs:comment "The additonal contained equipment.  The equipment belong to the equipment container. The equipment is contained in another equipment container but also grouped with this equipment container.  Examples include when a switch contained in a substation is also desired to be grouped with a line contianer or when a switch is included in a secondary substation and also grouped in a feeder." ;
                                                                           rdfs:label "AdditionalGroupedEquipment"@en ,
                                                                                      "SupplierEnd" .


