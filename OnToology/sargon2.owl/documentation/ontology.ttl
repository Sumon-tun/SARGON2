                                                               rdfs:range xsd:integer ;
                                                               rdfs:comment "The sequence position of the point used for defining the order of points for diagram objects acting as a polyline or polygon with more than one point. The attribute shall be a positive value." ;
                                                               rdfs:label "sequenceNumber"@en .


