                                                            <http://www.iec.ch/TC57/CIM#Switch> ;
                                            rdfs:comment "A schedule of switch positions.  If RegularTimePoint.value1 is 0 the switch is open.  If 1 the switch is closed.  " ;
                                            rdfs:label "SwitchSchedule"@en .


###  http://www.iec.ch/TC57/CIM#SwitchStatus
<http://www.iec.ch/TC57/CIM#SwitchStatus> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
