<http://www.iec.ch/TC57/CIM#HeatRateCurve> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Curve> ;
                                           rdfs:comment "Relationship between unit heat rate per active power Yaxis and  unit output Xaxis. The heat input is from all fuels." ;
                                           rdfs:label "HeatRateCurve"@en .


