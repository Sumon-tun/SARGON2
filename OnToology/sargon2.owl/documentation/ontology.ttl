<http://www.iec.ch/TC57/CIM#BilateralTransaction> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Toplevel> ;
                                                  rdfs:comment "Bilateral transaction" ;
                                                  rdfs:label "BilateralTransaction"@en .


