                                                                  rdfs:range xsd:boolean ;
                                                                  rdfs:comment "Whether scalars should be applied before adding the offset." ;
                                                                  rdfs:label "multiplyBeforeAdd"@en .


###  http://www.iec.ch/TC57/CIM#PendingCalculation.offset
<http://www.iec.ch/TC57/CIM#PendingCalculation.offset> rdf:type owl:DatatypeProperty ;
                                                       rdfs:domain <http://www.iec.ch/TC57/CIM#PendingCalculation> ;
                                                       rdfs:range xsd:integer ;
                                                       rdfs:comment "if applicable Offset to be added as well as multiplication using scalars." ;
                                                       rdfs:label "offset"@en .


###  http://www.iec.ch/TC57/CIM#PendingCalculation.scalarDenominator
<http://www.iec.ch/TC57/CIM#PendingCalculation.scalarDenominator> rdf:type owl:DatatypeProperty ;
                                                                  rdfs:domain <http://www.iec.ch/TC57/CIM#PendingCalculation> ;
                                                                  rdfs:range xsd:integer ;
                                                                  rdfs:comment "if scalar is rational number When IntervalReading.value is multiplied by scalarNumerator and divided by this value it causes a unit of measure conversion to occur resulting in the ReadingType.unit." ;
                                                                  rdfs:label "scalarDenominator"@en .


###  http://www.iec.ch/TC57/CIM#PendingCalculation.scalarFloat
<http://www.iec.ch/TC57/CIM#PendingCalculation.scalarFloat> rdf:type owl:DatatypeProperty ;
                                                            rdfs:domain <http://www.iec.ch/TC57/CIM#PendingCalculation> ;
                                                            rdfs:range xsd:float ;
                                                            rdfs:comment "if scalar is floating number When multiplied with IntervalReading.value it causes a unit of measure conversion to occur according to the ReadingType.unit." ;
                                                            rdfs:label "scalarFloat"@en .


###  http://www.iec.ch/TC57/CIM#PendingCalculation.scalarNumerator
<http://www.iec.ch/TC57/CIM#PendingCalculation.scalarNumerator> rdf:type owl:DatatypeProperty ;
                                                                rdfs:domain <http://www.iec.ch/TC57/CIM#PendingCalculation> ;
                                                                rdfs:range xsd:integer ;
                                                                rdfs:comment "if scalar is integer or rational number  When the scalar is a simple integer and this attribute is presented alone and multiplied with IntervalReading.value it causes a unit of measure conversion to occur resulting in the ReadingType.unit. It is never used in conjunction with scalarFloat only with scalarDenominator." ;
                                                                rdfs:label "scalarNumerator"@en .


