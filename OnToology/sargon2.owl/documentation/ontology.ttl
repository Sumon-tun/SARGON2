                                               rdfs:comment "A logical AND operation. True when all input are true." ;
                                               rdfs:label "and"@en .


###  http://www.iec.ch/TC57/CIM#GateLogicKind.nand
<http://www.iec.ch/TC57/CIM#GateLogicKind.nand> rdf:type owl:NamedIndividual ,
                                                         <http://www.iec.ch/TC57/CIM#GateLogicKind> ;
                                                rdfs:comment "A logical NAND operation. False when all input are true." ;
                                                rdfs:label "nand"@en .


###  http://www.iec.ch/TC57/CIM#GateLogicKind.nor
<http://www.iec.ch/TC57/CIM#GateLogicKind.nor> rdf:type owl:NamedIndividual ,
                                                        <http://www.iec.ch/TC57/CIM#GateLogicKind> ;
                                               rdfs:comment "A logical NOR operation. False when one or more input are true." ;
                                               rdfs:label "nor"@en .


###  http://www.iec.ch/TC57/CIM#GateLogicKind.not
<http://www.iec.ch/TC57/CIM#GateLogicKind.not> rdf:type owl:NamedIndividual ,
                                                        <http://www.iec.ch/TC57/CIM#GateLogicKind> ;
                                               rdfs:comment "A logical NOT operation. Only one input and true input will give false out and false in will give true out. An inverter." ;
                                               rdfs:label "not"@en .


###  http://www.iec.ch/TC57/CIM#GateLogicKind.or
