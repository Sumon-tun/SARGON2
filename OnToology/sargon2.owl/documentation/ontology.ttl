###  http://www.iec.ch/TC57/CIM#OperatingParticipant
<http://www.iec.ch/TC57/CIM#OperatingParticipant> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#IdentifiedObject> ;
