                                                                   rdfs:domain <http://www.iec.ch/TC57/CIM#PackageDependenciesCIMVersion> ;
                                                                   rdfs:range xsd:string ;
                                                                   rdfs:comment "The version of the main subpackages of the combined CIM model.  The format is simply an integer.  The version and date initial values should be updated any time the dependencies in the model change and require an actual change to the diagrams within this package." ;
                                                                   rdfs:label "version"@en .


