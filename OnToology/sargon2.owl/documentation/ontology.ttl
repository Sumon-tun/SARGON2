                                            rdfs:subClassOf <http://www.iec.ch/TC57/CIM#SteamSupply> ;
                                            rdfs:comment "Boiling water reactor used as a steam supply to a steam turbine." ;
                                            rdfs:label "BWRSteamSupply"@en .


###  http://www.iec.ch/TC57/CIM#Bank
<http://www.iec.ch/TC57/CIM#Bank> rdf:type owl:Class ;
                                  rdfs:subClassOf <http://www.iec.ch/TC57/CIM#OrganisationRole> ;
                                  rdfs:comment "Organisation that is a commercial bank agency or other institution that offers a similar service." ;
                                  rdfs:label "Bank"@en .


