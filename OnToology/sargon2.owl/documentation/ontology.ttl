:indoorSpaceHeating rdf:type owl:Class ;
                    rdfs:subClassOf :indoorEnvironment ;
                    rdfs:comment "Indoor space heating" .


###  https://w3id.org/saref#ActuatingFunction
<https://w3id.org/saref#ActuatingFunction> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://w3id.org/saref#Function> ;
                                           rdfs:comment "A function that allows to transmit data to actuators, such as level settings (e.g., temperature) or binary switching (e.g., open/close, on/off)" ;
                                           rdfs:label "Actuating function" .


###  https://w3id.org/saref#Actuator
<https://w3id.org/saref#Actuator> rdf:type owl:Class ;
                                  rdfs:subClassOf <http://webprotege.stanford.edu/R9Ss0nlABbeWn3nuA9NaaUI> ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://webprotege.stanford.edu/RDAjHtUVAjpRS1IKarpqaN> ;
                                                    owl:someValuesFrom xsd:int
                                                  ] ;
                                  rdfs:comment "A device responsible for moving or controlling a mechanism or system by performing an actuating function" ;
                                  rdfs:label "Actuator" .


###  https://w3id.org/saref#Building
<https://w3id.org/saref#Building> rdf:type owl:Class ;
                                  rdfs:subClassOf owl:Thing ;
                                  rdfs:comment "A category that includes devices as described by building related data models, such as IFC and FIEMSER " ;
                                  rdfs:label "Building" .


###  https://w3id.org/saref#CloseCommand
<https://w3id.org/saref#CloseCommand> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/saref#Command> ;
                                      owl:disjointWith <https://w3id.org/saref#OpenCommand> ;
                                      rdfs:comment "A type of command" ;
                                      rdfs:label "Close command" .


###  https://w3id.org/saref#CloseState
<https://w3id.org/saref#CloseState> rdf:type owl:Class ;
                                    rdfs:subClassOf <https://w3id.org/saref#OpenCloseState> ;
                                    rdfs:comment "The state of a device that is CLOSE" ;
                                    rdfs:label "Close state" .


###  https://w3id.org/saref#Coal
<https://w3id.org/saref#Coal> rdf:type owl:Class ;
                              rdfs:subClassOf <https://w3id.org/saref#Commodity> ;
                              rdfs:comment "A type of commodity" ;
                              rdfs:label "Coal" .


###  https://w3id.org/saref#Command
<https://w3id.org/saref#Command> rdf:type owl:Class ;
                                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                   owl:onProperty <https://w3id.org/saref#hasDescription> ;
                                                   owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                 ] ;
                                 rdfs:comment "A directive that a device must support to perform a certain function. A command may act upon a state, but does not necessarily act upon a state. For example, the ON command acts upon the ON/OFF state, but the GET command does not act upon any state, it simply gives a directive to retrieve a certain value. We propose here a list of commands that are relevant for the purpose of SAREF, but this list can be extended." ;
                                 rdfs:label "Command" .


###  https://w3id.org/saref#Commodity
<https://w3id.org/saref#Commodity> rdf:type owl:Class ;
                                   rdfs:comment "A marketable item for which there is demand, but which is supplied without qualitative differentiation across a market. SAREF refers to energy commodities such as electricity, gas, coal and oil. " ;
                                   rdfs:label "Commodity" .


###  https://w3id.org/saref#Currency
<https://w3id.org/saref#Currency> rdf:type owl:Class ;
                                  rdfs:subClassOf <https://w3id.org/saref#UnitsMeasuremet> ;
                                  rdfs:comment "The unit of measure for price" ;
                                  rdfs:label "Currency unit" .


###  https://w3id.org/saref#Device
<https://w3id.org/saref#Device> rdf:type owl:Class ;
                                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/saref#hasState> ;
                                                  owl:someValuesFrom <https://w3id.org/saref#State>
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/saref#hasState> ;
                                                  owl:allValuesFrom <https://w3id.org/saref#State>
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <http://webprotege.stanford.edu/R4T4qE1pipLEVhQIalc1yF> ;
                                                  owl:someValuesFrom xsd:string
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/saref#hasDescription> ;
                                                  owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/saref#hasManufacturer> ;
                                                  owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/saref#hasModel> ;
                                                  owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                ] ;
                                rdfs:comment "A tangible object designed to accomplish a particular task in households, common public buildings or offices. In order to accomplish this task, the device performs one or more functions. For example, a washing machine is designed to wash (task) and to accomplish this task it performs a start and stop function. Devices can be structured in categories (subclasses) that reflect the different domain in which a device is used, e.g., smart appliances domain (subclass FunctionRelated) vs. building domain (subclass BuildingRelated) vs. smart grid domain (subclass EnergyRelated). New categories can be defined,if needed, to reflect other differences, for example different points of view, such as the point of view of the device's user vs. the point of view of the device's manufacturer. We propose a list of devices that are relevant for the purpose of SAREF, but this list can be extended." ;
                                rdfs:label "Device" .


###  https://w3id.org/saref#DoorSwitch
<https://w3id.org/saref#DoorSwitch> rdf:type owl:Class ;
                                    rdfs:subClassOf <https://w3id.org/saref#Switch> ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/saref#hasState> ;
                                                      owl:someValuesFrom <https://w3id.org/saref#OpenCloseState>
                                                    ] ;
                                    rdfs:comment "A device of category saref:Actuator that consists of a switch, accomplishes the task saref:Safety, performs the saref:OpenCloseFunction, is used for controlling a door, and can be found in the state saref:OpenCloseState." ;
                                    rdfs:label "Door switch" .


###  https://w3id.org/saref#Electricity
<https://w3id.org/saref#Electricity> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/saref#Commodity> ;
                                     rdfs:comment "A type of commodity" ;
                                     rdfs:label "Electricity" .


###  https://w3id.org/saref#EnergyMeter
<https://w3id.org/saref#EnergyMeter> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/saref#Meter> ;
                                     rdfs:comment "An energy meter is a device of category saref:Meter that consists of a meter, accomplishes the tasks saref:MeterReading and saref:EnergyEfficiency, performs the saref:MeteringFunction and is used for the purpose of measuring the saref:Energy property" ;
                                     rdfs:label "Energy meter" .


###  https://w3id.org/saref#EnergyRelated
<https://w3id.org/saref#EnergyRelated> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/saref#Device> ;
                                       rdfs:comment "A category that considers devices based on energy consumption information and profiles to optimize energy efficiency." ;
                                       rdfs:label "Grid related" .


###  https://w3id.org/saref#EnergyUnit
<https://w3id.org/saref#EnergyUnit> rdf:type owl:Class ;
                                    rdfs:subClassOf <https://w3id.org/saref#UnitsMeasuremet> ;
                                    rdfs:comment "The unit of measure for energy" ;
                                    rdfs:label "Energy unit" .


###  https://w3id.org/saref#EventFunction
<https://w3id.org/saref#EventFunction> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/saref#Function> ;
                                       rdfs:comment "A function that allows to notify another device that a certain threshold value has been exceeded." ;
                                       rdfs:label "Event function" .


###  https://w3id.org/saref#Function
<https://w3id.org/saref#Function> rdf:type owl:Class ;
                                  rdfs:comment "The functionality necessary to accomplish the task for which a Device is designed. A device can be designed to perform more than one function. Functions can be structured in categories (subclasses) that reflect different points of view, for example, considering the specific application area for which a function can be used (e.g., light, temperature, motion, heat, power, etc.), or the capability that a function can support (e.g., receive, reply, notify, etc.), and so forth. " ;
                                  rdfs:label "Function" .


###  https://w3id.org/saref#Gas
<https://w3id.org/saref#Gas> rdf:type owl:Class ;
                             rdfs:subClassOf <https://w3id.org/saref#Commodity> ;
                             rdfs:comment "A type of commodity" ;
                             rdfs:label "Gas" .


###  https://w3id.org/saref#Generator
<https://w3id.org/saref#Generator> rdf:type owl:Class ;
                                   rdfs:subClassOf <https://w3id.org/saref#EnergyRelated> ;
                                   rdfs:comment "A type of energy-related device that generates energy" ;
                                   rdfs:label "Generator" .


###  https://w3id.org/saref#GetCommand
<https://w3id.org/saref#GetCommand> rdf:type owl:Class ;
                                    rdfs:subClassOf <https://w3id.org/saref#Command> ;
                                    rdfs:comment "A type of command" ;
                                    rdfs:label "Get command" .


###  https://w3id.org/saref#GetCurrentMeterValueCommand
<https://w3id.org/saref#GetCurrentMeterValueCommand> rdf:type owl:Class ;
                                                     rdfs:subClassOf <https://w3id.org/saref#GetCommand> ;
                                                     rdfs:comment "A type of get command" ;
                                                     rdfs:label "Get current meter value command" .


###  https://w3id.org/saref#GetMeterDataCommand
<https://w3id.org/saref#GetMeterDataCommand> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/saref#GetCommand> ;
                                             rdfs:comment "A type of get command" ;
                                             rdfs:label "Get meter data command" .


###  https://w3id.org/saref#GetMeterHistoryCommand
<https://w3id.org/saref#GetMeterHistoryCommand> rdf:type owl:Class ;
                                                rdfs:subClassOf <https://w3id.org/saref#GetCommand> ;
                                                rdfs:comment "A type of get command" ;
                                                rdfs:label "Get meter history command" .


###  https://w3id.org/saref#GetSensingDataCommand
<https://w3id.org/saref#GetSensingDataCommand> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://w3id.org/saref#GetCommand> ;
                                               rdfs:comment "A type of get command" ;
                                               rdfs:label "Get sensing data command" .


###  https://w3id.org/saref#Humidity
<https://w3id.org/saref#Humidity> rdf:type owl:Class ;
                                  rdfs:subClassOf <https://w3id.org/saref#Property> ;
                                  rdfs:comment "A saref:Property related to some measurements that are characterized by a certain value that is measured in a humidity unit" ;
                                  rdfs:label "Humidity" .


###  https://w3id.org/saref#LevelControlFunction
<https://w3id.org/saref#LevelControlFunction> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/saref#ActuatingFunction> ;
                                              rdfs:comment "An actuating function that allows to do level adjustments of an actuator in a certain range (e.g., 0%-100%), such as dimming a light or set the speed of an electric motor. " ;
                                              rdfs:label "Level control function" .


###  https://w3id.org/saref#Light
<https://w3id.org/saref#Light> rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/saref#Property> ;
                               rdfs:comment "A saref:Property related to some measurements that are characterized by a certain value that is measured in a illuminance unit (lux)" ;
                               rdfs:label "Light" .


###  https://w3id.org/saref#LightSwitch
<https://w3id.org/saref#LightSwitch> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/saref#Switch> ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://w3id.org/saref#hasState> ;
                                                       owl:someValuesFrom <https://w3id.org/saref#OnOffState>
                                                     ] ;
                                     rdfs:comment "A device of category saref:Actuator that consists of a switch, accomplishes the task saref:Lighting, performs the saref:OnOffFunction, measures the property saref:Light, and can be found in the state saref:OnOffState. It can offer a switch on service." ;
                                     rdfs:label "Light switch" .


###  https://w3id.org/saref#LightingDevice
<https://w3id.org/saref#LightingDevice> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/saref#Load> ;
                                        rdfs:comment "A device used for illumination, irradiation, signaling, or projection" ;
                                        rdfs:label "Lighting device" .


###  https://w3id.org/saref#Load
<https://w3id.org/saref#Load> rdf:type owl:Class ;
                              rdfs:subClassOf <https://w3id.org/saref#EnergyRelated> ;
                              rdfs:comment "A type of energy-related device that consumes energy" ;
                              rdfs:label "Load" .


###  https://w3id.org/saref#Meter
<https://w3id.org/saref#Meter> rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/saref#EnergyRelated> ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <http://webprotege.stanford.edu/RBQYwalLa8y1fuwJmAeuKrK> ;
                                                 owl:someValuesFrom xsd:int
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <http://webprotege.stanford.edu/RDAjHtUVAjpRS1IKarpqaN> ;
                                                 owl:someValuesFrom xsd:int
                                               ] ;
                               rdfs:comment "A device built to accurately detect and display a quantity in a form readable by a human being. Further, a device of category saref:Meter that performs a saref:MeteringFunction." ;
                               rdfs:label "Meter" .


###  https://w3id.org/saref#MeteringFunction
<https://w3id.org/saref#MeteringFunction> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/saref#Function> ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <https://w3id.org/saref#hasMeterReading> ;
                                                            owl:allValuesFrom <https://w3id.org/saref#UnitsMeasuremet>
                                                          ] ;
                                          rdfs:comment "A function that allows to get data from a meter, such as current meter reading or instantaneous demand" ;
                                          rdfs:label "Metering function" .


###  https://w3id.org/saref#Motion
<https://w3id.org/saref#Motion> rdf:type owl:Class ;
                                rdfs:subClassOf <https://w3id.org/saref#Property> ;
                                rdfs:comment "A saref:Property related to some measurements that are characterized by a certain value that is measured in a unit of measure for motion" ;
                                rdfs:label "Motion" .


###  https://w3id.org/saref#MultiLevelState
<https://w3id.org/saref#MultiLevelState> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/saref#State> ;
                                         rdfs:comment "A type of state" ;
                                         rdfs:label "Multi level state" .


###  https://w3id.org/saref#NotifyCommand
<https://w3id.org/saref#NotifyCommand> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/saref#Command> ;
                                       rdfs:comment "A type of command" ;
                                       rdfs:label "Notify command" .


###  https://w3id.org/saref#Occupancy
<https://w3id.org/saref#Occupancy> rdf:type owl:Class ;
                                   rdfs:subClassOf <https://w3id.org/saref#Property> ;
                                   rdfs:comment "A saref:Property related to some measurements that are characterized by a certain value (saref:hasValue property) that is measured in a unit of measure for occupancy" ;
                                   rdfs:label "Occupancy" .


###  https://w3id.org/saref#OffCommand
<https://w3id.org/saref#OffCommand> rdf:type owl:Class ;
                                    rdfs:subClassOf <https://w3id.org/saref#Command> ;
                                    owl:disjointWith <https://w3id.org/saref#OnCommand> ;
                                    rdfs:comment "A type of command" ;
                                    rdfs:label "Off command" .


###  https://w3id.org/saref#OffState
<https://w3id.org/saref#OffState> rdf:type owl:Class ;
                                  rdfs:subClassOf <https://w3id.org/saref#OnOffState> ;
                                  rdfs:comment "The state of a device that is ON" ;
                                  rdfs:label "Off state" .


###  https://w3id.org/saref#OnCommand
<https://w3id.org/saref#OnCommand> rdf:type owl:Class ;
                                   rdfs:subClassOf <https://w3id.org/saref#Command> ;
                                   rdfs:comment "A type of command" ;
                                   rdfs:label "On command" .


###  https://w3id.org/saref#OnOffFunction
<https://w3id.org/saref#OnOffFunction> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/saref#ActuatingFunction> ;
                                       rdfs:comment "An actuating function that allows to switch on and off an actuator" ;
                                       rdfs:label "On off function" .


###  https://w3id.org/saref#OnOffState
<https://w3id.org/saref#OnOffState> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://www.iec.ch/TC57/CIM#OnOff> ,
                                                    <https://w3id.org/saref#State> ;
                                    rdfs:comment "A type of state" ;
                                    rdfs:label "On off state" .


###  https://w3id.org/saref#OnState
<https://w3id.org/saref#OnState> rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/saref#OnOffState> ;
                                 rdfs:comment "The state of a device that is OFF " ;
                                 rdfs:label "On state" .


###  https://w3id.org/saref#OpenCloseFunction
<https://w3id.org/saref#OpenCloseFunction> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://w3id.org/saref#ActuatingFunction> ;
                                           rdfs:comment "An actuating function that allows to open and close a device" ;
                                           rdfs:label "Open close function" .


###  https://w3id.org/saref#OpenCloseState
<https://w3id.org/saref#OpenCloseState> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/saref#State> ;
                                        rdfs:comment "A type of state" ;
                                        rdfs:label "Open close state" .


###  https://w3id.org/saref#OpenCommand
<https://w3id.org/saref#OpenCommand> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/saref#Command> ;
                                     rdfs:comment "A type of command" ;
                                     rdfs:label "Open command" .


###  https://w3id.org/saref#OpenState
<https://w3id.org/saref#OpenState> rdf:type owl:Class ;
                                   rdfs:subClassOf <https://w3id.org/saref#OpenCloseState> ;
                                   rdfs:comment "The state of a device that is OPEN " ;
                                   rdfs:label "Open state" .


###  https://w3id.org/saref#PauseCommand
<https://w3id.org/saref#PauseCommand> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/saref#Command> ;
                                      rdfs:comment "A type of command" ;
                                      rdfs:label "Pause command" .


###  https://w3id.org/saref#Power
<https://w3id.org/saref#Power> rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/saref#Property> ;
                               rdfs:comment "A saref:Property related to some measurements that are characterized by a certain value that is measured in a power unit (such as watt or kilowatt).  Further specializations of the saref:Power class can be found in the SAREF4ENER extension, where classes such as PowerMax, PowerMin and PowerExpected are defined." ;
                               rdfs:label "Power" .


###  https://w3id.org/saref#PowerUnit
<https://w3id.org/saref#PowerUnit> rdf:type owl:Class ;
                                   rdfs:subClassOf <https://w3id.org/saref#UnitsMeasuremet> ;
                                   rdfs:comment "The unit of measure for power" ;
                                   rdfs:label "Power unit" .


###  https://w3id.org/saref#Pressure
<https://w3id.org/saref#Pressure> rdf:type owl:Class ;
                                  rdfs:subClassOf <https://w3id.org/saref#Property> ;
                                  rdfs:comment "A saref:Property related to some measurements that are characterized by a certain value that is measured in a pressure unit (bar or pascal)" ;
                                  rdfs:label "Pressure" .


###  https://w3id.org/saref#PressureUnit
<https://w3id.org/saref#PressureUnit> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/saref#UnitsMeasuremet> ;
                                      rdfs:comment "The unit of measure for pressure" ;
                                      rdfs:label "Pressure unit" .


###  https://w3id.org/saref#Price
<https://w3id.org/saref#Price> rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/saref#Property> ;
                               rdfs:comment "A saref:Property crelated to some measurements that are characterized by a certain value that is measured using saref:Currency" ;
                               rdfs:label "Price" .


###  https://w3id.org/saref#Profile
<https://w3id.org/saref#Profile> rdf:type owl:Class ;
                                 rdfs:comment "A specification associated to a device to collect information about a certain Property (e.g., Energy) or Commodity (e.g.Water) for optimizing its usage in the home, office or building in which the device is located. This specification is about a certain Property or Commodity (saref:isAbout), can be calculated over a time span (saref:hasTime ) and can be associated to some costs (saref:hasPrice). An example is the Power Profile defined in the SAREF4ENER extension that can be associated to a device for optimizing the Energy efficiency in the home, office or building in which the device is located."@en ;
                                 rdfs:label "Profile"@en .


###  https://w3id.org/saref#Property
<https://w3id.org/saref#Property> rdf:type owl:Class ;
                                  rdfs:comment "Anything that can be sensed, measured or controlled in households, common public buildings or offices. We propose here a list of properties that are relevant for the purpose of SAREF, but this list can be extended." ;
                                  rdfs:label "Property" .


###  https://w3id.org/saref#RenewableEnergyResource
<https://w3id.org/saref#RenewableEnergyResource> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/saref#EnergyRelated> ;
                                                 rdfs:comment "A device that generates renewable energy from natural resources such as teh sun, wind and water" ;
                                                 rdfs:label "RenewableEnergyResource" .


###  https://w3id.org/saref#SensingFunction
<https://w3id.org/saref#SensingFunction> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/saref#Function> ;
                                         rdfs:comment "A function that allows to transmit data from sensors, such as measurement values (e.g., temperature) or sensing data (e.g., occupancy)" ;
                                         rdfs:label "Sensing function" .


###  https://w3id.org/saref#Sensor
<https://w3id.org/saref#Sensor> rdf:type owl:Class ;
                                rdfs:subClassOf <http://webprotege.stanford.edu/R9Ss0nlABbeWn3nuA9NaaUI> ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <http://webprotege.stanford.edu/RBQYwalLa8y1fuwJmAeuKrK> ;
                                                  owl:someValuesFrom xsd:string
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <http://webprotege.stanford.edu/RDAjHtUVAjpRS1IKarpqaN> ;
                                                  owl:someValuesFrom xsd:int
                                                ] ;
                                rdfs:comment "A device that detects and responds to events or changes in the physical environment such as light, motion, or temperature changes. Further, a device of category saref:Sensor that performs a saref:SensingFunction." ;
                                rdfs:label "Sensor" .


###  https://w3id.org/saref#Service
<https://w3id.org/saref#Service> rdf:type owl:Class ;
                                 rdfs:comment "A service is a representation of a function to a network that makes the function discoverable, registerable, remotely controllable by other devices in the network. A service can represent one or more functions. A Service is offered by a device that wants (a certain set of) its function(s) to be discoverable, registerable, remotely controllable by other devices in the network. A Service must specify the device that is offering the service and the function(s) to be represented." ;
                                 rdfs:label "Service" .


###  https://w3id.org/saref#SetAbsoluteLevelCommand
<https://w3id.org/saref#SetAbsoluteLevelCommand> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/saref#SetLevelCommand> ;
                                                 rdfs:comment "A type of set level command" ;
                                                 rdfs:label "Set absolute level command" .


###  https://w3id.org/saref#SetLevelCommand
<https://w3id.org/saref#SetLevelCommand> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/saref#Command> ;
                                         rdfs:comment "A type of command" ;
                                         rdfs:label "Set level command" .


###  https://w3id.org/saref#SetRelativeLevelCommand
<https://w3id.org/saref#SetRelativeLevelCommand> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/saref#SetLevelCommand> ;
                                                 rdfs:comment "A type of set level command" ;
                                                 rdfs:label "Set relative level command" .


###  https://w3id.org/saref#Smoke
<https://w3id.org/saref#Smoke> rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/saref#Property> ;
                               rdfs:comment "A saref:Property related to some measurements that are characterized by a certain value that is measured in a unit of measure for smoke" ;
                               rdfs:label "Smoke" .


###  https://w3id.org/saref#SmokeSensor
<https://w3id.org/saref#SmokeSensor> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/saref#Sensor> ;
                                     rdfs:comment "A device that consists of a sensor, has category saref:Sensor, performs the saref:SensingFunction and saref:EventFunction (which notifies that a certain threshold has been exceeded), and is used for the purpose of sensing a property of type saref:Smoke." ;
                                     rdfs:label "Smoke sensor" .


###  https://w3id.org/saref#StartCommand
<https://w3id.org/saref#StartCommand> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/saref#Command> ;
                                      owl:disjointWith <https://w3id.org/saref#StopCommand> ;
                                      rdfs:comment "A type of command" ;
                                      rdfs:label "Start command" .


###  https://w3id.org/saref#StartState
<https://w3id.org/saref#StartState> rdf:type owl:Class ;
                                    rdfs:subClassOf <https://w3id.org/saref#StartStopState> ;
                                    rdfs:comment "The state of a device that is STARTED" ;
                                    rdfs:label "Start state" .


###  https://w3id.org/saref#StartStopFunction
<https://w3id.org/saref#StartStopFunction> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://w3id.org/saref#ActuatingFunction> ;
                                           rdfs:comment "An actuating function that allows to start and stop a device" ;
                                           rdfs:label "Start stop function" .


###  https://w3id.org/saref#StartStopState
<https://w3id.org/saref#StartStopState> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/saref#State> ;
                                        rdfs:comment "A type of state" ;
                                        rdfs:label "Start stop state" .


###  https://w3id.org/saref#State
<https://w3id.org/saref#State> rdf:type owl:Class ;
                               rdfs:comment "The state in which a device can be found, e.g, ON/OFF/STANDBY, or ONLINE/OFFLINE. We propose here a list of states that are relevant for the purpose of SAREF, but this list can be extended." ;
                               rdfs:label "State" .


###  https://w3id.org/saref#StepDownCommand
<https://w3id.org/saref#StepDownCommand> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/saref#Command> ;
                                         owl:disjointWith <https://w3id.org/saref#StepUpCommand> ;
                                         rdfs:comment "A type of command" ;
                                         rdfs:label "Step down command" .


###  https://w3id.org/saref#StepUpCommand
<https://w3id.org/saref#StepUpCommand> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/saref#Command> ;
                                       rdfs:comment "A type of command" ;
                                       rdfs:label "Step up command" .


###  https://w3id.org/saref#StopCommand
<https://w3id.org/saref#StopCommand> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/saref#Command> ;
                                     rdfs:comment "A type of command" ;
                                     rdfs:label "Stop command" .


###  https://w3id.org/saref#StopState
<https://w3id.org/saref#StopState> rdf:type owl:Class ;
                                   rdfs:subClassOf <https://w3id.org/saref#StartStopState> ;
                                   rdfs:comment "The state of a device that is STOPPED" ;
                                   rdfs:label "Stop state" .


###  https://w3id.org/saref#Storage
<https://w3id.org/saref#Storage> rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/saref#EnergyRelated> ;
                                 rdfs:comment "A type of energy-related device that stores energy" ;
                                 rdfs:label "Storage" .


###  https://w3id.org/saref#Switch
<https://w3id.org/saref#Switch> rdf:type owl:Class ;
                                rdfs:subClassOf <https://w3id.org/saref#Actuator> ;
                                rdfs:comment "A device of category saref:Actuator that performs an actuating function of type saref:OnOffFunction or saref:OpenCloseFunction" ;
                                rdfs:label "Switch" .


###  https://w3id.org/saref#SwitchOnService
<https://w3id.org/saref#SwitchOnService> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/saref#Service> ;
                                         rdfs:comment "A type of service that represents an on/off function to the network" ;
                                         rdfs:label "Switch on service" .


###  https://w3id.org/saref#Task
<https://w3id.org/saref#Task> rdf:type owl:Class ;
                              rdfs:subClassOf <http://www.iec.ch/TC57/CIM#WorkTask> ;
                              rdfs:comment "The goal for which a device is designed (from a user perspective). For example, a washing machine is designed for the task of washing. We propose here a list of tasks that are relevant for the purpose of SAREF, but this list can be extended." ;
                              rdfs:label "Task" .


###  https://w3id.org/saref#Temperature
<https://w3id.org/saref#Temperature> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/saref#Property> ;
                                     rdfs:comment "A saref:Property related to some measurements that are characterized by a certain value that is measured in a temperature unit (degree_Celsius, degree_Fahrenheit, or degree_kelvin)" ;
                                     rdfs:label "Temperature" .


###  https://w3id.org/saref#TemperatureSensor
<https://w3id.org/saref#TemperatureSensor> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://w3id.org/saref#Sensor> ;
                                           rdfs:comment "A device that consists of a sensor, has category saref:Sensor, performs the saref:SensingFunction and is used for the purpose of sensing a property of type saref:Temperature" ;
                                           rdfs:label "Temperature sensor" .


###  https://w3id.org/saref#TemperatureUnit
<https://w3id.org/saref#TemperatureUnit> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/saref#UnitsMeasuremet> ;
                                         rdfs:comment "The unit of measure for temperature" ;
                                         rdfs:label "Temperature unit" .


###  https://w3id.org/saref#Time
<https://w3id.org/saref#Time> rdf:type owl:Class ;
                              rdfs:subClassOf <https://w3id.org/saref#Property> ;
                              rdfs:comment "A saref:Property that allows to specify the time concept in terms of instants or intervals according to the imported W3C Time ontology." ;
                              rdfs:label "Time" .


###  https://w3id.org/saref#ToggleCommand
<https://w3id.org/saref#ToggleCommand> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/saref#Command> ;
                                       rdfs:comment "A type of command" ;
                                       rdfs:label "Toggle command" .


###  https://w3id.org/saref#UnitsMeasuremet
<https://w3id.org/saref#UnitsMeasuremet> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.iec.ch/TC57/CIM#Measurement> ;
                                         rdfs:comment "Represents the measured value made over a property. It is also linked to the unit of measure in which the value is expressed and the timestamp of the measurement."@en ;
                                         rdfs:label "UnitsMeasuremet"@en .


###  https://w3id.org/saref#WashingMachine
<https://w3id.org/saref#WashingMachine> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/saref#Load> ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/saref#hasState> ;
                                                          owl:someValuesFrom <https://w3id.org/saref#StartStopState>
                                                        ] ;
                                        rdfs:comment "A device of category saref:Appliance and saref:Load that accomplishes the task saref:Washing, performs an actuating function of type saref:StartStopFunction, can be found in the state saref:StartStopState, and can have a saref:Profile that characterizes its energy consumption. " ;
                                        rdfs:label "Washing machine" .


###  https://w3id.org/saref#Water
<https://w3id.org/saref#Water> rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/saref#Commodity> ;
                               rdfs:comment "A type of commodity" ;
                               rdfs:label "Water" .


###  https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#Humidity
<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#Humidity> rdf:type owl:Class ;
                                                                                          rdfs:subClassOf <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#WeatherPhenomenon> ;
                                                                                          rdfs:comment "Outdoor humidity"@en ;
                                                                                          rdfs:label "Humidity"@en .


###  https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#SolarIrradiance
<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#SolarIrradiance> rdf:type owl:Class ;
                                                                                                 rdfs:subClassOf <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#WeatherPhenomenon> ;
                                                                                                 rdfs:comment "The intensity of outdoor solar radiation"@en ;
                                                                                                 rdfs:label "SolarIrradiance"@en .


###  https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#Temperature
<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#Temperature> rdf:type owl:Class ;
                                                                                             rdfs:subClassOf <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#WeatherPhenomenon> ;
                                                                                             rdfs:comment "Outdoor temperature"@en ;
                                                                                             rdfs:label "Temperature"@en .


###  https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#WeatherCondition
<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#WeatherCondition> rdf:type owl:Class ;
                                                                                                  rdfs:subClassOf <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/gbBuildingOntology.owl#Weather> ;
                                                                                                  rdfs:comment "The weather condition describes the weather such as rain, sun, snow, etc."@en ;
                                                                                                  rdfs:label "WeatherCondition"@en .


###  https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#WeatherPhenomenon
<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#WeatherPhenomenon> rdf:type owl:Class ;
                                                                                                   rdfs:subClassOf <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/gbBuildingOntology.owl#Weather> ;
                                                                                                   rdfs:comment "Weather phenomenon describes the ourdoor temperature, humidity, solar radiation and wind."@en ;
                                                                                                   rdfs:label "WeatherPhenomenon"@en .


###  https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#Wind
<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#Wind> rdf:type owl:Class ;
                                                                                      rdfs:subClassOf <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#WeatherPhenomenon> ,
                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                        owl:onProperty <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#hasDirection> ;
                                                                                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                        owl:onClass <http://energy.linkeddata.es/em-kpi/ontology#WindDirection>
                                                                                                      ] ,
                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                        owl:onProperty <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#hasSpeed> ;
                                                                                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                        owl:onClass <http://energy.linkeddata.es/em-kpi/ontology#WindSpeed>
                                                                                                      ] ;
                                                                                      rdfs:comment "The wind condition like wind speed and wind direction"@en ;
                                                                                      rdfs:label "Wind"@en .


###  https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/gbBuildingOntology.owl#EnvironmentalParameter
<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/gbBuildingOntology.owl#EnvironmentalParameter> rdf:type owl:Class ;
                                                                                                           rdfs:comment "The parameter describes the environment condition, including indoor environment (indoor comfort) and outdoor environment (weather)"@en ;
                                                                                                           rdfs:label "EnvironmentalParameter"@en .


###  https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/gbBuildingOntology.owl#Weather
<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/gbBuildingOntology.owl#Weather> rdf:type owl:Class ;
                                                                                            rdfs:subClassOf <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/gbBuildingOntology.owl#EnvironmentalParameter> ,
                                                                                                            [ rdf:type owl:Restriction ;
                                                                                                              owl:onProperty <http://energy.linkeddata.es/em-kpi/ontology#hasForecast> ;
                                                                                                              owl:someValuesFrom <http://energy.linkeddata.es/em-kpi/ontology#WeatherForecast>
                                                                                                            ] ,
                                                                                                            [ rdf:type owl:Restriction ;
                                                                                                              owl:onProperty <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/ProcessOntology.owl#hasInfluenceOn> ;
                                                                                                              owl:someValuesFrom <http://energy.linkeddata.es/em-kpi/ontology#EnergyProduction>
                                                                                                            ] ;
                                                                                            rdfs:comment "Weather describes the outdoor environment"@en ;
                                                                                            rdfs:label "Weather"@en .


