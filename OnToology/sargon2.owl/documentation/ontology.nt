# http://www.iec.ch/TC57/CIM#MacroPeriodKind.billingPeriod
<http://www.iec.ch/TC57/CIM#MacroPeriodKind.billingPeriod> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#NamedIndividual> .
<http://www.iec.ch/TC57/CIM#MacroPeriodKind.billingPeriod> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.iec.ch/TC57/CIM#MacroPeriodKind> .
<http://www.iec.ch/TC57/CIM#MacroPeriodKind.billingPeriod> <http://www.w3.org/2000/01/rdf-schema#comment> "Captured during the billing period starting at midnight of the first day of the billing period as defined by the billing cycle day. If during the current billing period it specifies a period from the start of the current billing period until now." .
<http://www.iec.ch/TC57/CIM#MacroPeriodKind.billingPeriod> <http://www.w3.org/2000/01/rdf-schema#label> "billingPeriod"@en .
# 
# http://www.iec.ch/TC57/CIM#MacroPeriodKind.daily
<http://www.iec.ch/TC57/CIM#MacroPeriodKind.daily> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#NamedIndividual> .
<http://www.iec.ch/TC57/CIM#MacroPeriodKind.daily> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.iec.ch/TC57/CIM#MacroPeriodKind> .
<http://www.iec.ch/TC57/CIM#MacroPeriodKind.daily> <http://www.w3.org/2000/01/rdf-schema#comment> "Daily period starting at midnight. If for the current day this specifies the time from midnight to now." .
<http://www.iec.ch/TC57/CIM#MacroPeriodKind.daily> <http://www.w3.org/2000/01/rdf-schema#label> "daily"@en .
# 
# http://www.iec.ch/TC57/CIM#MacroPeriodKind.monthly
<http://www.iec.ch/TC57/CIM#MacroPeriodKind.monthly> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#NamedIndividual> .
<http://www.iec.ch/TC57/CIM#MacroPeriodKind.monthly> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.iec.ch/TC57/CIM#MacroPeriodKind> .
<http://www.iec.ch/TC57/CIM#MacroPeriodKind.monthly> <http://www.w3.org/2000/01/rdf-schema#comment> "Monthly period starting at midnight on the first day of the month. If within the current month this specifies the period from the start of the month until now." .
<http://www.iec.ch/TC57/CIM#MacroPeriodKind.monthly> <http://www.w3.org/2000/01/rdf-schema#label> "monthly"@en .
